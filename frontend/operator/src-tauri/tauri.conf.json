{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hospitality OS",
  "version": "0.1.0",
  "identifier": "com.xeitoso.hospitality",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hospitality OS",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https:; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
