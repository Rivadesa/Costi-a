<UserControl x:Class="Costina.Desktop.Views.CheckoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- C1: Cuenta / Caja (nucleo, solo main), con el aspecto nuevo y la distribucion de siempre (C2 la reordena).
      Hereda el DataContext del cascaron (ShellViewModel). Las cuentas se muestran por el nombre de su mesa y su estado en castellano
      (AccountItems); la seleccion sigue siendo la cuenta leida. -->
 <Border Style="{StaticResource Card}" Padding="20,18">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="Cuenta / Caja" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Registro operativo de ensayo: no emite facturas ni realiza cargos bancarios. Solo el puesto principal." Style="{StaticResource Subtle}" Margin="0,2,0,14"/>
    <TextBlock Text="Cuenta" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="AccountBox" ItemsSource="{Binding Checkout.AccountItems}" DisplayMemberPath="Text" SelectedValuePath="Choice" SelectedValue="{Binding Checkout.SelectedAccount}" Margin="0,0,0,10" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
    <TextBlock Text="{Binding Checkout.Totals}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,2,0,12"/>
    <Border Style="{StaticResource FormPanel}" HorizontalAlignment="Left">
     <StackPanel>
      <TextBlock Text="Añadir del catálogo" Style="{StaticResource FieldLabel}"/>
      <WrapPanel><ComboBox ItemsSource="{Binding Checkout.Products}" SelectedItem="{Binding Checkout.SelectedProduct}" Width="340" Margin="0,4,8,4"/>
       <TextBox Text="{Binding Checkout.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,4,8,4" ToolTip="Cantidad"/>
       <Button Content="Añadir del catálogo" Style="{StaticResource Primary}" Command="{Binding Checkout.AddCommand}" Margin="0,4,0,4"/></WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
    <WrapPanel><TextBox Text="{Binding Checkout.Amount, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Importe del pago en euros" Margin="0,4,8,4"/>
     <ComboBox Width="140" Margin="0,4,8,4" SelectedValuePath="Tag" SelectedValue="{Binding Checkout.Method}"><ComboBoxItem Tag="card" IsSelected="True">Tarjeta</ComboBoxItem><ComboBoxItem Tag="cash">Efectivo</ComboBoxItem><ComboBoxItem Tag="other">Otro</ComboBoxItem></ComboBox>
     <Button Content="Registrar pago de prueba" Style="{StaticResource Primary}" Command="{Binding Checkout.PayCommand}"/>
     <Button Content="Cerrar cuenta saldada" Command="{Binding Checkout.CloseAccountCommand}"/>
    </WrapPanel>
    <WrapPanel Margin="0,4,0,0"><TextBox Text="{Binding Checkout.Note, UpdateSourceTrigger=PropertyChanged}" Width="300" ToolTip="Motivo obligatorio para reabrir o devolver" Margin="0,4,8,4"/>
     <Button Content="Devolver lo pagado de más (importe y motivo)" Style="{StaticResource DangerButton}" Command="{Binding Checkout.RefundCommand}"/>
     <Button Content="Reabrir cuenta con motivo" Command="{Binding Checkout.ReopenCommand}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Checkout.AccountState}" TextWrapping="Wrap" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
   </StackPanel>
   <DataGrid ItemsSource="{Binding Checkout.Charges}" Margin="0,14,0,0"><DataGrid.Columns>
    <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
    <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="90"/>
   </DataGrid.Columns></DataGrid>
  </DockPanel>
 </Border>
</UserControl>
