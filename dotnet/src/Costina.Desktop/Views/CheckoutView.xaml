<UserControl x:Class="Costina.Desktop.Views.CheckoutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- C1: Cuenta / Caja (nucleo, solo main), con el aspecto nuevo y la distribucion de siempre (C2 la reordena).
      Hereda el DataContext del cascaron (ShellViewModel). Las cuentas se muestran por el nombre de su mesa y su estado en castellano
      (AccountItems); la seleccion sigue siendo la cuenta leida. Cabecera de la vista sobre el fondo, como las demas; cada campo con su
      etiqueta (nunca solo una ayuda emergente) y cantidades e importes alineados a la derecha. -->
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Style="{StaticResource PageHeader}">
   <TextBlock Text="Cuenta / Caja" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Registro operativo de ensayo: no emite facturas ni realiza cargos bancarios. Solo el puesto principal." Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="Cuenta" Style="{StaticResource FieldLabel}"/>
     <ComboBox x:Name="AccountBox" ItemsSource="{Binding Checkout.AccountItems}" DisplayMemberPath="Text" SelectedValuePath="Choice" SelectedValue="{Binding Checkout.SelectedAccount}" Margin="0,0,0,10" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
     <TextBlock Text="{Binding Checkout.Totals}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,2,0,12"/>
     <Border Style="{StaticResource FormPanel}" HorizontalAlignment="Left">
      <StackPanel>
       <TextBlock Text="Añadir un consumo" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <WrapPanel>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Producto" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Checkout.Products}" SelectedItem="{Binding Checkout.SelectedProduct}" Width="340"/></StackPanel>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Cantidad" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Checkout.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="64"/></StackPanel>
        <Button Content="Añadir del catálogo" Style="{StaticResource Primary}" Command="{Binding Checkout.AddCommand}" VerticalAlignment="Bottom" Margin="0"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
     <WrapPanel>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Importe del pago (€)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Checkout.Amount, UpdateSourceTrigger=PropertyChanged}" Width="140"/></StackPanel>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Forma de pago" Style="{StaticResource FieldLabel}"/>
       <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding Checkout.Method}"><ComboBoxItem Tag="card" IsSelected="True">Tarjeta</ComboBoxItem><ComboBoxItem Tag="cash">Efectivo</ComboBoxItem><ComboBoxItem Tag="other">Otro</ComboBoxItem></ComboBox></StackPanel>
      <Button Content="Registrar pago de prueba" Style="{StaticResource Primary}" Command="{Binding Checkout.PayCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
      <Button Content="Cerrar cuenta saldada" Command="{Binding Checkout.CloseAccountCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
     </WrapPanel>
     <WrapPanel Margin="0,10,0,0">
      <StackPanel Margin="0,0,8,0"><TextBlock Text="Motivo (obligatorio para devolver o reabrir)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Checkout.Note, UpdateSourceTrigger=PropertyChanged}" Width="300"/></StackPanel>
      <Button Content="Devolver lo pagado de más (importe y motivo)" Style="{StaticResource DangerButton}" Command="{Binding Checkout.RefundCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
      <Button Content="Reabrir cuenta con motivo" Command="{Binding Checkout.ReopenCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
     </WrapPanel>
     <TextBlock Text="{Binding Checkout.AccountState}" TextWrapping="Wrap" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Checkout.Charges}" Margin="0,14,0,0"><DataGrid.Columns>
     <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*"/>
     <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
     <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}"/>
     <DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="90"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
