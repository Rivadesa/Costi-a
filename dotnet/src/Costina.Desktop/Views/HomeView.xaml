<UserControl x:Class="Costina.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop">
 <!-- C2 (plan 2026-10-14): Inicio como panel, como el lienzo aprobado (Main.dc.html). De arriba abajo: saludo con la fecha y el servicio
      del dia y los botones "Conectar dispositivo" (responsable) y "Abrir mesa"; avisos que piden hacer algo (certificado, red publica);
      las cuatro cifras del comedor; "Sala ahora" (el plano en pequeno, con su leyenda) y los dispositivos con su conexion (responsable);
      los accesos a cada apartado; y las notas (conexion sencilla, copia de seguridad, servidor).
      Hereda el DataContext del cascaron (ShellViewModel). Las cifras y el mini plano salen de las tarjetas del Comedor (Home.Tiles =
      Service.Tiles): presentacion pura. Toda alerta lleva su palabra (nunca solo color). Una mesa del mini plano y "Abrir mesa" abren el
      Comedor por el camino de siempre (Home.OpenTile -> Service.PickTile; Home.OpenTable -> Service.StartOpen); "Conectar comandero" y
      "Pantalla de cocina" abren SU asistente en Dispositivos (Home.ConnectDevice -> Devices.Request).
      Los accesos navegan con NavigationCommands.GoToPage: la ventana aplica la misma logica que el menu (elevacion incluida). La vista se
      construye ANTES de colgar de la ventana: sin esta CommandBinding (solo CanExecute, siempre true) los accesos calcularian CanExecute
      sin llegar a la de la ventana y nacerian deshabilitados hasta la primera tecla o clic. La orden no se ejecuta aqui: sigue subiendo y
      la ejecuta la ventana (MainWindow.GoToPage). -->
 <UserControl.CommandBindings><CommandBinding Command="NavigationCommands.GoToPage" CanExecute="CanGoToPage"/></UserControl.CommandBindings>
 <UserControl.Resources>
  <!-- Mesa del mini plano: el color del estado (Tag = tono de la tarjeta del Comedor) y, dentro, su nombre, su estado con palabra y su
       aviso de restricciones con texto. Libre: sin fondo y con borde discontinuo; con alerta grave: borde rojo. -->
  <Style x:Key="MiniTile" TargetType="Button">
   <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid SnapsToDevicePixels="True">
       <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="6,8,6,9">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
       </Border>
       <Rectangle x:Name="Dash" RadiusX="10" RadiusY="10" Stroke="{StaticResource StrokeStrong}" StrokeThickness="1.5" StrokeDashArray="3 2.5" Visibility="Collapsed" IsHitTestVisible="False"/>
       <Border x:Name="Alarm" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Danger}" Visibility="Collapsed" IsHitTestVisible="False"/>
       <Border x:Name="Hover" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="Tag" Value="free"><Setter TargetName="Dash" Property="Visibility" Value="Visible"/></Trigger>
       <DataTrigger Binding="{Binding AlertAlarming}" Value="True"><Setter TargetName="Alarm" Property="Visibility" Value="Visible"/></DataTrigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="Tag" Value="free"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Trigger>
    <Trigger Property="Tag" Value="seated"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoLine}"/><Setter Property="Foreground" Value="{StaticResource InfoText}"/></Trigger>
    <Trigger Property="Tag" Value="kitchen"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/><Setter Property="Foreground" Value="{StaticResource WarnText}"/></Trigger>
    <Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource Ok}"/><Setter Property="BorderBrush" Value="{StaticResource Ok}"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="Tag" Value="eating"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/></Trigger>
    <Trigger Property="Tag" Value="paused"><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Trigger>
    <Trigger Property="Tag" Value="finished"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Trigger>
    <Trigger Property="Tag" Value="cancelled"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Trigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="MiniTileTemplate">
   <Button Style="{StaticResource MiniTile}" Tag="{Binding Tone}" AutomationProperties.Name="{Binding Description}" ToolTip="{Binding Description}"
           Command="{Binding DataContext.Home.OpenTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
    <StackPanel>
     <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding StateLabel}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,0"/>
     <Border Margin="0,5,0,0" CornerRadius="5" Padding="5,1,5,2" HorizontalAlignment="Center" Visibility="{Binding HasAlert, Converter={StaticResource Bool2Vis}}">
      <Border.Style>
       <Style TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarnText}"/>
        <Style.Triggers><DataTrigger Binding="{Binding AlertAlarming}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/></DataTrigger></Style.Triggers>
       </Style>
      </Border.Style>
      <TextBlock Text="{Binding Alert}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
     </Border>
    </StackPanel>
   </Button>
  </DataTemplate>
  <!-- Muestra de la leyenda: el mismo color que las mesas de ese estado; "alert" = borde rojo. -->
  <Style x:Key="LegendSwatch" TargetType="Border">
   <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="CornerRadius" Value="4"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
   <Style.Triggers>
    <Trigger Property="Tag" Value="free"><Setter Property="Background" Value="Transparent"/></Trigger>
    <Trigger Property="Tag" Value="seated"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoLine}"/></Trigger>
    <Trigger Property="Tag" Value="kitchen"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/></Trigger>
    <Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource Ok}"/><Setter Property="BorderBrush" Value="{StaticResource Ok}"/></Trigger>
    <Trigger Property="Tag" Value="eating"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/></Trigger>
    <Trigger Property="Tag" Value="finished"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
    <Trigger Property="Tag" Value="cancelled"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
    <Trigger Property="Tag" Value="alert"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
   </Style.Triggers>
  </Style>
  <!-- Enlace en la cabecera de una tarjeta ("Ver plano"): texto de acento sin fondo; las claves de Fluent, para que se mantenga al pasar el raton. -->
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
   <Style.Resources>
    <SolidColorBrush x:Key="ButtonForeground" Color="#0C6B54"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0C6B54"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0A5A46"/>
   </Style.Resources>
   <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="8,3,4,4"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <!-- Boton con icono a la izquierda del texto (el texto en ContentTemplate: hereda el color que pone la plantilla Fluent). -->
  <DataTemplate x:Key="QrButtonText"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconQr}" Margin="0,0,8,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="PlusButtonText"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Margin="0,0,6,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="LinkText"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconChevronRight}" Margin="2,0,0,0"/></StackPanel></DataTemplate>
  <!-- Etiqueta de una cifra: icono y texto grises (la de alergias pasa a rojo con su propio disparador). -->
  <Style x:Key="KpiHead" TargetType="StackPanel">
   <Setter Property="Orientation" Value="Horizontal"/><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
  </Style>
 </UserControl.Resources>

 <!-- La barra de desplazamiento de Fluent se pinta encima del contenido: la vista se mete en el margen del area de trabajo y el contenido
      deja ese hueco, asi las tarjetas acaban donde las de las demas vistas y la barra no las tapa. -->
 <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-16,0"><StackPanel Margin="0,0,16,0">
  <!-- ===== Cabecera: fecha y servicio, saludo y quien esta conectado; a la derecha, conectar un dispositivo y abrir mesa ===== -->
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
    <Button x:Name="ConnectDeviceButton" Content="Conectar dispositivo" ContentTemplate="{StaticResource QrButtonText}" Command="NavigationCommands.GoToPage" CommandParameter="DevicesTab"
            MinHeight="40" Padding="14,0,16,0" Margin="0" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}" ToolTip="Comanderos y pantallas de cocina: conectarlos con un código de un solo uso"/>
    <Button x:Name="HomeOpenTableButton" Style="{StaticResource Primary}" Content="Abrir mesa" ContentTemplate="{StaticResource PlusButtonText}" Command="{Binding Home.OpenTableCommand}"
            MinHeight="40" Padding="12,0,18,0" Margin="10,0,0,0" Visibility="{Binding Home.CanOpenTables, Converter={StaticResource Bool2Vis}}" ToolTip="Abre el Comedor con el formulario de abrir mesa"/>
   </StackPanel>
   <StackPanel>
    <TextBlock x:Name="HomeDateLine" Text="{Binding Home.DateLine}" Style="{StaticResource Body}" Visibility="{Binding Home.DateLine, Converter={StaticResource Text2Vis}}"/>
    <TextBlock x:Name="HomeTitle" Text="{Binding Home.Title}" Style="{StaticResource PageTitle}" FontSize="28" Margin="0,2,0,0"/>
    <TextBlock Text="{Binding Home.WhoText}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
   </StackPanel>
  </DockPanel>

  <!-- ===== Avisos que piden hacer algo ===== -->
  <ContentControl x:Name="CertificateBar" Margin="0,0,0,14" local:Ui.Icon="{StaticResource IconShield}" Visibility="{Binding Home.HasCertificateWarning, Converter={StaticResource Bool2Vis}}">
   <ContentControl.Style>
    <Style TargetType="ContentControl" BasedOn="{StaticResource WarnBar}">
     <Style.Triggers><DataTrigger Binding="{Binding Home.CertificateExpired}" Value="True">
      <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/><Setter Property="Foreground" Value="{StaticResource DangerText}"/>
     </DataTrigger></Style.Triggers>
    </Style>
   </ContentControl.Style>
   <TextBlock Text="{Binding Home.CertificateWarning}" TextWrapping="Wrap"/>
  </ContentControl>
  <ContentControl x:Name="HomeNetworkBar" Style="{StaticResource DangerBar}" Margin="0,0,0,14" Visibility="{Binding Home.NetworkNotice, Converter={StaticResource Text2Vis}}">
   <TextBlock Text="{Binding Home.NetworkNotice}" TextWrapping="Wrap"/>
  </ContentControl>

  <!-- ===== Cifras del comedor (solo con el modulo de comedor) ===== -->
  <UniformGrid x:Name="KpiRow" Columns="4" Margin="0,0,-16,18" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
   <Border Style="{StaticResource Kpi}" Margin="0,0,16,0">
    <StackPanel>
     <StackPanel Style="{StaticResource KpiHead}"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconDining}"/><TextBlock Text="Mesas ocupadas" Style="{StaticResource KpiLabel}" Margin="8,0,0,0"/></StackPanel>
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="OccupiedValue" Text="{Binding Home.OccupiedText}" Style="{StaticResource KpiValue}"/>
      <TextBlock Text="{Binding Home.TablesText}" FontSize="16" Foreground="{StaticResource InkSoft}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
     </StackPanel>
     <!-- Barra: ocupadas sobre el total (las dos columnas reparten el ancho en esa proporcion). -->
     <Border Height="6" CornerRadius="3" Background="{StaticResource Stroke}" Margin="0,8,0,0" ClipToBounds="True">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Home.OccupiedShare}"/><ColumnDefinition Width="{Binding Home.FreeShare}"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource Accent}"/>
      </Grid>
     </Border>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Kpi}" Margin="0,0,16,0">
    <StackPanel>
     <StackPanel Style="{StaticResource KpiHead}"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPeople}"/><TextBlock Text="Comensales" Style="{StaticResource KpiLabel}" Margin="8,0,0,0"/></StackPanel>
     <TextBlock x:Name="DinersValue" Text="{Binding Home.DinersText}" Style="{StaticResource KpiValue}"/>
     <TextBlock Text="{Binding Home.DinersDetail}" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Kpi}" Margin="0,0,16,0">
    <StackPanel>
     <StackPanel Style="{StaticResource KpiHead}"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconFlame}"/><TextBlock Text="Pases en cocina" Style="{StaticResource KpiLabel}" Margin="8,0,0,0"/></StackPanel>
     <TextBlock x:Name="KitchenValue" Text="{Binding Home.KitchenText}" Style="{StaticResource KpiValue}"/>
     <TextBlock Text="{Binding Home.ReadyText}" Margin="0,2,0,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
        <Style.Triggers><DataTrigger Binding="{Binding Home.HasReady}" Value="True"><Setter Property="Foreground" Value="{StaticResource OkText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
   <!-- Alergias por revisar: en rojo cuando hay alguna, y siempre con la mesa y la restriccion escritas. -->
   <Border x:Name="ReviewKpi" Margin="0,0,16,0">
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource Kpi}">
      <Style.Triggers><DataTrigger Binding="{Binding Home.ReviewAlarm}" Value="True">
       <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/>
      </DataTrigger></Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel>
     <StackPanel>
      <StackPanel.Style>
       <Style TargetType="StackPanel" BasedOn="{StaticResource KpiHead}">
        <Style.Triggers><DataTrigger Binding="{Binding Home.ReviewAlarm}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
       </Style>
      </StackPanel.Style>
      <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconAlert}"/><TextBlock Text="Alergias por revisar" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </StackPanel>
     <TextBlock x:Name="ReviewValue" Text="{Binding Home.ReviewText}" Style="{StaticResource KpiValue}"/>
     <TextBlock Text="{Binding Home.ReviewDetail}" Margin="0,2,0,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
        <Style.Triggers><DataTrigger Binding="{Binding Home.ReviewAlarm}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
  </UniformGrid>

  <!-- ===== Sala ahora (comedor) y Dispositivos (responsable). Sin uno de los dos, el otro ocupa todo el ancho. ===== -->
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="FloorCard" Padding="20,18">
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
      <Setter Property="Visibility" Value="{Binding HasDining, Converter={StaticResource Bool2Vis}}"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMain}" Value="False"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel>
     <DockPanel Margin="0,0,0,12">
      <Button x:Name="FloorLinkButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver plano" ContentTemplate="{StaticResource LinkText}"
              Command="NavigationCommands.GoToPage" CommandParameter="ServiceTab" VerticalAlignment="Center"/>
      <TextBlock Text="Sala ahora" Style="{StaticResource PanelTitle}" FontSize="16" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Home.ZonesText}" Style="{StaticResource Subtle}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <TextBlock Text="{Binding Home.FloorEmpty}" Style="{StaticResource Body}" Margin="0,0,0,8" Visibility="{Binding Home.FloorEmpty, Converter={StaticResource Text2Vis}}"/>
     <Border x:Name="MiniPlanHost" SizeChanged="MiniPlanSizeChanged">
      <ItemsControl x:Name="MiniPlan" ItemsSource="{Binding Home.Tiles}" ItemTemplate="{StaticResource MiniTileTemplate}" Margin="0,0,-8,-8" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding MiniColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </Border>
     <ItemsControl x:Name="FloorLegend" ItemsSource="{Binding Home.Legend}" Margin="0,14,0,0" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Border Style="{StaticResource LegendSwatch}" Tag="{Binding Tone}"/><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>

   <Border x:Name="HomeDevicesCard" Padding="20,18">
    <Border.Style>
     <Style TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/>
      <Setter Property="Visibility" Value="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
      <Style.Triggers><DataTrigger Binding="{Binding HasDining}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers>
     </Style>
    </Border.Style>
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Home.DevicesSummary}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <TextBlock Text="Dispositivos" Style="{StaticResource PanelTitle}" FontSize="16"/>
     </DockPanel>
     <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,12,-8,0">
      <Button x:Name="HomeConnectWaiterButton" Content="Conectar comandero" Command="{Binding Home.ConnectDeviceCommand}" CommandParameter="service" Margin="0,0,8,0" MinHeight="36" Padding="6,0" HorizontalAlignment="Stretch"
              ToolTip="Abre en Dispositivos el asistente para conectar un comandero (tablet o móvil de sala)"/>
      <Button x:Name="HomeConnectKitchenButton" Content="Pantalla de cocina" Command="{Binding Home.ConnectDeviceCommand}" CommandParameter="kitchen" Margin="0,0,8,0" MinHeight="36" Padding="6,0" HorizontalAlignment="Stretch"
              ToolTip="Abre en Dispositivos el asistente para conectar una pantalla de cocina"/>
     </UniformGrid>
     <!-- B.2: estado de la conexion sencilla (solo si el servidor la tiene), con punto y palabra. -->
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Home.SimpleState, Converter={StaticResource Text2Vis}}">
      <Ellipse Style="{StaticResource Dot}" Tag="{Binding Home.SimpleDot}"/>
      <TextBlock x:Name="SimpleStateText" Text="{Binding Home.SimpleState}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="{Binding Home.DevicesEmpty}" Style="{StaticResource Body}" Margin="0,4,0,0" Visibility="{Binding Home.DevicesEmpty, Converter={StaticResource Text2Vis}}"/>
      <ItemsControl x:Name="HomeDeviceList" ItemsSource="{Binding Home.DeviceRows}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="0,7">
          <DockPanel>
           <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{StaticResource Surface2}" TextElement.Foreground="{StaticResource InkSoft}" Margin="0,0,10,0">
            <Path HorizontalAlignment="Center">
             <Path.Style>
              <Style TargetType="Path" BasedOn="{StaticResource IconSmall}">
               <Setter Property="Data" Value="{StaticResource IconDevices}"/>
               <Style.Triggers><DataTrigger Binding="{Binding Screen}" Value="True"><Setter Property="Data" Value="{StaticResource IconMonitor}"/></DataTrigger></Style.Triggers>
              </Style>
             </Path.Style>
            </Path>
           </Border>
           <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <Ellipse Style="{StaticResource Dot}" Tag="{Binding Dot}"/>
            <TextBlock Text="{Binding State}" FontSize="12" VerticalAlignment="Center">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
               <Style.Triggers><DataTrigger Binding="{Binding Dot}" Value="ok"><Setter Property="Foreground" Value="{StaticResource OkText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </StackPanel>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </DockPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Home.DevicesMore}" Style="{StaticResource Subtle}" Margin="0,8,0,0" Visibility="{Binding Home.DevicesMore, Converter={StaticResource Text2Vis}}"/>
      <ContentControl Style="{StaticResource WarnBar}" Margin="0,10,0,0" Visibility="{Binding Home.DevicesWarning, Converter={StaticResource Text2Vis}}">
       <TextBlock Text="{Binding Home.DevicesWarning}" TextWrapping="Wrap" FontSize="12"/>
      </ContentControl>
     </StackPanel>
    </DockPanel>
   </Border>
  </Grid>

  <!-- ===== Accesos a cada apartado ===== -->
  <TextBlock Text="Apartados" Style="{StaticResource Section}"/>
  <!-- Tres columnas que se estiran con la ventana (y con la barra lateral plegada). UniformGrid salta los accesos recogidos (Comedor sin el
       modulo de comedor). El margen derecho negativo compensa el hueco de la ultima columna. -->
  <UniformGrid Columns="3" Margin="0,0,-12,6">
   <UniformGrid.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource ShortcutTile}"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="MinHeight" Value="76"/></Style>
   </UniformGrid.Resources>
   <Button x:Name="HomeDiningButton" Style="{StaticResource ShortcutTilePrimary}" Margin="0,0,12,12" MinHeight="76" Content="Comedor y cocina" local:Ui.Icon="{StaticResource IconDining}"
           local:Ui.Hint="Mesas, pases, cocina por estación y alergias." Command="NavigationCommands.GoToPage" CommandParameter="ServiceTab" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Cuenta / Caja" local:Ui.Icon="{StaticResource IconCheckout}" local:Ui.Hint="Cuenta de cada mesa, cobros y cierre."
           Command="NavigationCommands.GoToPage" CommandParameter="CheckoutTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Catálogo y tarifas" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Hint="Productos, presentaciones, impuestos y precios."
           Command="NavigationCommands.GoToPage" CommandParameter="CatalogTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Oferta: cartas y menús" local:Ui.Icon="{StaticResource IconOffers}" local:Ui.Hint="Degustaciones, menús cerrados y carta."
           Command="NavigationCommands.GoToPage" CommandParameter="OffersTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Salas, mesas y estaciones" local:Ui.Icon="{StaticResource IconOrganization}" local:Ui.Hint="La organización del local."
           Command="NavigationCommands.GoToPage" CommandParameter="OrganizationTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button x:Name="HomeDevicesButton" Content="Dispositivos" local:Ui.Icon="{StaticResource IconDevices}" local:Ui.Hint="Comanderos y pantallas de cocina."
           Command="NavigationCommands.GoToPage" CommandParameter="DevicesTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
  </UniformGrid>

  <!-- ===== Notas: conexion sencilla activa (recordatorio, a todo lo ancho) y, debajo, copia de seguridad y servidor ===== -->
  <StackPanel x:Name="HomeNotes">
   <ContentControl x:Name="SimpleNoticeBar" Style="{StaticResource WarnBar}" Margin="0,0,0,12" Visibility="{Binding Home.SimpleNotice, Converter={StaticResource Text2Vis}}">
    <TextBlock Text="{Binding Home.SimpleNotice}" TextWrapping="Wrap" FontSize="13"/>
   </ContentControl>
   <UniformGrid Columns="2" Margin="0,0,-12,0">
    <ContentControl x:Name="BackupNote" Margin="0,0,12,12" local:Ui.Icon="{StaticResource IconDatabase}" Visibility="{Binding Home.BackupText, Converter={StaticResource Text2Vis}}">
     <ContentControl.Style>
      <Style TargetType="ContentControl" BasedOn="{StaticResource NoteBar}">
       <Style.Triggers><DataTrigger Binding="{Binding Home.BackupFailed}" Value="True">
        <Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/><Setter Property="Foreground" Value="{StaticResource WarnText}"/>
       </DataTrigger></Style.Triggers>
      </Style>
     </ContentControl.Style>
     <TextBlock Text="{Binding Home.BackupText}" TextWrapping="Wrap" FontSize="13"/>
    </ContentControl>
    <ContentControl x:Name="ServerNote" Style="{StaticResource NoteBar}" Margin="0,0,12,12" local:Ui.Icon="{StaticResource IconMonitor}" ToolTip="{Binding Home.ServerDetail}"
                    Visibility="{Binding Home.ServerText, Converter={StaticResource Text2Vis}}">
     <TextBlock Text="{Binding Home.ServerText}" TextWrapping="Wrap" FontSize="13"/>
    </ContentControl>
   </UniformGrid>
  </StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
