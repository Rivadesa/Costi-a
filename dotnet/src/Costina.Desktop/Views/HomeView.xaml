<UserControl x:Class="Costina.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop">
 <!-- C1: Inicio (corte A): estado, accesos y dispositivos, con el aspecto nuevo (cabecera, tarjetas, accesos con icono). La distribucion
      es la de siempre; C2 lo convierte en panel (cifras, mini plano, dispositivos con conexion).
      Hereda el DataContext del cascaron (ShellViewModel). Los accesos navegan con NavigationCommands.GoToPage: la ventana aplica la misma
      logica que el menu (elevacion incluida). La vista se construye ANTES de colgar de la ventana: sin esta CommandBinding (solo
      CanExecute, siempre true) los accesos calcularian CanExecute sin llegar a la de la ventana y nacerian deshabilitados hasta la
      primera tecla o clic. La orden no se ejecuta aqui: sigue subiendo y la ejecuta la ventana (MainWindow.GoToPage). -->
 <UserControl.CommandBindings><CommandBinding Command="NavigationCommands.GoToPage" CanExecute="CanGoToPage"/></UserControl.CommandBindings>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <StackPanel Style="{StaticResource PageHeader}">
   <TextBlock Text="Inicio" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{Binding Home.WhoText}" Style="{StaticResource Body}" FontSize="14" Margin="0,4,0,0"/>
  </StackPanel>
  <ContentControl Style="{StaticResource WarnBar}" Margin="0,0,0,14" local:Ui.Icon="{StaticResource IconShield}" Visibility="{Binding Home.HasCertificateWarning, Converter={StaticResource Bool2Vis}}">
   <TextBlock Text="{Binding Home.CertificateWarning}" TextWrapping="Wrap"/>
  </ContentControl>
  <!-- Estado: servidor, tiempo real y copia de seguridad (esta solo la ve el responsable: sale del diagnostico). -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,18">
   <StackPanel>
    <!-- Linea corta para quien trabaja; la direccion, el modo y los puertos, en la ayuda emergente (revision C1). -->
    <DockPanel Margin="0,0,0,6" ToolTip="{Binding Home.ServerDetail}" Background="Transparent">
     <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconMonitor}" Stroke="{StaticResource InkSoft}" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding Home.ServerText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,6">
     <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconFlame}" Stroke="{StaticResource InkSoft}" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding RealtimeState}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
     <DockPanel Visibility="{Binding Home.BackupText, Converter={StaticResource Text2Vis}}">
      <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconDatabase}" Stroke="{StaticResource InkSoft}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Home.BackupText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </StackPanel>
   </StackPanel>
  </Border>
  <TextBlock Text="Apartados" Style="{StaticResource Section}"/>
  <!-- Tres columnas que se estiran con la ventana (y con la barra lateral plegada): los accesos cuadran con las tarjetas de arriba y de
       abajo. UniformGrid salta los accesos recogidos (Comedor sin el modulo de comedor). El margen derecho negativo compensa el hueco
       de la ultima columna. -->
  <UniformGrid Columns="3" Margin="0,0,-12,6">
   <UniformGrid.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource ShortcutTile}"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="MinHeight" Value="76"/></Style>
   </UniformGrid.Resources>
   <Button x:Name="HomeDiningButton" Style="{StaticResource ShortcutTilePrimary}" Margin="0,0,12,12" MinHeight="76" Content="Comedor y cocina" local:Ui.Icon="{StaticResource IconDining}"
           local:Ui.Hint="Mesas, pases, cocina por estación y alergias." Command="NavigationCommands.GoToPage" CommandParameter="ServiceTab" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Cuenta / Caja" local:Ui.Icon="{StaticResource IconCheckout}" local:Ui.Hint="Cuenta de cada mesa, cobros y cierre."
           Command="NavigationCommands.GoToPage" CommandParameter="CheckoutTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Salas, mesas y estaciones" local:Ui.Icon="{StaticResource IconOrganization}" local:Ui.Hint="La organización del local."
           Command="NavigationCommands.GoToPage" CommandParameter="OrganizationTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Catálogo y tarifas" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Hint="Productos, presentaciones, impuestos y precios."
           Command="NavigationCommands.GoToPage" CommandParameter="CatalogTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button Content="Oferta: cartas y menús" local:Ui.Icon="{StaticResource IconOffers}" local:Ui.Hint="Degustaciones, menús cerrados y carta."
           Command="NavigationCommands.GoToPage" CommandParameter="OffersTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
   <Button x:Name="HomeDevicesButton" Content="Dispositivos" local:Ui.Icon="{StaticResource IconDevices}" local:Ui.Hint="Comanderos y pantallas de cocina."
           Command="NavigationCommands.GoToPage" CommandParameter="DevicesTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"/>
  </UniformGrid>
  <Border Style="{StaticResource Card}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"><StackPanel>
   <TextBlock Text="Dispositivos" Style="{StaticResource PanelTitle}" FontSize="16"/>
   <TextBlock Text="{Binding Home.DevicesSummary}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Home.DevicesSummary, Converter={StaticResource Text2Vis}}"/>
   <WrapPanel Margin="0,8,0,0">
    <Button Command="NavigationCommands.GoToPage" CommandParameter="DevicesTab">
     <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconQr}" Margin="0,0,8,0"/><TextBlock Text="Conectar comandero"/></StackPanel>
    </Button>
    <Button Command="NavigationCommands.GoToPage" CommandParameter="DevicesTab">
     <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconQr}" Margin="0,0,8,0"/><TextBlock Text="Conectar pantalla de cocina"/></StackPanel>
    </Button>
   </WrapPanel>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
