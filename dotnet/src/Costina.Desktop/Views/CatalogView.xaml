<UserControl x:Class="Costina.Desktop.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- C1: ERP > Catalogo y tarifas (nucleo, E3, solo main).
      Hereda el DataContext del cascaron (ShellViewModel). C1: aspecto nuevo con la distribucion de siempre; para caber junto a la barra
      lateral a 1280 px, columnas 5/11/5, ficha de producto de 240 px y tarjetas y fichas algo mas densas (C2 la reordena). -->
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Style="{StaticResource PageHeader}">
   <TextBlock Text="Catálogo y tarifas" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{Binding Catalog.Summary}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
   <TextBlock Text="Nada se borra: productos, categorías, tarifas e impuestos se desactivan y conservan su historia. El precio que se cobra queda congelado en cada cuenta con su producto, presentación y tarifa." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="11*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
   <!-- Categorias: el arbol (sangria por nivel) con un alto que se lee y, debajo, su ficha, que se desplaza si no cabe. -->
   <Border Grid.Column="0" Style="{StaticResource CardDense}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="140"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Categoría" Command="{Binding Catalog.StartCategoryCommand}" Style="{StaticResource AddButton}"/><TextBlock Text="Categorías" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
     <CheckBox Grid.Row="1" Content="Ver todos los productos" IsChecked="{Binding Catalog.AllCategories}" Margin="0,0,0,8"/>
     <TextBlock Grid.Row="2" Text="Aún no hay categorías. Crea la primera con «＋ Categoría» o importa un fichero." Style="{StaticResource Subtle}" Margin="0,0,0,8" Visibility="{Binding Catalog.HasCategories, Converter={StaticResource NotBool2Vis}}"/>
     <ListBox Grid.Row="3" x:Name="CategoryList" ItemsSource="{Binding Catalog.Categories}" SelectedItem="{Binding Catalog.SelectedCategory}">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="{Binding Indent}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
     <Border Style="{StaticResource FormPanel}" Padding="10" Margin="0,0,14,0"><StackPanel>
      <TextBlock Text="{Binding Catalog.CategoryFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategoryId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewCategory}"/>
      <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.CategoryName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}"/>
      <TextBlock Text="Dentro de (vacío = raíz)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
      <ComboBox ItemsSource="{Binding Catalog.ParentChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.CategoryParentId}" IsEnabled="{Binding Catalog.CategoryEditable}"/>
      <WrapPanel Margin="0,6,0,0">
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Color (#RRGGBB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategoryColor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" Width="90"/></StackPanel>
       <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategorySort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" Width="60"/></StackPanel>
      </WrapPanel>
      <WrapPanel Margin="0,8,0,0"><Button Content="Guardar categoría" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveCategoryCommand}"/>
       <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleCategoryCommand}"/></WrapPanel>
     </StackPanel></Border>
     </ScrollViewer>
    </Grid>
   </Border>
   <!-- Productos y presentaciones -->
   <Border Grid.Column="2" Style="{StaticResource CardDense}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
     <DockPanel Grid.Column="0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Producto" Command="{Binding Catalog.StartProductCommand}" Style="{StaticResource AddButton}"/><TextBlock Text="Productos" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
      <TextBox DockPanel.Dock="Top" Text="{Binding Catalog.Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nombre, código o referencia" Margin="0,0,0,8"/>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="214">
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="＋ Presentación" Command="{Binding Catalog.StartPresentationCommand}" Style="{StaticResource AddButton}"/><TextBlock Text="Presentaciones" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis" ToolTip="Presentaciones del producto y precio vigente por tarifa"/></DockPanel>
       <TextBlock DockPanel.Dock="Bottom" Text="Un producto se vende siempre por una presentación (botella, copa, ración…). Sin precio vigente en la tarifa general no se vende." Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <ListBox x:Name="PresentationList" ItemsSource="{Binding Catalog.Presentations}" SelectedItem="{Binding Catalog.SelectedPresentation}"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="No hay productos que mostrar: cambia la categoría o la búsqueda, crea uno con «＋ Producto» o importa el catálogo desde un fichero en el equipo servidor." Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Catalog.HasProducts, Converter={StaticResource NotBool2Vis}}"/>
      <ListBox x:Name="ProductList" ItemsSource="{Binding Catalog.Products}" SelectedItem="{Binding Catalog.SelectedProduct}"/>
     </DockPanel>
     <!-- Margen derecho de 14: la barra de desplazamiento de Fluent se superpone; asi no tapa el borde de las fichas. -->
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">
      <Border Style="{StaticResource FormPanel}" Padding="10" Margin="0,0,0,10"><StackPanel>
       <TextBlock Text="{Binding Catalog.ProductFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewProduct}"/>
       <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.ProductName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}"/>
       <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
       <ComboBox ItemsSource="{Binding Catalog.ActiveCategories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductCategoryId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
       <TextBlock Text="Impuesto" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
       <ComboBox ItemsSource="{Binding Catalog.ActiveTaxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductTaxId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
       <TextBlock Text="Estación de cocina (si es un plato)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
       <ComboBox ItemsSource="{Binding Catalog.StationChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductStationId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
       <WrapPanel Margin="0,6,0,0">
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Referencia externa" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" Width="120"/></StackPanel>
        <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" Width="60"/></StackPanel>
       </WrapPanel>
       <StackPanel Visibility="{Binding Catalog.NewProduct, Converter={StaticResource Bool2Vis}}"><TextBlock Text="Primera presentación (p. ej. Botella, Ración)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.ProductPresentationName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <WrapPanel Margin="0,8,0,0"><Button Content="Guardar producto" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveProductCommand}"/>
        <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleProductCommand}"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource FormPanel}" Padding="10"><StackPanel>
       <TextBlock Text="{Binding Catalog.PresentationFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewPresentation}"/>
       <WrapPanel Margin="0,6,0,0">
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" Width="150"/></StackPanel>
        <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" Width="60"/></StackPanel>
       </WrapPanel>
       <WrapPanel Margin="0,8,0,0"><Button Content="Guardar presentación" Style="{StaticResource Primary}" Command="{Binding Catalog.SavePresentationCommand}"/>
        <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.TogglePresentationCommand}"/></WrapPanel>
       <TextBlock Text="Precio (IVA incluido)" Style="{StaticResource Section}" Margin="0,12,0,6"/>
       <TextBlock Text="Tarifa" Style="{StaticResource FieldLabel}"/>
       <ComboBox ItemsSource="{Binding Catalog.ActiveTariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.PriceTariffId}" IsEnabled="{Binding Catalog.PriceEditable}"/>
       <WrapPanel Margin="0,6,0,0">
        <StackPanel Margin="0,0,10,0"><TextBlock Text="Importe (€)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PriceText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" Width="90"/></StackPanel>
        <StackPanel><TextBlock Text="Desde (AAAA-MM-DD)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PriceValidFrom, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" Width="110"/></StackPanel>
       </WrapPanel>
       <Button Content="Fijar precio" Style="{StaticResource Primary}" Command="{Binding Catalog.SetPriceCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
   <!-- Tarifas e impuestos: listas cortas y fichas en una columna que se desplaza si no cabe (nunca se corta). -->
   <!-- Columna estrecha: hueco de 10 para la barra de desplazamiento (con 14 no cabia "Desactivar / reactivar"). -->
   <Border Grid.Column="4" Style="{StaticResource CardDense}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Tarifa" Command="{Binding Catalog.StartTariffCommand}" Style="{StaticResource AddButton}"/><TextBlock Text="Tarifas" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
     <ListBox x:Name="TariffList" ItemsSource="{Binding Catalog.Tariffs}" SelectedItem="{Binding Catalog.SelectedTariff}" MaxHeight="132"/>
     <TextBlock Text="La tarifa General existe siempre. Una sala puede usar otra tarifa: sin precio en ella se aplica la General." Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <Border Style="{StaticResource FormPanel}" Padding="10" Margin="0,8,0,0"><StackPanel>
      <TextBlock Text="{Binding Catalog.TariffFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <WrapPanel>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TariffId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTariff}" Width="100"/></StackPanel>
       <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TariffSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}" Width="60"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.TariffName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="Guardar tarifa" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveTariffCommand}"/>
       <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleTariffCommand}"/></WrapPanel>
     </StackPanel></Border>
     <DockPanel Margin="0,18,0,8"><Button DockPanel.Dock="Right" Content="＋ Impuesto" Command="{Binding Catalog.StartTaxCommand}" Style="{StaticResource AddButton}"/><TextBlock Text="Impuestos" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
     <ListBox x:Name="TaxList" ItemsSource="{Binding Catalog.Taxes}" SelectedItem="{Binding Catalog.SelectedTax}" MaxHeight="132"/>
     <Border Style="{StaticResource FormPanel}" Padding="10" Margin="0,8,0,0"><StackPanel>
      <TextBlock Text="{Binding Catalog.TaxFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <WrapPanel>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TaxId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTax}" Width="100"/></StackPanel>
       <StackPanel><TextBlock Text="Tipo (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TaxRate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}" Width="60"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.TaxName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}"/>
      <WrapPanel Margin="0,8,0,0"><Button Content="Guardar impuesto" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveTaxCommand}"/>
       <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleTaxCommand}"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
