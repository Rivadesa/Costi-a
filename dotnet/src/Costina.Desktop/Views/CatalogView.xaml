<UserControl x:Class="Costina.Desktop.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop">
 <!-- C2b (plan 2026-10-14): ERP > Catalogo y tarifas (nucleo, E3, solo main) con el patron del Comedor (ver el comentario C2b de
      Components.xaml). Hereda el DataContext del cascaron (ShellViewModel). Cabecera de pagina con la accion de alta de la pestana elegida;
      pestanas Productos · Categorias · Tarifas · Impuestos con su recuento; en cada una, la lista a la izquierda (360 px) y la ficha a la
      derecha, con su encabezado, sus secciones (el unico desplazamiento de la columna) y los botones abajo. Productos: buscador, filtro de
      categoria y "Ver todos"; la ficha lleva la foto (E3.2), los datos, las presentaciones con su precio en cada tarifa y "Fijar precio".
      Cada boton sigue con su orden y su CanExecute de siempre; sin nada elegido la ficha dice que elegir y no muestra campos. -->
 <UserControl.Resources>
  <!-- Desplegable de categorias: abierto, el arbol con sangria (ListText); cerrado, la ruta (BoxText, por DisplayMemberPath). -->
  <Style x:Key="TreeChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
   <Setter Property="Padding" Value="{Binding Padding}"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding ListText}"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <!-- Los botones secundarios de la ficha (FichaSecondary, FichaDanger), su nota al pie (FichaNote), la etiqueta que sigue a otra fila
       (NextLabel) y el contenido con el mas (PlusText) viven en Components.xaml desde la Oferta (C2b). -->
  <!-- Punto del color de una categoria en el arbol; sin color, un punto gris (un cuadrado vacio parecia una casilla). -->
  <Style x:Key="Swatch" TargetType="Border">
   <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="CornerRadius" Value="5"/><Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <!-- Precio de una presentacion en una tarifa: sin precio en la General (no se vende), en ambar y con su palabra; sin precio propio en
       otra tarifa, un guion gris (la nota de debajo lo explica). -->
  <Style x:Key="PriceCellText" TargetType="TextBlock">
   <Setter Property="Width" Value="96"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Tone}" Value="missing"><Setter Property="Foreground" Value="{StaticResource WarnText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
    <DataTrigger Binding="{Binding Tone}" Value="fallback"><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="FontWeight" Value="Normal"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- Contenido de un boton con la flecha detras (ir a sus productos). -->
  <DataTemplate x:Key="GoText"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconChevronRight}" Margin="4,0,0,0"/></StackPanel></DataTemplate>
 </UserControl.Resources>

 <DockPanel>
  <!-- ===== Cabecera de pagina: titulo, resumen y el alta de la pestana elegida ===== -->
  <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageBar}">
   <Button x:Name="NewProductButton" Style="{StaticResource PageAction}" Content="Nuevo producto" Command="{Binding Catalog.StartProductCommand}" Visibility="{Binding Catalog.ShowProducts, Converter={StaticResource Bool2Vis}}"/>
   <Button x:Name="NewCategoryButton" Style="{StaticResource PageAction}" Content="Nueva categoría" Command="{Binding Catalog.StartCategoryCommand}" Visibility="{Binding Catalog.ShowCategories, Converter={StaticResource Bool2Vis}}"/>
   <Button x:Name="NewTariffButton" Style="{StaticResource PageAction}" Content="Nueva tarifa" Command="{Binding Catalog.StartTariffCommand}" Visibility="{Binding Catalog.ShowTariffs, Converter={StaticResource Bool2Vis}}"/>
   <Button x:Name="NewTaxButton" Style="{StaticResource PageAction}" Content="Nuevo impuesto" Command="{Binding Catalog.StartTaxCommand}" Visibility="{Binding Catalog.ShowTaxes, Converter={StaticResource Bool2Vis}}"/>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="Catálogo y tarifas" Style="{StaticResource PageTitle}"/>
    <TextBlock x:Name="CatalogSummaryText" Text="{Binding Catalog.Summary}" Style="{StaticResource PageSummary}"/>
   </StackPanel>
  </DockPanel>
  <ListBox x:Name="SectionTabs" DockPanel.Dock="Top" Style="{StaticResource Segmented}" Margin="0,0,0,12" AutomationProperties.Name="Apartados del catálogo"
           ItemsSource="{Binding Catalog.Sections}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Catalog.Section}"/>

  <Grid>
   <!-- ======================= Productos ======================= -->
   <Grid x:Name="ProductsSection" Visibility="{Binding Catalog.ShowProducts, Converter={StaticResource Bool2Vis}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource ListWidth}"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
    <!-- Lista: buscador, categoria, recuento con "Ver todos" y los productos (miniatura, nombre y precio General; categoria y presentaciones). -->
    <Border x:Name="ProductsPane" Style="{StaticResource ListPane}">
     <DockPanel>
      <!-- E3.3: la lista por seccion: Cocina, Bodega y bebidas o Menus (los productos-menu, que se editan en Menus y cartas); Todos conserva la lista entera. -->
      <ListBox x:Name="SectionChips" DockPanel.Dock="Top" Style="{StaticResource FilterChips}" Margin="0,0,0,6" AutomationProperties.Name="Secciones del catálogo" Visibility="{Binding Catalog.ShowProductTools, Converter={StaticResource Bool2Vis}}"
               ItemsSource="{Binding Catalog.SectionFilters}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Catalog.SectionFilter}"/>
      <TextBox x:Name="ProductSearch" DockPanel.Dock="Top" Style="{StaticResource SearchField}" Visibility="{Binding Catalog.ShowProductTools, Converter={StaticResource Bool2Vis}}" local:Ui.Hint="Buscar por nombre, código o referencia"
               Text="{Binding Catalog.Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar un producto por nombre, código o referencia"/>
      <ComboBox x:Name="CategoryFilterBox" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding Catalog.ShowProductTools, Converter={StaticResource Bool2Vis}}" HorizontalAlignment="Stretch" AutomationProperties.Name="Filtrar por categoría"
                ItemsSource="{Binding Catalog.FilterChoices}" DisplayMemberPath="BoxText" SelectedValuePath="Id" SelectedValue="{Binding Catalog.CategoryFilter}"
                ItemContainerStyle="{StaticResource TreeChoiceItem}"/>
      <DockPanel DockPanel.Dock="Top" Margin="2,0,10,6" Visibility="{Binding Catalog.ShowProductTools, Converter={StaticResource Bool2Vis}}">
       <Button x:Name="ShowAllButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver todos" Command="{Binding Catalog.ShowAllCommand}"
               Visibility="{Binding Catalog.ShowAllLink, Converter={StaticResource Bool2Vis}}" AutomationProperties.Name="Ver todos los productos" ToolTip="Ver todos los productos: sin categoría ni búsqueda"/>
       <TextBlock x:Name="ProductCountText" Text="{Binding Catalog.ProductCount}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid>
       <!-- Lista vacia: dice que falta y ofrece crear el primero o volver a verlos todos. -->
       <StackPanel x:Name="ProductsEmpty" VerticalAlignment="Center" Margin="8,0,8,24" Visibility="{Binding Catalog.ShowProductListEmpty, Converter={StaticResource Bool2Vis}}">
        <ContentControl Style="{StaticResource EmptyState}" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Heading="{Binding Catalog.ProductListHeading}" Content="{Binding Catalog.ProductListText}"/>
        <Button x:Name="EmptyNewProductButton" Style="{StaticResource PageAction}" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Nuevo producto" Command="{Binding Catalog.StartProductCommand}"
                Visibility="{Binding Catalog.ShowCreateProduct, Converter={StaticResource Bool2Vis}}"/>
        <Button x:Name="EmptyShowAllButton" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Ver todos los productos" Command="{Binding Catalog.ShowAllCommand}"
                Visibility="{Binding Catalog.ShowShowAll, Converter={StaticResource Bool2Vis}}"/>
       </StackPanel>
       <!-- E3.2: cada fila con su miniatura (32 px). Lista virtualizada y reciclada: con la bodega entera (mas de mil vinos) solo se crean,
            y solo piden su imagen, las filas que se ven. Es el unico desplazamiento de la columna. -->
       <ListBox x:Name="ProductList" Style="{StaticResource PaneList}" ItemsSource="{Binding Catalog.Products}" SelectedItem="{Binding Catalog.SelectedProduct}" AutomationProperties.Name="Productos" SelectionChanged="ProductChosen"
                Visibility="{Binding Catalog.ShowProductListEmpty, Converter={StaticResource NotBool2Vis}}">
        <ListBox.ItemTemplate><DataTemplate>
         <DockPanel ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Product.Name}">
          <DockPanel.Style>
           <Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Inactive}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/></DataTrigger></Style.Triggers></Style>
          </DockPanel.Style>
          <Border DockPanel.Dock="Left" Style="{StaticResource ImageWell}" Width="34" Height="34" CornerRadius="7" Margin="0,1,10,1" VerticalAlignment="Top">
           <Grid>
            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconImage}" Stroke="{StaticResource InkDisabled}" HorizontalAlignment="Center"
                  Visibility="{Binding Thumbnail, Converter={StaticResource Null2Vis}}"/>
            <Border CornerRadius="6" Background="{StaticResource Surface}" Visibility="{Binding Thumbnail, Converter={StaticResource NotNull2Vis}}">
             <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform"/></Border.Background></Border>
            </Border>
           </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
           <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MainPrice}" Margin="8,0,0,0" FontSize="13">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Style.Triggers>
                <DataTrigger Binding="{Binding PriceMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnText}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                <DataTrigger Binding="{Binding Inactive}" Value="True"><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="FontWeight" Value="Normal"/></DataTrigger>
               </Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Product.Name}" Style="{StaticResource RowTitle}"/>
           </DockPanel>
           <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}"/>
          </StackPanel>
         </DockPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </DockPanel>
    </Border>

    <!-- Ficha del producto: ruta de su categoria, nombre y estado; foto y datos; presentaciones con su precio en cada tarifa y la
         presentacion elegida (sus datos y "Fijar precio"); abajo, guardar y desactivar o reactivar. -->
    <Border x:Name="ProductPanel" Grid.Column="2" Style="{StaticResource Ficha}" AutomationProperties.Name="{Binding Catalog.ProductFormTitle}">
     <Grid>
      <ContentControl x:Name="ProductEmpty" Style="{StaticResource FichaEmpty}" local:Ui.Icon="{StaticResource IconCatalog}"
                      local:Ui.Heading="{Binding Catalog.ProductEmptyHeading}" Content="{Binding Catalog.ProductEmptyText}" Visibility="{Binding Catalog.HasProductContext, Converter={StaticResource NotBool2Vis}}"/>
      <DockPanel x:Name="ProductDetail" Visibility="{Binding Catalog.HasProductContext, Converter={StaticResource Bool2Vis}}">
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock x:Name="ProductContextText" Text="{Binding Catalog.ProductContext}" Style="{StaticResource FichaContext}"/>
        <WrapPanel Margin="0,2,0,0">
         <TextBlock x:Name="ProductTitleText" Text="{Binding Catalog.ProductTitle}" Style="{StaticResource FichaTitle}"/>
         <Border Style="{StaticResource FichaChip}" Tag="{Binding Catalog.ProductStateTone}" Visibility="{Binding Catalog.ProductStateText, Converter={StaticResource Text2Vis}}"><TextBlock Text="{Binding Catalog.ProductStateText}"/></Border>
         <Border Style="{StaticResource FichaChip}" Tag="warn" Visibility="{Binding Catalog.ProductWarnText, Converter={StaticResource Text2Vis}}"><TextBlock Text="{Binding Catalog.ProductWarnText}"/></Border>
        </WrapPanel>
       </StackPanel>
       <Border Style="{StaticResource FichaActions}">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="SaveProductButton" Style="{StaticResource BigAction}" Content="{Binding Catalog.ProductSaveText}" ContentTemplate="{StaticResource ButtonText}" Command="{Binding Catalog.SaveProductCommand}"/>
         <Button x:Name="DeactivateProductButton" Grid.Column="1" Style="{StaticResource FichaDanger}" Content="Desactivar producto" Command="{Binding Catalog.ToggleProductCommand}"
                 Visibility="{Binding Catalog.ProductDeactivates, Converter={StaticResource Bool2Vis}}" ToolTip="Deja de venderse; no se borra y se puede reactivar"/>
         <Button x:Name="ReactivateProductButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Reactivar producto" Command="{Binding Catalog.ToggleProductCommand}"
                 Visibility="{Binding Catalog.ProductReactivates, Converter={StaticResource Bool2Vis}}"/>
         <Button x:Name="CancelProductButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Cancelar" Command="{Binding Catalog.CancelProductCommand}"
                 Visibility="{Binding Catalog.NewProduct, Converter={StaticResource Bool2Vis}}"/>
        </Grid>
       </Border>
       <ScrollViewer x:Name="ProductScroll" Style="{StaticResource FichaScroll}">
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- E3.2: foto del producto (140 px) o su hueco con el motivo; debajo, cambiarla y quitarla (solo el responsable: los botones
               siguen a las ordenes del catalogo). La foto se pide al servidor una vez y se guarda en memoria por su huella. -->
          <StackPanel>
           <Border x:Name="ProductPhotoWell" Style="{StaticResource ImageWell}" Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeStrong}" Width="140" Height="140">
            <Grid>
             <StackPanel VerticalAlignment="Center" Margin="10" Visibility="{Binding Catalog.ProductPhoto, Converter={StaticResource Null2Vis}}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconImage}" Stroke="{StaticResource InkDisabled}" HorizontalAlignment="Center">
               <Path.LayoutTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6"/></Path.LayoutTransform>
              </Path>
              <TextBlock x:Name="ProductPhotoText" Text="{Binding Catalog.PhotoText}" Style="{StaticResource Subtle}" TextAlignment="Center" Margin="0,8,0,0"/>
             </StackPanel>
             <Border CornerRadius="9" Margin="1" Visibility="{Binding Catalog.ProductPhoto, Converter={StaticResource NotNull2Vis}}">
              <Border.Background><ImageBrush ImageSource="{Binding Catalog.ProductPhoto}" Stretch="Uniform"/></Border.Background>
             </Border>
            </Grid>
           </Border>
           <Button x:Name="ChangeImageButton" Content="Cambiar imagen…" Command="{Binding Catalog.ChangeImageCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" FontWeight="Normal"
                   ToolTip="Elige una foto JPEG, PNG o WebP de hasta 2 MB"/>
           <Button x:Name="RemoveImageButton" Content="Quitar imagen" Command="{Binding Catalog.RemoveImageCommand}" Style="{StaticResource Ghost}" HorizontalAlignment="Stretch" Margin="0,4,0,0" FontWeight="Normal"
                   ToolTip="La imagen deja de mostrarse; no se borra y se puede volver a poner"/>
          </StackPanel>
          <!-- Datos: nombre, categoria (por su ruta), impuesto, estacion de cocina por su nombre y referencia externa; el codigo fijo (solo
               se teclea en un alta) y el orden van en "Mas opciones" (E3.3). -->
          <Grid x:Name="ProductFields" Grid.Column="2">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>
           <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Nombre" Style="{StaticResource FieldLabel}"/>
           <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Catalog.ProductName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" AutomationProperties.Name="Nombre del producto"/>
           <TextBlock Grid.Row="4" Text="Categoría" Style="{StaticResource NextLabel}"/>
           <TextBlock Grid.Row="4" Grid.Column="2" Text="Impuesto" Style="{StaticResource NextLabel}"/>
           <ComboBox x:Name="ProductCategoryBox" Grid.Row="5" ItemsSource="{Binding Catalog.ActiveCategories}" DisplayMemberPath="BoxText" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductCategoryId}"
                     ItemContainerStyle="{StaticResource TreeChoiceItem}" IsEnabled="{Binding Catalog.ProductEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="Categoría del producto"/>
           <ComboBox x:Name="ProductTaxBox" Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Catalog.ActiveTaxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductTaxId}"
                     IsEnabled="{Binding Catalog.ProductEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="Impuesto del producto"/>
           <TextBlock Grid.Row="6" Text="Estación de cocina" Style="{StaticResource NextLabel}"/>
           <TextBlock Grid.Row="6" Grid.Column="2" Text="Referencia externa" Style="{StaticResource NextLabel}"/>
           <ComboBox x:Name="ProductStationBox" Grid.Row="7" ItemsSource="{Binding Catalog.StationChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductStationId}"
                     IsEnabled="{Binding Catalog.ProductEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="Estación de cocina del producto"
                     ToolTip="Donde se prepara un plato. Una bebida o un consumo directo no pasa por cocina."/>
           <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Catalog.ProductReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" AutomationProperties.Name="Referencia externa del producto"/>
           <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="Primera presentación (p. ej. Botella, Ración)" Style="{StaticResource NextLabel}" Visibility="{Binding Catalog.NewProduct, Converter={StaticResource Bool2Vis}}"/>
           <TextBox Grid.Row="9" Grid.ColumnSpan="3" Text="{Binding Catalog.ProductPresentationName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Catalog.NewProduct, Converter={StaticResource Bool2Vis}}"
                    AutomationProperties.Name="Primera presentación del producto"/>
          </Grid>
         </Grid>

         <Expander x:Name="ProductMoreOptions" Header="Más opciones" IsExpanded="False" Margin="0,12,0,0">
            <Grid Margin="0,6,0,0">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/>
             <TextBlock Grid.Column="2" Text="Orden" Style="{StaticResource FieldLabel}"/>
             <TextBox Grid.Row="1" Text="{Binding Catalog.ProductId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewProduct}" AutomationProperties.Name="Código del producto" ToolTip="Opcional: si lo dejas vacío se genera del nombre. Una vez creado no se puede cambiar."/>
             <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.ProductSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" AutomationProperties.Name="Orden del producto"/>
            </Grid>
         </Expander>
         <!-- Presentaciones (lo que se vende: botella, copa...) con su precio vigente en cada tarifa activa; elegir una abre sus datos y
              "Fijar precio" debajo. -->
         <StackPanel x:Name="PresentationsArea" Visibility="{Binding Catalog.ShowPresentations, Converter={StaticResource Bool2Vis}}">
          <DockPanel Margin="0,22,0,8">
           <Button x:Name="AddPresentationButton" DockPanel.Dock="Right" Style="{StaticResource AddButton}" Content="Presentación" ContentTemplate="{StaticResource PlusText}"
                   Command="{Binding Catalog.StartPresentationCommand}" Click="ShowPresentationEditor" AutomationProperties.Name="Añadir una presentación"/>
           <TextBlock Text="Presentaciones y precios" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Style="{StaticResource TableHead}">
           <DockPanel>
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Catalog.PriceColumns}" Focusable="False">
             <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Width="96" TextAlignment="Right" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Presentación"/>
           </DockPanel>
          </Border>
          <ListBox x:Name="PresentationList" Style="{StaticResource TableList}" ItemsSource="{Binding Catalog.Presentations}" SelectedItem="{Binding Catalog.SelectedPresentation}" AutomationProperties.Name="Presentaciones"
                   PreviewMouseLeftButtonUp="ShowPresentationEditor">
           <ListBox.ItemTemplate><DataTemplate>
            <DockPanel>
             <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Cells}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource PriceCellText}"/></DataTemplate></ItemsControl.ItemTemplate>
             </ItemsControl>
             <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Presentation.Name}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource ToneChip}" Margin="8,0,0,0" Visibility="{Binding Inactive, Converter={StaticResource Bool2Vis}}"><TextBlock Text="Desactivada" FontWeight="SemiBold"/></Border>
             </StackPanel>
            </DockPanel>
           </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoPresentationsText" Text="Este producto aún no tiene presentaciones: añade una con «Presentación»." Style="{StaticResource Body}" Margin="10,10,0,0"
                     Visibility="{Binding Catalog.PresentationsEmpty, Converter={StaticResource Bool2Vis}}"/>
          <TextBlock x:Name="PriceNoteText" Text="{Binding Catalog.PriceNote}" Style="{StaticResource Subtle}" Margin="10,8,0,0" Visibility="{Binding Catalog.PresentationsEmpty, Converter={StaticResource NotBool2Vis}}"/>

          <!-- La presentacion elegida: sus datos (guardar y desactivar o reactivar) y, debajo, fijar su precio en una tarifa. -->
          <Border x:Name="PresentationEditor" Style="{StaticResource FormPanel}" Margin="0,12,0,0" Visibility="{Binding Catalog.HasPresentationEditor, Converter={StaticResource Bool2Vis}}">
           <StackPanel>
            <TextBlock Text="{Binding Catalog.PresentationFormTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/>
             <TextBlock Grid.Column="2" Text="Nombre" Style="{StaticResource FieldLabel}"/>
             <TextBlock Grid.Column="4" Text="Orden" Style="{StaticResource FieldLabel}"/>
             <TextBox Grid.Row="1" Text="{Binding Catalog.PresentationId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewPresentation}" AutomationProperties.Name="Código de la presentación" ToolTip="Opcional: si lo dejas vacío se genera del nombre. Una vez creado no se puede cambiar."/>
             <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.PresentationName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" AutomationProperties.Name="Nombre de la presentación"/>
             <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Catalog.PresentationSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" AutomationProperties.Name="Orden de la presentación"/>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
             <Button x:Name="SavePresentationButton" Content="{Binding Catalog.PresentationSaveText}" Style="{StaticResource Primary}" Command="{Binding Catalog.SavePresentationCommand}" Margin="0,0,8,0"/>
             <Button x:Name="DeactivatePresentationButton" Content="Desactivar presentación" Style="{StaticResource DangerButton}" Command="{Binding Catalog.TogglePresentationCommand}" Margin="0"
                     Visibility="{Binding Catalog.PresentationDeactivates, Converter={StaticResource Bool2Vis}}"/>
             <Button x:Name="ReactivatePresentationButton" Content="Reactivar presentación" Command="{Binding Catalog.TogglePresentationCommand}" Margin="0"
                     Visibility="{Binding Catalog.PresentationReactivates, Converter={StaticResource Bool2Vis}}"/>
             <Button x:Name="CancelPresentationButton" Content="Cancelar" Command="{Binding Catalog.CancelPresentationCommand}" Margin="0"
                     Visibility="{Binding Catalog.NewPresentation, Converter={StaticResource Bool2Vis}}"/>
            </WrapPanel>
            <StackPanel x:Name="PriceForm" Visibility="{Binding Catalog.NewPresentation, Converter={StaticResource NotBool2Vis}}">
             <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,12"/>
             <TextBlock Text="Fijar precio (IVA incluido)" Style="{StaticResource Section}"/>
             <Grid>
              <Grid.ColumnDefinitions>
               <ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="132"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Tarifa" Style="{StaticResource FieldLabel}"/>
              <TextBlock Grid.Column="2" Text="Importe (€)" Style="{StaticResource FieldLabel}"/>
              <TextBlock Grid.Column="4" Text="Desde (dd/mm/aaaa)" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="PriceTariffBox" Grid.Row="1" ItemsSource="{Binding Catalog.ActiveTariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.PriceTariffId}"
                        IsEnabled="{Binding Catalog.PriceEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="Tarifa del precio"/>
              <TextBox x:Name="PriceBox" Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.PriceText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" TextAlignment="Right" AutomationProperties.Name="Importe en euros, IVA incluido"/>
              <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Catalog.PriceValidFrom, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" AutomationProperties.Name="Fecha desde la que vale el precio"/>
              <Button x:Name="SetPriceButton" Grid.Row="1" Grid.Column="6" Content="Fijar precio" Style="{StaticResource Primary}" Command="{Binding Catalog.SetPriceCommand}" Margin="0"/>
             </Grid>
             <TextBlock x:Name="ScheduledPriceText" Text="{Binding Catalog.ScheduledText}" Style="{StaticResource Subtle}" Margin="0,8,0,0" Visibility="{Binding Catalog.ScheduledText, Converter={StaticResource Text2Vis}}"/>
            </StackPanel>
           </StackPanel>
          </Border>
         </StackPanel>
         <TextBlock Text="Nada se borra: un producto desactivado deja de venderse y conserva su historia. El precio cobrado queda congelado en cada cuenta con su producto, presentación y tarifa."
                    Style="{StaticResource FichaNote}"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Grid>
    </Border>
   </Grid>

   <!-- ======================= Categorias ======================= -->
   <Grid x:Name="CategoriesSection" Visibility="{Binding Catalog.ShowCategories, Converter={StaticResource Bool2Vis}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource ListWidth}"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
    <!-- Arbol: sangria por nivel con su ramita, muestra de color, nombre y, debajo, productos y subcategorias. -->
    <Border x:Name="CategoriesPane" Style="{StaticResource ListPane}">
     <DockPanel>
      <TextBlock x:Name="CategoryCountText" DockPanel.Dock="Top" Text="{Binding Catalog.CategoryCount}" Style="{StaticResource Subtle}" Margin="2,2,10,8"/>
      <Grid>
       <StackPanel x:Name="CategoriesEmpty" VerticalAlignment="Center" Margin="8,0,8,24" Visibility="{Binding Catalog.ShowCategoryListEmpty, Converter={StaticResource Bool2Vis}}">
        <ContentControl Style="{StaticResource EmptyState}" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Heading="{Binding Catalog.CategoryListHeading}" Content="{Binding Catalog.CategoryListText}"/>
        <Button x:Name="EmptyNewCategoryButton" Style="{StaticResource PageAction}" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Nueva categoría" Command="{Binding Catalog.StartCategoryCommand}"/>
       </StackPanel>
       <ListBox x:Name="CategoryList" Style="{StaticResource PaneList}" ItemsSource="{Binding Catalog.Categories}" SelectedItem="{Binding Catalog.SelectedCategory}" AutomationProperties.Name="Categorías"
                Visibility="{Binding Catalog.ShowCategoryListEmpty, Converter={StaticResource NotBool2Vis}}">
        <ListBox.ItemTemplate><DataTemplate>
         <DockPanel Margin="{Binding Indent}" AutomationProperties.Name="{Binding Path}">
          <DockPanel.Style>
           <Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Inactive}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/></DataTrigger></Style.Triggers></Style>
          </DockPanel.Style>
          <Path DockPanel.Dock="Left" Data="M1,0 L1,6 Q1,9 4,9 L10,9" Stroke="{StaticResource StrokeStrong}" StrokeThickness="1.5" Width="12" Height="12" Margin="0,1,6,0" VerticalAlignment="Top"
                Visibility="{Binding HasParent, Converter={StaticResource Bool2Vis}}"/>
          <Border DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{Binding Swatch, TargetNullValue={StaticResource StrokeStrong}}" Margin="0,5,10,0"/>
          <StackPanel>
           <DockPanel>
            <!-- Repaso de coherencia de C2b: "Desactivada" a la derecha, donde un producto desactivado lo dice en lugar de su precio. -->
            <TextBlock DockPanel.Dock="Right" Text="Desactivada" Margin="8,0,0,0" FontSize="13" FontWeight="Normal" Foreground="{StaticResource InkSoft}"
                       Visibility="{Binding Inactive, Converter={StaticResource Bool2Vis}}"/>
            <TextBlock Text="{Binding Category.Name}" Style="{StaticResource RowTitle}"/>
           </DockPanel>
           <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}"/>
          </StackPanel>
         </DockPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </DockPanel>
    </Border>

    <Border x:Name="CategoryPanel" Grid.Column="2" Style="{StaticResource Ficha}" AutomationProperties.Name="{Binding Catalog.CategoryFormTitle}">
     <Grid>
      <ContentControl x:Name="CategoryEmpty" Style="{StaticResource FichaEmpty}" local:Ui.Icon="{StaticResource IconCatalog}"
                      local:Ui.Heading="{Binding Catalog.CategoryEmptyHeading}" Content="{Binding Catalog.CategoryEmptyText}" Visibility="{Binding Catalog.HasCategoryContext, Converter={StaticResource NotBool2Vis}}"/>
      <DockPanel x:Name="CategoryDetail" Visibility="{Binding Catalog.HasCategoryContext, Converter={StaticResource Bool2Vis}}">
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="{Binding Catalog.CategoryContext}" Style="{StaticResource FichaContext}"/>
        <WrapPanel Margin="0,2,0,0">
         <TextBlock x:Name="CategoryTitleText" Text="{Binding Catalog.CategoryTitle}" Style="{StaticResource FichaTitle}"/>
         <Border Style="{StaticResource FichaChip}" Tag="{Binding Catalog.CategoryStateTone}" Visibility="{Binding Catalog.CategoryStateText, Converter={StaticResource Text2Vis}}"><TextBlock Text="{Binding Catalog.CategoryStateText}"/></Border>
        </WrapPanel>
       </StackPanel>
       <Border Style="{StaticResource FichaActions}">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="SaveCategoryButton" Style="{StaticResource BigAction}" Content="{Binding Catalog.CategorySaveText}" ContentTemplate="{StaticResource ButtonText}" Command="{Binding Catalog.SaveCategoryCommand}"/>
         <Button x:Name="DeactivateCategoryButton" Grid.Column="1" Style="{StaticResource FichaDanger}" Content="Desactivar categoría" Command="{Binding Catalog.ToggleCategoryCommand}"
                 Visibility="{Binding Catalog.CategoryDeactivates, Converter={StaticResource Bool2Vis}}" ToolTip="No se borra y se puede reactivar"/>
         <Button x:Name="ReactivateCategoryButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Reactivar categoría" Command="{Binding Catalog.ToggleCategoryCommand}"
                 Visibility="{Binding Catalog.CategoryReactivates, Converter={StaticResource Bool2Vis}}"/>
         <Button x:Name="CancelCategoryButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Cancelar" Command="{Binding Catalog.CancelCategoryCommand}"
                 Visibility="{Binding Catalog.NewCategory, Converter={StaticResource Bool2Vis}}"/>
        </Grid>
       </Border>
       <ScrollViewer x:Name="CategoryScroll" Style="{StaticResource FichaScroll}">
        <StackPanel>
         <TextBlock Text="Datos" Style="{StaticResource Section}"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
           <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Nombre" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Catalog.CategoryName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" AutomationProperties.Name="Nombre de la categoría"/>
          <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Dentro de" Style="{StaticResource NextLabel}"/>
          <ComboBox x:Name="CategoryParentBox" Grid.Row="5" Grid.ColumnSpan="3" ItemsSource="{Binding Catalog.ParentChoices}" DisplayMemberPath="BoxText" SelectedValuePath="Id" SelectedValue="{Binding Catalog.CategoryParentId}"
                    ItemContainerStyle="{StaticResource TreeChoiceItem}" IsEnabled="{Binding Catalog.CategoryEditable}" HorizontalAlignment="Stretch" AutomationProperties.Name="Dentro de qué categoría va"/>
          <!-- E3.3: una familia raiz que no es una seccion se coloca con un boton; el codigo, el orden y el color van en "Mas opciones". -->
          <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Catalog.CanPlaceCategory, Converter={StaticResource Bool2Vis}}">
           <Button x:Name="PlaceInKitchenButton" Content="Mover a Cocina" Command="{Binding Catalog.PlaceCategoryCommand}" CommandParameter="_cocina" Margin="0,0,8,0" ToolTip="Esta familia pasa a la sección Cocina"/>
           <Button x:Name="PlaceInCellarButton" Content="Mover a Bodega y bebidas" Command="{Binding Catalog.PlaceCategoryCommand}" CommandParameter="_bodega" Margin="0" ToolTip="Esta familia pasa a la sección Bodega y bebidas"/>
          </StackPanel>
          <Expander x:Name="CategoryMoreOptions" Grid.Row="7" Grid.ColumnSpan="3" Header="Más opciones" IsExpanded="False" Margin="0,10,0,0">
           <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Column="2" Text="Orden" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="1" Text="{Binding Catalog.CategoryId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewCategory}" AutomationProperties.Name="Código de la categoría" ToolTip="Opcional: si lo dejas vacío se genera del nombre. Una vez creado no se puede cambiar."/>
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.CategorySort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" AutomationProperties.Name="Orden de la categoría"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Color (#RRGGBB, opcional)" Style="{StaticResource NextLabel}"/>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal">
             <TextBox Text="{Binding Catalog.CategoryColor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" Width="130" AutomationProperties.Name="Color de la categoría"/>
             <Border x:Name="CategoryColorPreview" Background="{Binding Catalog.CategorySwatch}" Width="32" Height="32" CornerRadius="8" BorderBrush="#1F000000" BorderThickness="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     Visibility="{Binding Catalog.CategorySwatch, Converter={StaticResource NotNull2Vis}}"/>
            </StackPanel>
           </Grid>
          </Expander>
         </Grid>
         <StackPanel Visibility="{Binding Catalog.NewCategory, Converter={StaticResource NotBool2Vis}}">
          <TextBlock Text="Contenido" Style="{StaticResource SectionGap}"/>
          <UniformGrid Columns="2" Margin="0,0,-10,0">
           <Border Style="{StaticResource FigureBox}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="Productos (con sus subcategorías)" Style="{StaticResource FigureLabel}"/><TextBlock x:Name="CategoryProductsFigure" Text="{Binding Catalog.CategoryProductsFigure}" Style="{StaticResource FigureValue}"/></StackPanel>
           </Border>
           <Border Style="{StaticResource FigureBox}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="Subcategorías" Style="{StaticResource FigureLabel}"/><TextBlock x:Name="CategoryChildrenFigure" Text="{Binding Catalog.CategoryChildrenFigure}" Style="{StaticResource FigureValue}"/></StackPanel>
           </Border>
          </UniformGrid>
          <TextBlock x:Name="CategoryChildrenText" Text="{Binding Catalog.CategoryChildrenText}" Style="{StaticResource Body}" Margin="2,10,0,0"/>
          <Button x:Name="ShowCategoryProductsButton" Content="Ver sus productos" ContentTemplate="{StaticResource GoText}" Command="{Binding Catalog.ShowCategoryProductsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                  ToolTip="Abre Productos con esta categoría (y sus subcategorías) como filtro"/>
         </StackPanel>
         <TextBlock Text="Nada se borra: una categoría desactivada deja de ofrecerse para productos nuevos y conserva su historia." Style="{StaticResource FichaNote}"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Grid>
    </Border>
   </Grid>

   <!-- ======================= E3.3: Vinos por copa (la bodega en bloque) ======================= -->
   <!-- Una tabla de la Bodega: buscador, familia (con sus subfamilias), el precio de la botella a la vista y, por fila, marcar, "Por copa" y
        el precio de la copa. Lo tecleado es un borrador por producto (una relectura no lo pisa); "Guardar copas" es UNA orden glass-sale-set
        con los marcados y los quitados. Sobre los marcados: mismo precio, cambiar IVA y mover a una familia. -->
   <Grid x:Name="GlassSection" Visibility="{Binding Catalog.ShowGlass, Converter={StaticResource Bool2Vis}}">
    <Border x:Name="GlassPane" Style="{StaticResource Ficha}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
       <TextBlock Text="Bodega y bebidas" Style="{StaticResource FichaContext}"/>
       <WrapPanel Margin="0,2,0,0">
        <TextBlock Text="Vinos por copa" Style="{StaticResource FichaTitle}"/>
        <TextBlock x:Name="GlassCountText" Text="{Binding Catalog.GlassCount}" Style="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
       </WrapPanel>
       <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <TextBox x:Name="GlassSearch" Style="{StaticResource SearchField}" local:Ui.Hint="Buscar por nombre, referencia o familia" Text="{Binding Catalog.GlassSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar un vino por nombre, referencia o familia"/>
        <ComboBox x:Name="GlassFamilyBox" Grid.Column="2" ItemsSource="{Binding Catalog.GlassFamilies}" DisplayMemberPath="BoxText" SelectedValuePath="Id" SelectedValue="{Binding Catalog.GlassFamily}" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="Filtrar por familia"/>
       </Grid>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" Style="{StaticResource FichaActions}">
       <StackPanel>
        <TextBlock x:Name="GlassSummaryText" Text="{Binding Catalog.GlassSummary}" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,10">
         <Button x:Name="CheckAllButton" Content="Marcar todos" Command="{Binding Catalog.CheckAllCommand}" Margin="0,0,8,6" FontWeight="Normal"/>
         <Button x:Name="UncheckAllButton" Content="Desmarcar" Command="{Binding Catalog.UncheckAllCommand}" Margin="0,0,16,6" FontWeight="Normal"/>
         <TextBox x:Name="SamePriceBox" Text="{Binding Catalog.SamePriceText, UpdateSourceTrigger=PropertyChanged}" Width="90" TextAlignment="Right" Margin="0,0,6,6" AutomationProperties.Name="Precio de la copa para los marcados, en euros"/>
         <Button x:Name="SamePriceButton" Content="Mismo precio para los marcados" Command="{Binding Catalog.SamePriceCommand}" Margin="0,0,16,6" FontWeight="Normal" ToolTip="Escribe ese precio de copa en los marcados; no envía nada hasta «Guardar copas»"/>
         <ComboBox x:Name="BulkTaxBox" ItemsSource="{Binding Catalog.BulkTaxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.GlassTaxId}" Width="130" Margin="0,0,6,6" AutomationProperties.Name="Impuesto para los marcados"/>
         <Button x:Name="SetTaxButton" Content="Cambiar IVA de los marcados" Command="{Binding Catalog.SetTaxCommand}" Margin="0,0,16,6" FontWeight="Normal" ToolTip="Una sola orden para todos los marcados"/>
         <ComboBox x:Name="MoveTargetBox" ItemsSource="{Binding Catalog.MoveTargets}" DisplayMemberPath="BoxText" SelectedValuePath="Id" SelectedValue="{Binding Catalog.MoveTargetId}" ItemContainerStyle="{StaticResource TreeChoiceItem}" Width="220" Margin="0,0,6,6" AutomationProperties.Name="Familia de destino de los marcados"/>
         <Button x:Name="MoveCheckedButton" Content="Mover los marcados a esa familia" Command="{Binding Catalog.MoveCheckedCommand}" Margin="0,0,0,6" FontWeight="Normal"/>
        </WrapPanel>
        <Button x:Name="SaveGlassButton" Style="{StaticResource BigAction}" Content="Guardar copas" ContentTemplate="{StaticResource ButtonText}" Command="{Binding Catalog.SaveGlassCommand}" ToolTip="Una sola orden con los vinos por copa y sus precios (y los que dejan de venderse por copa)"/>
       </StackPanel>
      </Border>
      <Grid>
       <ContentControl x:Name="GlassEmpty" Style="{StaticResource EmptyState}" VerticalAlignment="Center" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Heading="Nada en Bodega y bebidas"
                       Content="Los vinos y las bebidas (sin estación de cocina, o en la sección Bodega y bebidas) aparecen aquí." Visibility="{Binding Catalog.ShowGlassEmpty, Converter={StaticResource Bool2Vis}}"/>
       <DockPanel Visibility="{Binding Catalog.ShowGlassEmpty, Converter={StaticResource NotBool2Vis}}">
        <Border DockPanel.Dock="Top" Style="{StaticResource TableHead}">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
          <TextBlock Text="Marcar"/><TextBlock Grid.Column="1" Text="Vino o bebida"/><TextBlock Grid.Column="2" Text="Botella" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="Por copa" HorizontalAlignment="Center"/><TextBlock Grid.Column="4" Text="Precio copa (€)" HorizontalAlignment="Right"/>
         </Grid>
        </Border>
        <ListBox x:Name="GlassList" Style="{StaticResource TableList}" ItemsSource="{Binding Catalog.GlassRows}" AutomationProperties.Name="Vinos de la bodega" KeyboardNavigation.TabNavigation="Continue">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Grid AutomationProperties.Name="{Binding Name}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="Marcar"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding BottleText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
            <CheckBox Grid.Column="3" IsChecked="{Binding ByGlass}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Por copa"/>
            <TextBox Grid.Column="4" Text="{Binding GlassPrice, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ByGlass}" TextAlignment="Right" Width="100" HorizontalAlignment="Right" AutomationProperties.Name="Precio de la copa en euros"/>
           </Grid>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
      </Grid>
     </DockPanel>
    </Border>
   </Grid>

   <!-- ======================= Tarifas ======================= -->
   <Grid x:Name="TariffsSection" Visibility="{Binding Catalog.ShowTariffs, Converter={StaticResource Bool2Vis}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource ListWidth}"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
    <Border x:Name="TariffsPane" Style="{StaticResource ListPane}">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="La General existe siempre. Cada sala cobra con su tarifa y, sin precio en ella, con la General." Style="{StaticResource Subtle}" Margin="2,2,10,10"/>
      <ListBox x:Name="TariffList" Style="{StaticResource CardRows}" ItemsSource="{Binding Catalog.TariffItems}" SelectedValuePath="Tariff" SelectedValue="{Binding Catalog.SelectedTariff}" AutomationProperties.Name="Tarifas">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel AutomationProperties.Name="{Binding Tariff.Name}">
         <StackPanel.Style>
          <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Inactive}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/></DataTrigger></Style.Triggers></Style>
         </StackPanel.Style>
         <!-- Repaso de coherencia de C2b: la tarjeta de Oferta y Salas (nombre como titulo, el estado en su chip, el detalle que se parte). -->
         <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource ToneChip}" Margin="8,1,0,0" VerticalAlignment="Top" Visibility="{Binding Inactive, Converter={StaticResource Bool2Vis}}">
           <TextBlock Text="Desactivada"/>
          </Border>
          <TextBlock Text="{Binding Tariff.Name}" Style="{StaticResource CardRowTitle}"/>
         </DockPanel>
         <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}" TextTrimming="None" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>

    <Border x:Name="TariffPanel" Grid.Column="2" Style="{StaticResource Ficha}" AutomationProperties.Name="{Binding Catalog.TariffFormTitle}">
     <Grid>
      <ContentControl x:Name="TariffEmpty" Style="{StaticResource FichaEmpty}" local:Ui.Icon="{StaticResource IconCatalog}"
                      local:Ui.Heading="{Binding Catalog.TariffEmptyHeading}" Content="{Binding Catalog.TariffEmptyText}" Visibility="{Binding Catalog.HasTariffContext, Converter={StaticResource NotBool2Vis}}"/>
      <DockPanel x:Name="TariffDetail" Visibility="{Binding Catalog.HasTariffContext, Converter={StaticResource Bool2Vis}}">
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="{Binding Catalog.TariffContext}" Style="{StaticResource FichaContext}"/>
        <WrapPanel Margin="0,2,0,0">
         <TextBlock x:Name="TariffTitleText" Text="{Binding Catalog.TariffTitle}" Style="{StaticResource FichaTitle}"/>
         <Border Style="{StaticResource FichaChip}" Tag="{Binding Catalog.TariffStateTone}" Visibility="{Binding Catalog.TariffStateText, Converter={StaticResource Text2Vis}}"><TextBlock Text="{Binding Catalog.TariffStateText}"/></Border>
         <Border Style="{StaticResource FichaChip}" Tag="info" Visibility="{Binding Catalog.IsGeneralTariff, Converter={StaticResource Bool2Vis}}"><TextBlock Text="Siempre presente"/></Border>
        </WrapPanel>
       </StackPanel>
       <Border Style="{StaticResource FichaActions}">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="SaveTariffButton" Style="{StaticResource BigAction}" Content="{Binding Catalog.TariffSaveText}" ContentTemplate="{StaticResource ButtonText}" Command="{Binding Catalog.SaveTariffCommand}"/>
         <Button x:Name="DeactivateTariffButton" Grid.Column="1" Style="{StaticResource FichaDanger}" Content="Desactivar tarifa" Command="{Binding Catalog.ToggleTariffCommand}"
                 Visibility="{Binding Catalog.TariffDeactivates, Converter={StaticResource Bool2Vis}}" ToolTip="No se borra y se puede reactivar"/>
         <Button x:Name="ReactivateTariffButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Reactivar tarifa" Command="{Binding Catalog.ToggleTariffCommand}"
                 Visibility="{Binding Catalog.TariffReactivates, Converter={StaticResource Bool2Vis}}"/>
         <Button x:Name="CancelTariffButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Cancelar" Command="{Binding Catalog.CancelTariffCommand}"
                 Visibility="{Binding Catalog.NewTariff, Converter={StaticResource Bool2Vis}}"/>
        </Grid>
       </Border>
       <ScrollViewer x:Name="TariffScroll" Style="{StaticResource FichaScroll}">
        <StackPanel>
         <TextBlock Text="Datos" Style="{StaticResource Section}"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/>
          <TextBlock Grid.Column="2" Text="Orden" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="1" Text="{Binding Catalog.TariffId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTariff}" AutomationProperties.Name="Código de la tarifa" ToolTip="Opcional: si lo dejas vacío se genera del nombre. Una vez creado no se puede cambiar."/>
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.TariffSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}" AutomationProperties.Name="Orden de la tarifa"/>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Nombre" Style="{StaticResource NextLabel}"/>
          <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Catalog.TariffName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}" AutomationProperties.Name="Nombre de la tarifa"/>
         </Grid>
         <!-- Salas que la usan: solo si se han leido las salas (GET /organization); si no, no se dice nada. -->
         <StackPanel x:Name="TariffZonesArea" Visibility="{Binding Catalog.HasZoneInfo, Converter={StaticResource Bool2Vis}}">
          <TextBlock Text="Salas que la usan" Style="{StaticResource SectionGap}"/>
          <ItemsControl x:Name="TariffZoneChips" ItemsSource="{Binding Catalog.TariffZones}" Focusable="False" Margin="0,0,0,2">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ToneChip}" Tag="info" Margin="0,0,6,6" Padding="10,3,10,4"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="TariffZonesText" Text="{Binding Catalog.TariffZonesText}" Style="{StaticResource Body}"/>
         </StackPanel>
         <StackPanel Visibility="{Binding Catalog.NewTariff, Converter={StaticResource NotBool2Vis}}">
          <TextBlock Text="Precios" Style="{StaticResource SectionGap}"/>
          <UniformGrid Columns="2" Margin="0,0,-10,0">
           <Border Style="{StaticResource FigureBox}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="Con precio vigente" Style="{StaticResource FigureLabel}"/><TextBlock x:Name="TariffPricedFigure" Text="{Binding Catalog.TariffPricedFigure}" Style="{StaticResource FigureValue}"/></StackPanel>
           </Border>
           <Border Style="{StaticResource FigureBox}" Margin="0,0,10,0">
            <StackPanel><TextBlock Text="{Binding Catalog.TariffUnpricedLabel}" Style="{StaticResource FigureLabel}"/><TextBlock x:Name="TariffUnpricedFigure" Text="{Binding Catalog.TariffUnpricedFigure}" Style="{StaticResource FigureValue}"/></StackPanel>
           </Border>
          </UniformGrid>
          <TextBlock x:Name="TariffPricesText" Text="{Binding Catalog.TariffPricesText}" Style="{StaticResource Body}" Margin="2,10,0,0"/>
         </StackPanel>
         <TextBlock x:Name="TariffNoteText" Text="{Binding Catalog.TariffNote}" Style="{StaticResource FichaNote}"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Grid>
    </Border>
   </Grid>

   <!-- ======================= Impuestos ======================= -->
   <Grid x:Name="TaxesSection" Visibility="{Binding Catalog.ShowTaxes, Converter={StaticResource Bool2Vis}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource ListWidth}"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>
    <Border x:Name="TaxesPane" Style="{StaticResource ListPane}">
     <Grid>
      <StackPanel x:Name="TaxesEmpty" VerticalAlignment="Center" Margin="8,0,8,24" Visibility="{Binding Catalog.ShowTaxListEmpty, Converter={StaticResource Bool2Vis}}">
       <ContentControl Style="{StaticResource EmptyState}" local:Ui.Icon="{StaticResource IconCatalog}" local:Ui.Heading="Aún no hay impuestos"
                       Content="Cada producto lleva un impuesto (IVA 10 %, 21 %…). Crea el primero."/>
       <Button x:Name="EmptyNewTaxButton" Style="{StaticResource PageAction}" HorizontalAlignment="Center" Margin="0,14,0,0" Content="Nuevo impuesto" Command="{Binding Catalog.StartTaxCommand}"/>
      </StackPanel>
      <ListBox x:Name="TaxList" Style="{StaticResource CardRows}" ItemsSource="{Binding Catalog.TaxItems}" SelectedValuePath="Tax" SelectedValue="{Binding Catalog.SelectedTax}" AutomationProperties.Name="Impuestos"
               Visibility="{Binding Catalog.ShowTaxListEmpty, Converter={StaticResource NotBool2Vis}}">
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel AutomationProperties.Name="{Binding Tax.Name}">
         <StackPanel.Style>
          <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Inactive}" Value="True"><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/></DataTrigger></Style.Triggers></Style>
         </StackPanel.Style>
         <DockPanel>
          <Border DockPanel.Dock="Right" Style="{StaticResource ToneChip}" Margin="8,1,0,0" VerticalAlignment="Top" Visibility="{Binding Inactive, Converter={StaticResource Bool2Vis}}">
           <TextBlock Text="Desactivado"/>
          </Border>
          <TextBlock Text="{Binding Tax.Name}" Style="{StaticResource CardRowTitle}"/>
         </DockPanel>
         <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}" TextTrimming="None" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Border>

    <Border x:Name="TaxPanel" Grid.Column="2" Style="{StaticResource Ficha}" AutomationProperties.Name="{Binding Catalog.TaxFormTitle}">
     <Grid>
      <ContentControl x:Name="TaxEmpty" Style="{StaticResource FichaEmpty}" local:Ui.Icon="{StaticResource IconCatalog}"
                      local:Ui.Heading="{Binding Catalog.TaxEmptyHeading}" Content="{Binding Catalog.TaxEmptyText}" Visibility="{Binding Catalog.HasTaxContext, Converter={StaticResource NotBool2Vis}}"/>
      <DockPanel x:Name="TaxDetail" Visibility="{Binding Catalog.HasTaxContext, Converter={StaticResource Bool2Vis}}">
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="Impuesto" Style="{StaticResource FichaContext}"/>
        <WrapPanel Margin="0,2,0,0">
         <TextBlock x:Name="TaxTitleText" Text="{Binding Catalog.TaxTitle}" Style="{StaticResource FichaTitle}"/>
         <Border Style="{StaticResource FichaChip}" Tag="{Binding Catalog.TaxStateTone}" Visibility="{Binding Catalog.TaxStateText, Converter={StaticResource Text2Vis}}"><TextBlock Text="{Binding Catalog.TaxStateText}"/></Border>
        </WrapPanel>
       </StackPanel>
       <Border Style="{StaticResource FichaActions}">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button x:Name="SaveTaxButton" Style="{StaticResource BigAction}" Content="{Binding Catalog.TaxSaveText}" ContentTemplate="{StaticResource ButtonText}" Command="{Binding Catalog.SaveTaxCommand}"/>
         <Button x:Name="DeactivateTaxButton" Grid.Column="1" Style="{StaticResource FichaDanger}" Content="Desactivar impuesto" Command="{Binding Catalog.ToggleTaxCommand}"
                 Visibility="{Binding Catalog.TaxDeactivates, Converter={StaticResource Bool2Vis}}" ToolTip="No se borra y se puede reactivar"/>
         <Button x:Name="ReactivateTaxButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Reactivar impuesto" Command="{Binding Catalog.ToggleTaxCommand}"
                 Visibility="{Binding Catalog.TaxReactivates, Converter={StaticResource Bool2Vis}}"/>
         <Button x:Name="CancelTaxButton" Grid.Column="1" Style="{StaticResource FichaSecondary}" Content="Cancelar" Command="{Binding Catalog.CancelTaxCommand}"
                 Visibility="{Binding Catalog.NewTax, Converter={StaticResource Bool2Vis}}"/>
        </Grid>
       </Border>
       <ScrollViewer x:Name="TaxScroll" Style="{StaticResource FichaScroll}">
        <StackPanel>
         <TextBlock Text="Datos" Style="{StaticResource Section}"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/>
          <TextBlock Grid.Column="2" Text="Tipo (%)" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="1" Text="{Binding Catalog.TaxId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTax}" AutomationProperties.Name="Código del impuesto" ToolTip="Opcional: si lo dejas vacío se genera del nombre. Una vez creado no se puede cambiar."/>
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Catalog.TaxRate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}" TextAlignment="Right" AutomationProperties.Name="Tipo del impuesto en porcentaje"/>
          <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Nombre" Style="{StaticResource NextLabel}"/>
          <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Catalog.TaxName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}" AutomationProperties.Name="Nombre del impuesto"/>
         </Grid>
         <StackPanel Visibility="{Binding Catalog.NewTax, Converter={StaticResource NotBool2Vis}}">
          <TextBlock Text="Productos que lo llevan" Style="{StaticResource SectionGap}"/>
          <Border Style="{StaticResource FigureBox}" HorizontalAlignment="Left" MinWidth="200">
           <StackPanel><TextBlock Text="Productos" Style="{StaticResource FigureLabel}"/><TextBlock x:Name="TaxProductsFigure" Text="{Binding Catalog.TaxProductsFigure}" Style="{StaticResource FigureValue}"/></StackPanel>
          </Border>
          <TextBlock x:Name="TaxProductsText" Text="{Binding Catalog.TaxProductsText}" Style="{StaticResource Body}" Margin="2,10,0,0"/>
         </StackPanel>
         <TextBlock Text="Nada se borra: un impuesto desactivado deja de ofrecerse para productos nuevos y conserva su historia." Style="{StaticResource FichaNote}"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</UserControl>
