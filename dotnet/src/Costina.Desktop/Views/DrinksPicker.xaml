<UserControl x:Class="Costina.Desktop.Views.DrinksPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop" xmlns:views="clr-namespace:Costina.Desktop.Views">
 <!-- C3b (plan 2026-10-15, seccion 4.4; maqueta «5 · En el PC» y, para el selector, «2 · Bodega y bebidas»): «Añadir consumicion», el MISMO
      selector «Bodega y bebidas» del comandero, dentro de la ficha de la mesa. DataContext = DrinksViewModel (la logica sin WPF, comun con el
      comandero, esta en Costina.Client). Control propio para que Caja pueda adoptarlo mas adelante.
      - Arriba, el buscador (sin tildes ni mayusculas; nombre, referencia, familia y region; desde 2 letras) y los accesos: «Por copa» y una
        ficha por familia, con sus subfamilias; en la vista de entrada, «En esta mesa» para repetir con +1.
      - Una fila por producto: foto (o sus iniciales), nombre, familia › region y un boton por presentacion (la copa primero; con una sola,
        «Añadir»). SIN PRECIOS, tambien para el responsable. Un toque suma 1 a la ronda, para toda la mesa.
      - Abajo, la ronda (RoundTray) con «Enviar»: la unica orden. Las demas piezas solo filtran o cambian el borrador. -->
 <UserControl.Resources>
  <!-- Hueco de la foto: la miniatura (cargador del Catalogo) o, sin ella, las iniciales sobre verde claro. -->
  <DataTemplate x:Key="Photo">
   <Border Style="{StaticResource ImageWell}" Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
           CornerRadius="8" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Stroke}">
    <Grid>
     <TextBlock Text="{Binding Initials}" Foreground="{StaticResource AccentText}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding Thumbnail, Converter={StaticResource Null2Vis}}"/>
     <Border CornerRadius="7" Background="{StaticResource Surface}" Visibility="{Binding Thumbnail, Converter={StaticResource NotNull2Vis}}">
      <Border CornerRadius="7" Margin="2"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform"/></Border.Background></Border>
     </Border>
    </Grid>
   </Border>
  </DataTemplate>
  <!-- «En esta mesa»: tarjeta pulsable con foto, nombre, formato y «+1». -->
  <Style x:Key="RepeatTile" TargetType="Button">
   <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" CornerRadius="10" Padding="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" SnapsToDevicePixels="True">
       <ContentPresenter RecognizesAccessKey="False"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource InkDisabled}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>

 <Border x:Name="PickerFrame" Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="12">
  <DockPanel>
   <!-- Cabecera: que es, de que mesa, y cerrar (vuelven los pases, lo que lleva la mesa y la accion grande; la ronda sigue). -->
   <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" CornerRadius="11,11,0,0" Padding="12,6,6,6">
    <DockPanel>
     <Button x:Name="ClosePickerButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Command="{Binding CloseCommand}" Margin="0" Padding="6" VerticalAlignment="Center"
             ToolTip="Cerrar y volver a la ficha de la mesa (la ronda sigue)" AutomationProperties.Name="Cerrar «Añadir consumición»">
      <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
     </Button>
     <Path Style="{StaticResource Icon}" Data="{StaticResource IconGlass}" Stroke="{StaticResource AccentText}" Margin="0,0,8,0"/>
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="Añadir consumición" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource AccentText}" Margin="0,0,10,0"/>
      <TextBlock x:Name="PickerTitle" Text="{Binding Title}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
     </WrapPanel>
    </DockPanel>
   </Border>

   <!-- La ronda, abajo y siempre a la vista. -->
   <views:RoundTray x:Name="PickerRound" DockPanel.Dock="Bottom" Margin="10,6,10,10"/>

   <!-- Buscador y accesos. Las fichas de familia y de subfamilia van en una fila que se desplaza a lo ancho (con la rueda del raton). -->
   <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
    <Grid>
     <TextBox x:Name="DrinksSearch" Style="{StaticResource SearchField}" local:Ui.Hint="Busca un vino, una cerveza…" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
              MinHeight="38" FontSize="14" Margin="0,0,0,8" AutomationProperties.Name="Buscar en la bodega y bebidas por nombre, referencia, familia o región"/>
     <Button x:Name="ClearSearchButton" Style="{StaticResource Ghost}" Command="{Binding ClearQueryCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Padding="6,4"
             MinHeight="0" Visibility="{Binding Query, Converter={StaticResource Text2Vis}}" ToolTip="Borrar la búsqueda" AutomationProperties.Name="Borrar la búsqueda">
      <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClose}"/>
     </Button>
    </Grid>
    <ScrollViewer x:Name="ChipScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,0,8" PreviewMouseWheel="WheelSideways"
                  Visibility="{Binding HasChips, Converter={StaticResource Bool2Vis}}">
     <ItemsControl x:Name="ChipList" ItemsSource="{Binding Chips}" Focusable="False" AutomationProperties.Name="Tipos de bebida">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Style="{StaticResource ChipButton}" local:Ui.Current="{Binding IsCurrent}" Tag="{Binding Key}" Command="{Binding DataContext.PickChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Spoken}">
         <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconGlass}" Margin="0,0,5,0" Visibility="{Binding Glass, Converter={StaticResource Bool2Vis}}"/>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Count}" Foreground="{StaticResource InkSoft}" FontWeight="Normal" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
         </StackPanel>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <ScrollViewer x:Name="SubChipScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,0,8" PreviewMouseWheel="WheelSideways"
                  Visibility="{Binding HasSubChips, Converter={StaticResource Bool2Vis}}">
     <ItemsControl x:Name="SubChipList" ItemsSource="{Binding SubChips}" Focusable="False" AutomationProperties.Name="Subfamilias">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Style="{StaticResource SubChipButton}" local:Ui.Current="{Binding IsCurrent}" Command="{Binding DataContext.PickSubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"/>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </StackPanel>

   <!-- Resultados: el unico desplazamiento vertical del selector. -->
   <ScrollViewer x:Name="DrinksResults" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="10,2,14,4">
    <StackPanel>
     <ContentControl x:Name="DrinksNotice" Style="{StaticResource InfoBar}" Margin="0,0,0,10" Visibility="{Binding Notice, Converter={StaticResource Text2Vis}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/>
     </ContentControl>
     <TextBlock Text="{Binding Hint}" Style="{StaticResource Subtle}" Margin="0,0,0,8" Visibility="{Binding Hint, Converter={StaticResource Text2Vis}}"/>

     <StackPanel x:Name="RepeatBlock" Margin="0,0,0,8" Visibility="{Binding HasRepeats, Converter={StaticResource Bool2Vis}}">
      <WrapPanel Margin="0,0,0,6">
       <TextBlock Text="En esta mesa" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0"/>
       <TextBlock Text="Un toque y se repite: +1 para toda la mesa" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
      </WrapPanel>
      <ItemsControl x:Name="RepeatList" ItemsSource="{Binding Repeats}" Focusable="False" Margin="0,0,-8,0">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Style="{StaticResource RepeatTile}" Command="{Binding DataContext.RepeatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                 AutomationProperties.Name="{Binding Spoken}" ToolTip="{Binding Spoken}">
          <DockPanel>
           <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Photo}" Tag="32" Focusable="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
           <Border DockPanel.Dock="Right" CornerRadius="13" Background="{StaticResource AccentSoft}" Padding="7,3" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="+1" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentText}"/>
           </Border>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="11"/>
           </StackPanel>
          </DockPanel>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>

     <WrapPanel x:Name="ListHeader" Margin="0,0,0,8" Visibility="{Binding ListTitle, Converter={StaticResource Text2Vis}}">
      <TextBlock x:Name="ListTitleText" Text="{Binding ListTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,8,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="ListDetailText" Text="{Binding ListDetail}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
     </WrapPanel>
     <ItemsControl x:Name="DrinkRows" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Bodega y bebidas">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                AutomationProperties.Name="{Binding Name}">
         <DockPanel>
          <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Photo}" Tag="44" Focusable="False" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Choices}" Focusable="False" VerticalAlignment="Center">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Button Style="{StaticResource FormatButton}" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                     AutomationProperties.Name="{Binding Spoken}" ToolTip="{Binding Spoken}">
              <StackPanel>
               <TextBlock Text="{Binding Top}" HorizontalAlignment="Center" FontSize="13"/>
               <TextBlock Text="{Binding Bottom}" HorizontalAlignment="Center" FontSize="11" FontWeight="Normal" Visibility="{Binding HasBottom, Converter={StaticResource Bool2Vis}}"/>
              </StackPanel>
             </Button>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel VerticalAlignment="Center">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" Margin="0,1,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Bool2Vis}}"/>
           <StackPanel Orientation="Horizontal" Margin="0,2,0,0" TextElement.Foreground="{StaticResource AccentText}" Visibility="{Binding HasInRound, Converter={StaticResource Bool2Vis}}">
            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconCheck}" Margin="0,0,3,0"/>
            <TextBlock Text="{Binding InRoundText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
           </StackPanel>
          </StackPanel>
         </DockPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button x:Name="MoreRowsButton" Content="{Binding MoreText}" Command="{Binding ShowMoreCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
             Visibility="{Binding MoreText, Converter={StaticResource Text2Vis}}"/>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Border>
</UserControl>
