<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop">
 <!-- C1: componentes propios (Fluent WPF no trae tarjeta, aviso, chip ni barra lateral). Mismo lenguaje que el lienzo aprobado:
      tarjetas blancas de radio 12, avisos con icono Y texto (nunca solo color), estados en chip con su palabra. -->

 <!-- Icono de trazo: 20 x 20, trazo 1,75 con extremos redondos; toma el color del texto que lo rodea (TextElement.Foreground). -->
 <Style x:Key="Icon" TargetType="Path">
  <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="Stretch" Value="None"/>
  <Setter Property="StrokeThickness" Value="1.75"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
  <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="SnapsToDevicePixels" Value="False"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
 </Style>
 <!-- Icono pequeno (16 px) para avisos, barra de estado y botones compactos. -->
 <Style x:Key="IconSmall" TargetType="Path" BasedOn="{StaticResource Icon}">
  <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Setter.Value></Setter>
  <Setter Property="StrokeThickness" Value="2"/>
 </Style>

 <!-- Textos. Titulos con Segoe UI Variable Display; el cuerpo hereda Segoe UI Variable Text de la ventana. -->
 <Style x:Key="AppTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/>
 </Style>
 <Style x:Key="PageTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="PanelTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="Subtle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="Body" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <!-- Etiqueta de seccion: gris y seminegrita, en minusculas como Windows 11 (las versalitas no existen en Segoe UI Variable). -->
 <Style x:Key="Section" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="Margin" Value="0,0,0,4"/>
 </Style>
 <!-- Cabecera de una vista: titulo y, debajo, el resumen leido. -->
 <Style x:Key="PageHeader" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,14"/></Style>

 <!-- Tarjeta: blanca, radio 12, borde suave. Dos densidades y ninguna mas: Card (18) y CardDense (14, columnas de las vistas de gestion). -->
 <Style x:Key="Card" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/>
 </Style>
 <Style x:Key="CardDense" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14"/></Style>
 <!-- Ficha de formulario dentro de una tarjeta (sustituye al antiguo "Banner" usado como contenedor de formularios). -->
 <Style x:Key="FormPanel" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/>
 </Style>
 <!-- E3.2: hueco de una imagen (foto de la ficha de un articulo, miniatura de la lista): gris suave con borde y esquinas redondas;
      sin imagen muestra el icono IconImage y su texto, con imagen la foto lo tapa (fondo blanco detras de un PNG transparente). -->
 <Style x:Key="ImageWell" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
 </Style>
 <!-- Caja de icono (accesos, cabeceras): cuadrado suave con el icono en el color del acento. -->
 <Style x:Key="IconBox" TargetType="Border">
  <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="10"/>
  <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}"/>
 </Style>

 <!-- Avisos (InfoBar): icono, texto y, si hace falta, botones. Siempre con texto: el color solo acompana.
      Variantes: InfoBar (informacion), WarnBar (atencion), DangerBar (bloqueo o peligro), AllergyBar (alergias: rojo pleno). -->
 <Style x:Key="InfoBar" TargetType="ContentControl">
  <Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoLine}"/>
  <Setter Property="Foreground" Value="{StaticResource InfoText}"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconInfo}"/>
  <Setter Property="Padding" Value="12,8"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContentControl">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <DockPanel>
       <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"
             VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ContentPresenter VerticalAlignment="Center">
        <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
       </ContentPresenter>
      </DockPanel>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="WarnBar" TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
  <Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/>
  <Setter Property="Foreground" Value="{StaticResource WarnText}"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconAlert}"/>
 </Style>
 <Style x:Key="DangerBar" TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
  <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/>
  <Setter Property="Foreground" Value="{StaticResource DangerText}"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconAlert}"/>
 </Style>
 <Style x:Key="AllergyBar" TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
  <Setter Property="Background" Value="{StaticResource Danger}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
  <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconAlert}"/>
 </Style>
 <Style x:Key="OkBar" TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
  <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
  <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconCheck}"/>
 </Style>
 <!-- C2: nota neutra (Inicio: servidor, copia de seguridad hecha): blanca con borde suave y texto gris, para lo que no pide hacer nada. -->
 <Style x:Key="NoteBar" TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
 </Style>

 <!-- Chip de estado: palabra en una pastilla (Listo, Próximamente, Conectado...). El color acompana; la palabra manda. Va arriba, a la
      altura de la primera linea del titulo que acompana (un titulo de dos lineas no lo baja). -->
 <Style x:Key="StateChip" TargetType="Border">
  <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="8,1,0,0"/>
  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{StaticResource Surface2}"/>
  <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/><Setter Property="TextElement.FontSize" Value="11"/>
  <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="ChipAccent" TargetType="Border" BasedOn="{StaticResource StateChip}">
  <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}"/>
 </Style>
 <Style x:Key="ChipWarn" TargetType="Border" BasedOn="{StaticResource StateChip}">
  <Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarnText}"/>
 </Style>
 <Style x:Key="ChipDanger" TargetType="Border" BasedOn="{StaticResource StateChip}">
  <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/>
 </Style>
 <Style x:Key="ChipInfo" TargetType="Border" BasedOn="{StaticResource StateChip}">
  <Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource InfoText}"/>
 </Style>

 <!-- C2: chip del estado de una mesa del plano o de un pase. Tag = tono: el de la mesa (codigos de FloorPlan: free, seated, kitchen,
      ready, eating, paused, finished, cancelled) o el de un pase (done, pending, choose); cualquier otro valor (un estado nuevo del
      servidor, que sale tal cual) queda neutro. La palabra va siempre dentro: el color solo acompana. -->
 <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource StateChip}">
  <Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,2,8,3"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Style.Triggers>
   <Trigger Property="Tag" Value="free"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/></Trigger>
   <Trigger Property="Tag" Value="pending"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/></Trigger>
   <Trigger Property="Tag" Value="seated"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource InfoText}"/></Trigger>
   <Trigger Property="Tag" Value="choose"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource InfoText}"/></Trigger>
   <Trigger Property="Tag" Value="kitchen"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarnText}"/></Trigger>
   <!-- Listo para servir: relleno OkText (#17744A) y no Ok, para que el texto blanco pequeno se lea (5,8:1 frente a 4,1:1). -->
   <Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource OkText}"/><Setter Property="BorderBrush" Value="{StaticResource OkText}"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger>
   <Trigger Property="Tag" Value="eating"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}"/></Trigger>
   <Trigger Property="Tag" Value="done"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}"/></Trigger>
   <Trigger Property="Tag" Value="paused"><Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/></Trigger>
   <Trigger Property="Tag" Value="finished"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
   <Trigger Property="Tag" Value="cancelled"><Setter Property="Background" Value="{StaticResource Surface}"/></Trigger>
   <!-- C2b: tonos genericos de las vistas de gestion (cobertura de una cuenta, activo / desactivado...): ok, warn, info y danger. -->
   <Trigger Property="Tag" Value="ok"><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource AccentText}"/></Trigger>
   <Trigger Property="Tag" Value="warn"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarnText}"/></Trigger>
   <Trigger Property="Tag" Value="info"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource InfoText}"/></Trigger>
   <Trigger Property="Tag" Value="danger"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/></Trigger>
  </Style.Triggers>
 </Style>
 <!-- C2: numero de un pase en la ficha (circulo) y tramo de la barra de avance de una mesa; mismo tono que su chip (Tag). -->
 <Style x:Key="StepDot" TargetType="Border">
  <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/><Setter Property="TextElement.FontSize" Value="12"/><Setter Property="TextElement.FontWeight" Value="Bold"/>
  <Style.Triggers>
   <Trigger Property="Tag" Value="done"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger>
   <Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource OkText}"/><Setter Property="BorderBrush" Value="{StaticResource OkText}"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/></Trigger>
   <Trigger Property="Tag" Value="kitchen"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarnText}"/></Trigger>
   <Trigger Property="Tag" Value="choose"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource InfoText}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StepBar" TargetType="Border">
  <Setter Property="Height" Value="5"/><Setter Property="CornerRadius" Value="2.5"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="Background" Value="{StaticResource Stroke}"/>
  <!-- Solo lo hecho (servido u omitido) va en verde intenso: un pase listo para servir aun no esta hecho y va en verde claro (con el
       verde intenso la barra contradecia su cifra "0 de 3"). -->
  <Style.Triggers>
   <Trigger Property="Tag" Value="done"><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger>
   <Trigger Property="Tag" Value="ready"><Setter Property="Background" Value="{StaticResource AccentLine}"/></Trigger>
   <Trigger Property="Tag" Value="kitchen"><Setter Property="Background" Value="{StaticResource Warn}"/></Trigger>
  </Style.Triggers>
 </Style>

 <!-- C2: pestanas segmentadas (salas del comedor): una lista horizontal con la elegida en blanco y en negrita sobre un fondo gris. La
      elegida la marca el elemento (IsCurrent del viewmodel), no la seleccion de la lista: esta se pierde al rehacer las pestanas. -->
 <Style x:Key="Segmented" TargetType="ListBox">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListBox">
     <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3"><ItemsPresenter/></Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ListBoxItem">
     <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
     <Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bd" CornerRadius="8" Padding="12,5" Background="Transparent" SnapsToDevicePixels="True"><ContentPresenter RecognizesAccessKey="False"/></Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
         <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.14" BlurRadius="3"/></Setter.Value></Setter>
         </DataTrigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- C2: filtros en pastilla (Todas, Ocupadas, En cocina...): el elegido con borde y fondo de acento, y su numero en el texto. -->
 <Style x:Key="FilterChips" TargetType="ListBox">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ListBoxItem">
     <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
     <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,6"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bd" CornerRadius="15" MinHeight="30" Padding="13,4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" SnapsToDevicePixels="True">
         <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/></Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
          <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="FontWeight" Value="SemiBold"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Punto de estado (barra de estado, dispositivos): el color sale de la palabra en Tag (ok, warn, danger, off); al lado va el texto. -->
 <Style x:Key="Dot" TargetType="Ellipse">
  <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Fill" Value="{StaticResource StrokeStrong}"/>
  <Style.Triggers>
   <Trigger Property="Tag" Value="ok"><Setter Property="Fill" Value="{StaticResource Ok}"/></Trigger>
   <Trigger Property="Tag" Value="warn"><Setter Property="Fill" Value="{StaticResource Warn}"/></Trigger>
   <Trigger Property="Tag" Value="danger"><Setter Property="Fill" Value="{StaticResource Danger}"/></Trigger>
  </Style.Triggers>
 </Style>

 <!-- Cifra (KPI): tarjeta con etiqueta e importe grande (C2: las cuatro cifras del comedor en Inicio). -->
 <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="18,16"/></Style>
 <Style x:Key="KpiDanger" TargetType="Border" BasedOn="{StaticResource Kpi}">
  <Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerLine}"/>
  <Setter Property="TextElement.Foreground" Value="{StaticResource DangerText}"/>
 </Style>
 <Style x:Key="KpiLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/><Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="KpiValue" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,4,0,0"/>
 </Style>

 <!-- Barra lateral. El resaltado sigue a la vista ABIERTA (CurrentView del cascaron), no al boton pulsado: pedir Caja en el nivel
      Puesto abre la entrada del responsable y deja Inicio resaltado. Plegada (Ui.Compact, heredada de la barra) solo quedan iconos. -->
 <Style x:Key="NavSection" TargetType="TextBlock" BasedOn="{StaticResource Section}">
  <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="10,14,0,4"/>
  <Style.Triggers><Trigger Property="local:Ui.Compact" Value="True"><Setter Property="Visibility" Value="Hidden"/><Setter Property="Height" Value="6"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="NavItem" TargetType="Button">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="Cursor" Value="Hand"/>
  <!-- La ayuda repite el nombre: solo hace falta plegada (sin texto) o deshabilitada (explica "Próximamente"). -->
  <Setter Property="ToolTipService.InitialShowDelay" Value="400"/><Setter Property="ToolTipService.IsEnabled" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <Grid>
       <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-10,0,0,0" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Hidden"/>
       <StackPanel Orientation="Horizontal">
        <Path Style="{StaticResource Icon}" Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
       </StackPanel>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
      <Trigger Property="local:Ui.Current" Value="True">
       <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
       <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
      <Trigger Property="local:Ui.Compact" Value="True"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8A9099"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="local:Ui.Compact" Value="True"><Setter Property="ToolTipService.IsEnabled" Value="True"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTipService.IsEnabled" Value="True"/></Trigger>
   <DataTrigger Value="True">
    <DataTrigger.Binding><MultiBinding Converter="{StaticResource SameView}"><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/><Binding Path="CurrentView"/></MultiBinding></DataTrigger.Binding>
    <Setter Property="local:Ui.Current" Value="True"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>

 <!-- Acceso grande (Inicio): tarjeta pulsable con icono, titulo y una linea de ayuda (Ui.Hint). -->
 <Style x:Key="ShortcutTile" TargetType="Button">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="16,14"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <DockPanel>
       <Border x:Name="Box" DockPanel.Dock="Left" Style="{StaticResource IconBox}" VerticalAlignment="Top" Margin="0,0,14,0">
        <Path Style="{StaticResource Icon}" Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center"/>
       </Border>
       <StackPanel VerticalAlignment="Top" Margin="0,1,0,0">
        <ContentPresenter RecognizesAccessKey="False" TextElement.FontWeight="SemiBold" TextElement.FontSize="15"/>
        <TextBlock Text="{Binding (local:Ui.Hint), RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentLine}"/><Setter TargetName="Bd" Property="Background" Value="#FAFCFB"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>
      <Trigger Property="Tag" Value="primary">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="TextElement.Foreground" Value="#FFFFFF"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Acceso principal (Comedor y cocina): la caja del icono en acento. -->
 <Style x:Key="ShortcutTilePrimary" TargetType="Button" BasedOn="{StaticResource ShortcutTile}"><Setter Property="Tag" Value="primary"/></Style>

 <!-- Boton de alta en la cabecera de una lista ("＋ Mesa", "＋ Producto"...): compacto para caber junto al titulo. -->
 <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Padding" Value="8,2,10,3"/><Setter Property="MinHeight" Value="28"/>
  <Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <!-- Boton compacto de la barra superior (Entrar como responsable / Salir del modo responsable). -->
 <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Padding" Value="10,3,12,4"/><Setter Property="MinHeight" Value="28"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>

 <!-- Numero de paso (Primeros pasos): circulo con el numero; el paso actual en acento, el siguiente en contorno. -->
 <Style x:Key="StepNumber" TargetType="Border">
  <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/>
  <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
  <Setter Property="TextElement.FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Top"/>
 </Style>
 <Style x:Key="StepNumberNext" TargetType="Border" BasedOn="{StaticResource StepNumber}">
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
  <Setter Property="BorderThickness" Value="1.5"/><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
 </Style>

 <!-- ===== C2b (plan 2026-10-14): patron comun de las vistas de gestion, el del Comedor de C2 =====
      Una vista de gestion se compone asi (CheckoutView es la primera que lo usa):
      - Cabecera de pagina sobre el fondo gris: PageBar (DockPanel) con, a la derecha, PageAction (la accion principal, icono en Ui.Icon)
        o PageNote (una nota neutra cuando la vista no crea nada), y el titulo (PageTitle) con su resumen de una linea (PageSummary).
      - Lista a la izquierda: ListPane (tarjeta blanca) con SearchField (lupa y texto de ayuda en Ui.Hint), FilterChips si ayudan y la lista:
        PaneList (filas de dos lineas, RowTitle y RowDetail, seleccion con fondo de acento y barra) o CardRows (filas en tarjeta gris; la
        elegida, blanca con borde de acento, como los pases de la ficha del Comedor). Las dos virtualizan y son el UNICO desplazamiento de
        su columna. Una lista vacia es un EmptyState (icono, titulo en Ui.Heading y la explicacion en Content) con su boton de crear debajo.
      - Ficha a la derecha: Ficha (tarjeta, ancho fijo de unos 400 px o flexible segun el plan) con FichaContext, FichaTitle y un ToneChip
        con la palabra del estado arriba; FichaScroll (el unico desplazamiento de la columna) con secciones (Section / SectionGap), campos con
        FieldLabel y cifras (FigureBox); y FichaActions abajo, fijo, con los botones (BigAction, el grande). Sin nada elegido, la ficha es un
        EmptyState que dice que elegir y no muestra campos.
      - Pestanas internas con Segmented (lo elegido sale de IsCurrent del elemento, ver SegmentChoice) y tablas ligeras sin desplazamiento
        propio con TableHead y TableRow, o TableList si la fila se elige (la ficha ya desplaza). Ningun desplazamiento anidado.
      - LinkButton para un enlace de texto junto a un recuento ("Ver todos" del Catalogo). -->

 <Style x:Key="PageBar" TargetType="DockPanel"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="LastChildFill" Value="True"/></Style>
 <Style x:Key="PageSummary" TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="Margin" Value="0,2,0,0"/></Style>
 <!-- Accion principal de la cabecera ("Abrir mesa", "Producto"...): verde, con su icono (Ui.Icon; por defecto, el mas). -->
 <Style x:Key="PageAction" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Setter Property="DockPanel.Dock" Value="Right"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,0,16,0"/>
  <Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="local:Ui.Icon" Value="{StaticResource IconPlus}"/>
  <Setter Property="ContentTemplate">
   <Setter.Value>
    <DataTemplate>
     <StackPanel Orientation="Horizontal">
      <Path Style="{StaticResource Icon}" Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
      <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
     </StackPanel>
    </DataTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Nota de la cabecera en lugar de una accion (Caja: "registro operativo de ensayo"): neutra, con icono y texto que se parte. -->
 <Style x:Key="PageNote" TargetType="ContentControl" BasedOn="{StaticResource NoteBar}">
  <Setter Property="DockPanel.Dock" Value="Right"/><Setter Property="MaxWidth" Value="430"/><Setter Property="Margin" Value="16,0,0,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="12"/>
 </Style>

 <!-- Buscador: campo con lupa y texto de ayuda (Ui.Hint) mientras esta vacio; el borde se pone de acento con el foco. -->
 <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,10"/>
  <!-- Sin el relleno de Fluent: el texto escrito empieza donde el de ayuda (la plantilla ya deja el sitio de la lupa). -->
  <Setter Property="Padding" Value="0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconSearch}" Stroke="{StaticResource InkSoft}" Margin="10,0,6,0"/>
       <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding local:Ui.Hint}" Foreground="{StaticResource InkDisabled}" VerticalAlignment="Center" Margin="2,0,8,0"
                  TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
       <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False"
                     HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#B8BEC6"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="{StaticResource FillDisabled}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Columna de lista: tarjeta blanca algo mas densa que la ficha. -->
 <Style x:Key="ListPane" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/></Style>
 <!-- Lista larga (catalogo...): sin borde ni fondo propios dentro de su ListPane; filas de dos lineas con la fila comun (Controls.xaml),
      con margen derecho para la barra de desplazamiento de Fluent, que se superpone (no tapa el precio ni el final de la fila). -->
 <Style x:Key="PaneList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
  <Setter Property="ItemContainerStyle">
   <Setter.Value><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,1,10,1"/></Style></Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style x:Key="RowDetail" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="0,1,0,0"/>
 </Style>
 <!-- Lista de pocas filas ricas (cuentas abiertas, salas...): cada fila es una tarjeta gris; al pasar el raton, borde; la elegida, blanca con
      borde de acento (como los pases de la ficha del Comedor). Margen derecho para la barra de desplazamiento de Fluent, que se superpone. -->
 <Style x:Key="CardRows" TargetType="ListBox" BasedOn="{StaticResource PaneList}">
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ListBoxItem">
     <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
     <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Cursor" Value="Hand"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bd" CornerRadius="10" Padding="12,10" Background="{StaticResource Surface2}" BorderBrush="Transparent" BorderThickness="1.5" SnapsToDevicePixels="True">
         <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/></Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Vacio explicado (lista vacia, ficha sin nada elegido): icono en su caja, titulo (Ui.Heading) y la explicacion (Content, texto que se
      parte). Los botones (crear, ir a otra vista) van debajo, en la vista. -->
 <Style x:Key="EmptyState" TargetType="ContentControl">
  <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="MaxWidth" Value="300"/>
  <Setter Property="local:Ui.Icon" Value="{StaticResource IconInfo}"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContentControl">
     <StackPanel>
      <Border Style="{StaticResource IconBox}" HorizontalAlignment="Center">
       <Path Style="{StaticResource Icon}" Data="{Binding (local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock Text="{Binding (local:Ui.Heading), RelativeSource={RelativeSource TemplatedParent}}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                 Visibility="{Binding (local:Ui.Heading), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Text2Vis}}"/>
      <ContentPresenter Margin="0,6,0,0"/>
     </StackPanel>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Ficha: tarjeta con el encabezado arriba (contexto, nombre y estado con palabra), las secciones en FichaScroll y los botones abajo. -->
 <Style x:Key="Ficha" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="18,16"/></Style>
 <Style x:Key="FichaContext" TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
 <Style x:Key="FichaTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}"><Setter Property="FontSize" Value="22"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
 <!-- Chip de estado junto al nombre de la ficha: a la altura de su primera linea. -->
 <Style x:Key="FichaChip" TargetType="Border" BasedOn="{StaticResource ToneChip}"><Setter Property="Margin" Value="0,5,6,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
 <!-- Unico desplazamiento de la columna de la ficha; el margen deja sitio a la barra de Fluent, que se superpone. -->
 <Style x:Key="FichaScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="Padding" Value="0,0,12,0"/><Setter Property="Margin" Value="0,0,-8,0"/>
 </Style>
 <!-- Botones de la ficha, abajo y siempre a la vista, separados por una linea. -->
 <Style x:Key="FichaActions" TargetType="Border">
  <Setter Property="DockPanel.Dock" Value="Bottom"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="0,1,0,0"/>
  <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Padding" Value="0,12,0,0"/>
 </Style>
 <!-- Seccion que sigue a otra dentro de la ficha. -->
 <Style x:Key="SectionGap" TargetType="TextBlock" BasedOn="{StaticResource Section}"><Setter Property="Margin" Value="0,18,0,8"/></Style>
 <!-- Cifra de una ficha (Total, Pagado...): etiqueta y valor en una caja gris; FigureBoxStrong resalta la que manda (Pendiente). -->
 <Style x:Key="FigureBox" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,9,14,10"/>
 </Style>
 <Style x:Key="FigureBoxStrong" TargetType="Border" BasedOn="{StaticResource FigureBox}">
  <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentLine}"/>
 </Style>
 <Style x:Key="FigureLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Style>
 <Style x:Key="FigureValue" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,1,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="FigureValueStrong" TargetType="TextBlock" BasedOn="{StaticResource FigureValue}">
  <Setter Property="FontSize" Value="26"/><Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="Margin" Value="0,-2,0,-2"/>
 </Style>
 <!-- Tabla ligera (consumos de una cuenta...): cabecera gris y filas con una linea debajo; sin desplazamiento propio (la ficha desplaza). -->
 <Style x:Key="TableHead" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,6"/>
  <Setter Property="TextElement.FontSize" Value="12"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/><Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
 </Style>
 <Style x:Key="TableRow" TargetType="Border">
  <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,8"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>
 <!-- Tabla ligera con fila elegible (presentaciones de un producto...): las filas de TableRow; al pasar el raton, sombreada; la elegida, con
      fondo de acento y la barra de la izquierda, como las listas. Sin desplazamiento propio: la rueda del raton mueve la ficha. -->
 <Style x:Key="TableList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle">
   <Setter.Value>
    <Style TargetType="ListBoxItem">
     <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
     <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="10,8" SnapsToDevicePixels="True">
         <Grid>
          <Border x:Name="Pill" Width="3" CornerRadius="1.5" Margin="-9,1,0,1" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed"/>
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/></Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Enlace de texto ("Ver todos"): sin fondo ni borde, en el verde del acento y subrayado al pasar el raton; deshabilitado, gris. -->
 <Style x:Key="LinkButton" TargetType="Button">
  <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
  <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4,2"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border Background="Transparent" Padding="{TemplateBinding Padding}">
      <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource InkDisabled}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Accion grande de una ficha (C2, antes en ServiceView). Sin accion anunciada queda deshabilitada (relleno gris, como cualquier boton
      deshabilitado) y su texto dice que se espera ("Esperando la revision de cocina"): ese texto va en gris oscuro (InkSoft) y no en el gris
      claro de los deshabilitados (3:1), porque es la linea mas util de la ficha. -->
 <Style x:Key="BigAction" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Style.Resources><SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#5A616B"/></Style.Resources>
  <Setter Property="MinHeight" Value="46"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
 </Style>
 <!-- Texto de un boton que puede partirse (C2, antes en ServiceView). Va en ContentTemplate (no como TextBlock hijo): asi hereda el color
      que la plantilla Fluent pone segun el estado y un boton deshabilitado se ve gris (un hijo logico heredaria el blanco del boton de acento). -->
 <DataTemplate x:Key="ButtonText"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
</ResourceDictionary>
