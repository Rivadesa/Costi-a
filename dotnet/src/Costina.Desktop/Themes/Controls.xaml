<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- C1: estilos de los controles sobre Fluent. TODO estilo implicito va BasedOn el de Fluent ({StaticResource {x:Type X}} resuelve al
      de Fluent.Light.xaml, combinado antes): sin BasedOn el control cae al aspecto clasico Aero2 y queda un hibrido. Solo se
      re-plantilla lo que Fluent fija a mano (menu de primer nivel, celda de la tabla, fila de lista con texto que se parte). -->

 <!-- Botones. Un Background suelto se pierde al pasar el raton (las plantillas Fluent leen claves fijas): las variantes cambian
      esas claves en Style.Resources. El margen por defecto es el de siempre (las vistas cuentan con el en sus filas de botones). -->
 <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <!-- Accion principal: el boton de acento de Fluent (verde, texto blanco, estados coherentes). -->
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
  <Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <!-- Peligro (irreversible o desactivar): contorno rojo; el relleno rojo queda para la confirmacion final (DangerFilled). -->
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Style.Resources>
   <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FDECEA"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FAD9D5"/>
   <SolidColorBrush x:Key="ButtonForeground" Color="#A3231A"/>
   <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#A3231A"/>
   <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8A1D16"/>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="#F0B8B1"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E39A91"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#E39A91"/>
  </Style.Resources>
  <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
  <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
 </Style>
 <Style x:Key="DangerFilled" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Style.Resources>
   <SolidColorBrush x:Key="ButtonBackground" Color="#B42318"/>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C4321F"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#912018"/>
   <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2FFFFFF"/>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="#912018"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#912018"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#912018"/>
  </Style.Resources>
  <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
  <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
 </Style>
 <!-- Secundario discreto (cerrar, seguir, desconectar): sin fondo ni borde hasta pasar el raton. -->
 <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Style.Resources>
   <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0D000000"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14000000"/>
   <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
   <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>
  </Style.Resources>
  <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
 </Style>

 <!-- Casillas: Fluent les pone 120 px de ancho minimo (pensado para tactil); aqui van en filas densas (dias de la semana). -->
 <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="MinWidth" Value="0"/></Style>
 <!-- Celda de tabla cuyo texto puede ser largo (restricciones, revision): se parte en vez de cortarse. -->
 <Style x:Key="WrapCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>

 <!-- Listas: fondo blanco (Fluent las pinta grises) y filas compactas. La fila se re-plantilla solo para que el texto largo se parta
      (la plantilla Fluent no lo hace) y para marcar la seleccion con fondo suave y barra de acento, como la barra lateral. -->
 <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
  <Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <Grid>
       <Border x:Name="Pill" Width="3" CornerRadius="1.5" Margin="-8,2,0,2" HorizontalAlignment="Left" Background="{StaticResource Accent}" Visibility="Collapsed"/>
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
        <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
       </ContentPresenter>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
       <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource InkSoft}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- Tablas de solo lectura, densas (celda de 30 px en vez de 32; Fluent fija el minimo dentro de su estilo de DataGrid). La celda
      Fluent deja el texto pegado arriba y al borde: se re-plantilla con margen y centrado vertical. -->
 <Style x:Key="GridCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
  <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,4"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Border x:Name="Cell" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
  <Setter Property="Background" Value="{StaticResource Surface2}"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
  <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="32"/>
 </Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="RowBackground" Value="Transparent"/>
  <Setter Property="CellStyle" Value="{StaticResource GridCell}"/><Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
 </Style>

 <!-- Barra de menus clasica compacta: la cabecera de primer nivel de Fluent tiene margenes fijos (4 + 10, 46-49 px). Se re-plantillan
      SOLO los dos roles de primer nivel (con y sin submenu; sin el segundo, una entrada sin hijos estiraria la barra); los submenus
      siguen siendo los de Fluent. -->
 <ControlTemplate x:Key="TopLevelMenuItem" TargetType="MenuItem">
  <Grid SnapsToDevicePixels="True">
   <Border x:Name="Bd" Margin="2,3" Padding="10,4" CornerRadius="4" Background="Transparent">
    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
   </Border>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" HorizontalOffset="-10" VerticalOffset="1"
          AllowsTransparency="True" Focusable="False" PopupAnimation="None">
    <Border Margin="12,0,12,18" Padding="0,3" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}">
     <Border.Effect><DropShadowEffect ShadowDepth="6" Direction="270" Opacity="0.22" BlurRadius="20"/></Border.Effect>
     <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/></ScrollViewer>
    </Border>
   </Popup>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
   <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
  <Style.Triggers>
   <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource TopLevelMenuItem}"/></Trigger>
   <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Template" Value="{StaticResource TopLevelMenuItem}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <!-- Ayudas y menus contextuales viven en su propia ventana emergente: no heredan la letra de la ventana (Fluent deja la del sistema). -->
 <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="13"/>
 </Style>
 <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="14"/>
 </Style>

 <!-- Barra de estado: fina (Fluent mide 50 px) y con la letra de la aplicacion (Aero2 la dejaria en Segoe UI 12). -->
 <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
  <Setter Property="Background" Value="{StaticResource Chrome}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="10,1"/>
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
 </Style>

 <!-- Area de trabajo: el TabControl solo cambia de vista (cabeceras sin pintar); sin fondo, borde ni relleno. -->
 <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
 </Style>
</ResourceDictionary>
