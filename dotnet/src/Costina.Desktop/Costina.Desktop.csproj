<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><Version>0.37.1-c2.1</Version>
    <AssemblyName>Costina.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Costina.Client/Costina.Client.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- D6.5: matriz del QR de emparejamiento (QRCoder, MIT). Se pinta con PngByteQRCode: no se usa System.Drawing. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- E3.2: los checks del WPF conectan la ventana a un servidor simulado en memoria (ShellViewModel.Api con un HttpMessageHandler
         propio) para probar las ordenes y las imagenes por la tuberia real, sin red. -->
    <InternalsVisibleTo Include="Costina.DesktopChecks" />
  </ItemGroup>
</Project>
