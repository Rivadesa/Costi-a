<Window x:Class="Costina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Costiña · Windows nativo · D4.3" Width="1240" Height="840" MinWidth="1040" MinHeight="700" Background="#F4F5F7" Closing="WindowClosing">
<Window.Resources><BooleanToVisibilityConverter x:Key="Bool2Vis"/></Window.Resources>
<DockPanel Margin="22">
 <StackPanel DockPanel.Dock="Top">
  <TextBlock Text="COSTIÑA  /  CONTROL DEL RESTAURANTE" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="0.20.0-d6.1 · WPF MVVM · Ensayo con servidor local real · No usar con datos de clientes" Margin="0,5,0,14"/>
  <WrapPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Servidor de ensayo"/><TextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="220"/></StackPanel>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Usuario"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="140"/></StackPanel>
   <StackPanel Margin="0,0,8,0"><TextBlock Text="Contraseña"/><PasswordBox x:Name="AccessKey" IsEnabled="{Binding ConnectEnabled}" Width="180" Height="36" Padding="8"/></StackPanel>
   <Button x:Name="ConnectButton" Content="Entrar" IsEnabled="{Binding ConnectEnabled}" Click="ConnectClick" VerticalAlignment="Bottom"/>
   <Button Content="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}" VerticalAlignment="Bottom"/>
   <Button x:Name="DisconnectButton" Content="Desconectar" Command="{Binding DisconnectCommand}" VerticalAlignment="Bottom"/>
   <Button x:Name="RefreshButton" Content="Actualizar" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/>
  </WrapPanel>
  <WrapPanel Margin="0,6,0,0" Visibility="{Binding ConnectEnabled, Converter={StaticResource Bool2Vis}}">
   <TextBlock Text="Emparejar este puesto:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox x:Name="PairCode" Width="330" ToolTip="Código de un solo uso generado por el administrador (pestaña Puestos del PC principal)"/>
   <TextBox Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,8,0" ToolTip="Nombre de este puesto (p. ej. tablet-sala-1)"/>
   <Button Content="Solicitar emparejamiento" Command="{Binding PairDeviceCommand}" CommandParameter="{Binding Text, ElementName=PairCode}"/>
   <TextBlock Text="{Binding PairingStatus}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
  </WrapPanel>
  <Border Background="#E6EBF1" Padding="10" Margin="0,10,0,6"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
  <Border Background="#FFF0CE" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasPending, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Reintentar la misma orden" Command="{Binding RetryCommand}"/>
   <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
  <Border Background="#F6D5D5" Padding="8" Margin="0,0,0,8" Visibility="{Binding HasBlocked, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Consultar al servidor" Command="{Binding ReconcileCommand}"/>
    <Button Content="Descartar conservando evidencia" Command="{Binding DiscardCommand}"/>
   </StackPanel>
   <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </StackPanel>
 <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
  <TextBlock Text="{Binding RealtimeState}"/>
  <TextBlock Text="{Binding ReadTime}"/>
 </StackPanel>
 <TabControl x:Name="Tabs" IsEnabled="{Binding TabsEnabled}" SelectionChanged="TabChanged">
  <TabItem Header="  Comedor y cocina  " x:Name="ServiceTab">
   <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
     <StackPanel DockPanel.Dock="Top" Visibility="{Binding CanOpen, Converter={StaticResource Bool2Vis}}">
      <TextBlock Text="ABRIR MESA" FontWeight="Bold" Margin="0,0,0,8"/>
      <ComboBox ItemsSource="{Binding Service.Tables}" SelectedItem="{Binding Service.SelectedTable}" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding Service.Menus}" SelectedItem="{Binding Service.SelectedMenu}" Margin="0,0,0,6"/>
      <WrapPanel><TextBlock Text="Personas " VerticalAlignment="Center"/><TextBox Text="{Binding Service.Pax, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
       <Button Content="Abrir" Command="{Binding Service.OpenCommand}"/></WrapPanel>
      <TextBlock Text="MESAS OCUPADAS" Margin="0,18,0,8" FontWeight="Bold"/>
     </StackPanel>
     <ListBox ItemsSource="{Binding Service.Board}" SelectedItem="{Binding Service.SelectedEntry}" BorderThickness="0"/>
    </DockPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0"><TextBlock Text="{Binding Service.ServiceTitle}" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Seguimiento operativo. Sin precios, cuenta ni pagos." Margin="0,5,0,8"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,0,0,6">
      <Border Background="#7A1F1F" Padding="8" Margin="0,0,0,6" Visibility="{Binding Service.RestrictionsPendingAck, Converter={StaticResource Bool2Vis}}">
       <TextBlock Foreground="White" FontWeight="Bold" TextWrapping="Wrap"
        Text="⚠ CAMBIO DE RESTRICCIONES SIN REVISAR POR COCINA — cada elaboración marcada PENDIENTE DE REVISIÓN exige una decisión (no afecta / adaptar / rehacer) antes de validar, servir o disparar."/>
      </Border>
      <WrapPanel>
       <TextBlock Text="RESTRICCIONES" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ListBox ItemsSource="{Binding Service.Restrictions}" SelectedItem="{Binding Service.SelectedRestriction}"
        BorderThickness="0" MaxHeight="52" MinWidth="330"/>
       <TextBox Text="{Binding Service.RestrictionGuest, UpdateSourceTrigger=PropertyChanged}" Width="44" ToolTip="Comensal (vacío = toda la mesa)"/>
       <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding Service.RestrictionKind}">
        <ComboBoxItem Tag="allergy" IsSelected="True">Alergia</ComboBoxItem><ComboBoxItem Tag="intolerance">Intolerancia</ComboBoxItem><ComboBoxItem Tag="preference">Preferencia</ComboBoxItem>
       </ComboBox>
       <TextBox Text="{Binding Service.RestrictionSubstance, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Sustancia o preferencia"/>
       <ComboBox Width="105" SelectedValuePath="Tag" SelectedValue="{Binding Service.RestrictionSeverity}">
        <ComboBoxItem Tag="severe" IsSelected="True">Grave</ComboBoxItem><ComboBoxItem Tag="moderate">Moderada</ComboBoxItem><ComboBoxItem Tag="mild">Leve</ComboBoxItem>
       </ComboBox>
       <Button Content="Declarar" Command="{Binding Service.DeclareRestrictionCommand}"/>
       <Button Content="Retirar con motivo" Command="{Binding Service.RemoveRestrictionCommand}"/>
      </WrapPanel>
     </StackPanel>
     <WrapPanel Grid.Row="2">
      <Button Content="Iniciar servicio" Command="{Binding Service.ActCommand}" CommandParameter="start"/>
      <Button Content="Enviar siguiente pase" Command="{Binding Service.ActCommand}" CommandParameter="fire-next"/>
      <Button Content="Marcar servido" Command="{Binding Service.ActCommand}" CommandParameter="serve"/>
      <Button Content="Pausar" Command="{Binding Service.ActCommand}" CommandParameter="pause"/>
      <Button Content="Reanudar" Command="{Binding Service.ActCommand}" CommandParameter="resume"/>
     </WrapPanel>
     <DataGrid Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" ItemsSource="{Binding Service.Courses}" SelectedItem="{Binding Service.SelectedCourse}"><DataGrid.Columns>
      <DataGridTextColumn Header="Pase" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="145"/>
      <DataGridTextColumn Header="Servido" Binding="{Binding ServedAt, StringFormat=HH:mm:ss}" Width="115"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="4" Visibility="{Binding IsKitchen, Converter={StaticResource Bool2Vis}}">
      <TextBlock Text="COCINA / PASE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
      <Button Content="Iniciar elaboración" Command="{Binding Service.ActCommand}" CommandParameter="preparation-start"/>
      <Button Content="Elaboración lista" Command="{Binding Service.ActCommand}" CommandParameter="preparation-ready"/>
      <Button Content="Validar pase listo" Command="{Binding Service.ActCommand}" CommandParameter="ready"/>
      <TextBlock Text="  REVISIÓN:" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0,6,0"/>
      <TextBox Text="{Binding Service.ReviewNote, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="Nota obligatoria: qué se ha revisado o cambiado"/>
      <Button Content="No afecta" Command="{Binding Service.ReviewCommand}" CommandParameter="unaffected"/>
      <Button Content="Adaptar" Command="{Binding Service.ReviewCommand}" CommandParameter="adapt"/>
      <Button Content="Rehacer" Command="{Binding Service.ReviewCommand}" CommandParameter="remake"/>
     </WrapPanel>
     <DataGrid Grid.Row="5" IsReadOnly="True" AutoGenerateColumns="False" ItemsSource="{Binding Service.Preparations}" SelectedItem="{Binding Service.SelectedPreparation}"><DataGrid.Columns>
      <DataGridTextColumn Header="Preparación" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estación" Binding="{Binding StationId}" Width="90"/>
      <DataGridTextColumn Header="Comensal" Binding="{Binding GuestPosition}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="115"/><DataGridTextColumn Header="Restricciones" Binding="{Binding RestrictionsText}" Width="220"/>
      <DataGridTextColumn Header="Revisión" Binding="{Binding ReviewText}" Width="200"/>
     </DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="6"><TextBox Text="{Binding Service.Reason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo para pausa, omisión o liberación" Margin="0,8,0,0"/>
      <WrapPanel><Button Content="Omitir pase con motivo" Command="{Binding Service.ActCommand}" CommandParameter="skip"/>
       <Button Content="Terminar servicio" Command="{Binding Service.ActCommand}" CommandParameter="complete"/>
       <Button Content="Liberar mesa" Command="{Binding Service.ReleaseCommand}"/></WrapPanel>
     </StackPanel>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="  Puestos  " x:Name="DevicesTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="PUESTOS Y EMPAREJAMIENTO · SOLO ADMINISTRACIÓN" FontSize="20" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,10,0,4">
      <Button Content="Generar código de emparejamiento" Command="{Binding Devices.GenerateCodeCommand}"/>
      <TextBox Text="{Binding Devices.PairingCode, Mode=OneWay}" IsReadOnly="True" Width="360" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" ToolTip="Cópialo o tecléalo en el puesto nuevo. El QR llegará con la PWA."/>
     </WrapPanel>
     <TextBlock Text="{Binding Devices.PairingInfo}" Margin="0,0,0,12" TextWrapping="Wrap"/>
     <TextBlock Text="SOLICITUDES PENDIENTES" FontWeight="Bold"/>
     <ListBox ItemsSource="{Binding Devices.Pending}" SelectedItem="{Binding Devices.SelectedPending}" MaxHeight="110" BorderThickness="0"/>
     <WrapPanel Margin="0,6,0,14">
      <ComboBox Width="130" SelectedValuePath="Tag" SelectedValue="{Binding Devices.ApproveRole}">
       <ComboBoxItem Tag="service" IsSelected="True">Sala</ComboBoxItem><ComboBoxItem Tag="kitchen">Cocina</ComboBoxItem><ComboBoxItem Tag="main">Principal</ComboBoxItem>
      </ComboBox>
      <TextBox Text="{Binding Devices.ApproveStation, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="8,0,8,0" ToolTip="Estación (p. ej. sala-1, cold, hot, pase)"/>
      <Button Content="Aprobar" Command="{Binding Devices.ApproveCommand}"/>
      <Button Content="Denegar" Command="{Binding Devices.DenyCommand}"/>
     </WrapPanel>
     <TextBlock Text="PUESTOS EMPAREJADOS" FontWeight="Bold"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
     <Button Content="Revocar puesto seleccionado (expulsión inmediata)" Command="{Binding Devices.RevokeCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Devices.Devices}" SelectedItem="{Binding Devices.SelectedDevice}" BorderThickness="0"/>
   </DockPanel>
  </TabItem>
  <TabItem Header="  Cuenta / Caja  " x:Name="CheckoutTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="CUENTA / CAJA · SOLO PUESTO AUTORIZADO" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Registro operativo de ensayo: no emite facturas ni realiza cargos bancarios." Margin="0,8,0,14"/>
     <ComboBox ItemsSource="{Binding Checkout.Accounts}" SelectedItem="{Binding Checkout.SelectedAccount}" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding Checkout.Totals}" FontSize="18" Margin="0,6,0,10"/>
     <WrapPanel><ComboBox ItemsSource="{Binding Checkout.Products}" SelectedItem="{Binding Checkout.SelectedProduct}" Width="340"/>
      <TextBox Text="{Binding Checkout.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,10,0"/>
      <Button Content="Añadir del catálogo" Command="{Binding Checkout.AddCommand}"/></WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <WrapPanel><TextBox Text="{Binding Checkout.Amount, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Importe del pago en euros" Margin="0,0,10,0"/>
      <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding Checkout.Method}"><ComboBoxItem Tag="card" IsSelected="True">Tarjeta</ComboBoxItem><ComboBoxItem Tag="cash">Efectivo</ComboBoxItem><ComboBoxItem Tag="other">Otro</ComboBoxItem></ComboBox>
      <Button Content="Registrar pago de prueba" Command="{Binding Checkout.PayCommand}"/>
      <Button Content="Cerrar cuenta saldada" Command="{Binding Checkout.CloseAccountCommand}"/>
     </WrapPanel>
     <WrapPanel Margin="0,6,0,0"><TextBox Text="{Binding Checkout.Note, UpdateSourceTrigger=PropertyChanged}" Width="300" ToolTip="Motivo obligatorio para reabrir o devolver" Margin="0,0,10,0"/>
      <Button Content="Devolver crédito (importe y motivo)" Command="{Binding Checkout.RefundCommand}"/>
      <Button Content="Reabrir cuenta con motivo" Command="{Binding Checkout.ReopenCommand}"/>
     </WrapPanel>
     <TextBlock Text="{Binding Checkout.AccountState}" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid IsReadOnly="True" AutoGenerateColumns="False" ItemsSource="{Binding Checkout.Charges}"><DataGrid.Columns>
     <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
     <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="90"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel>
  </TabItem>
 </TabControl>
</DockPanel></Window>
