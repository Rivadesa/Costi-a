<Window x:Class="Costina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Costiña · Windows nativo · D2" Width="1240" Height="840" MinWidth="1040" MinHeight="700" Background="#F4F5F7" Closing="WindowClosing">
<DockPanel Margin="22">
 <StackPanel DockPanel.Dock="Top">
  <TextBlock Text="COSTIÑA  /  CONTROL DEL RESTAURANTE" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="0.3.0-d2 · WPF nativo · Ensayo con servidor local real · No usar con datos de clientes" Margin="0,5,0,14"/>
  <WrapPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Servidor de ensayo"/><TextBox x:Name="Endpoint" Text="http://127.0.0.1:5088" Width="260"/></StackPanel>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Clave del rol de laboratorio"/><PasswordBox x:Name="AccessKey" Width="280" Height="36" Padding="8"/></StackPanel>
   <Button x:Name="ConnectButton" Content="Conectar" Click="ConnectClick" VerticalAlignment="Bottom"/>
   <Button x:Name="DisconnectButton" Content="Desconectar" Click="DisconnectClick" VerticalAlignment="Bottom"/>
   <Button x:Name="RefreshButton" Content="Actualizar" Click="RefreshClick" VerticalAlignment="Bottom"/>
  </WrapPanel>
  <Border Background="#E6EBF1" Padding="10" Margin="0,10,0,6"><TextBlock x:Name="Status" Text="Introduce la clave del servidor. La aplicación no almacena la clave en disco." TextWrapping="Wrap"/></Border>
  <Border x:Name="PendingPanel" Background="#FFF0CE" Padding="8" Margin="0,0,0,8" Visibility="Collapsed"><DockPanel>
   <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Reintentar la misma orden" Click="RetryClick"/>
   <TextBlock x:Name="PendingText" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </StackPanel>
 <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
  <TextBlock x:Name="RealtimeState" Text="Tiempo real inactivo."/>
  <TextBlock x:Name="ReadTime" Text="Sin lectura actual del servidor. El botón Actualizar sigue disponible como respaldo."/>
 </StackPanel>
 <TabControl x:Name="Tabs" SelectionChanged="TabChanged">
  <TabItem Header="  Comedor y cocina  " x:Name="ServiceTab">
   <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
     <StackPanel DockPanel.Dock="Top" x:Name="OpenPanel">
      <TextBlock Text="ABRIR MESA" FontWeight="Bold" Margin="0,0,0,8"/>
      <ComboBox x:Name="TableSelect" Margin="0,0,0,6"/>
      <ComboBox x:Name="MenuSelect" Margin="0,0,0,6"/>
      <WrapPanel><TextBlock Text="Personas " VerticalAlignment="Center"/><TextBox x:Name="PaxInput" Text="2" Width="60"/>
       <Button x:Name="OpenButton" Content="Abrir" Click="OpenClick"/></WrapPanel>
      <TextBlock Text="MESAS OCUPADAS" Margin="0,18,0,8" FontWeight="Bold"/>
     </StackPanel>
     <ListBox x:Name="BoardList" SelectionChanged="BoardChanged" BorderThickness="0"/>
    </DockPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0"><TextBlock x:Name="ServiceTitle" Text="Selecciona una mesa" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Seguimiento operativo. Sin precios, cuenta ni pagos." Margin="0,5,0,8"/></StackPanel>
     <WrapPanel Grid.Row="1">
      <Button x:Name="StartButton" Content="Iniciar servicio" Tag="start" Click="DiningClick"/>
      <Button x:Name="FireButton" Content="Enviar siguiente pase" Tag="fire-next" Click="DiningClick"/>
      <Button x:Name="ServeButton" Content="Marcar servido" Tag="serve" Click="DiningClick"/>
      <Button x:Name="PauseButton" Content="Pausar" Tag="pause" Click="DiningClick"/>
      <Button x:Name="ResumeButton" Content="Reanudar" Tag="resume" Click="DiningClick"/>
     </WrapPanel>
     <DataGrid Grid.Row="2" x:Name="Courses" SelectionChanged="CourseChanged"><DataGrid.Columns>
      <DataGridTextColumn Header="Pase" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="145"/>
      <DataGridTextColumn Header="Servido" Binding="{Binding ServedAt, StringFormat=HH:mm:ss}" Width="115"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="3" x:Name="KitchenActions">
      <TextBlock Text="COCINA / PASE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
      <Button x:Name="PrepStartButton" Content="Iniciar elaboración" Tag="preparation-start" Click="DiningClick"/>
      <Button x:Name="PrepReadyButton" Content="Elaboración lista" Tag="preparation-ready" Click="DiningClick"/>
      <Button x:Name="ValidateButton" Content="Validar pase listo" Tag="ready" Click="DiningClick"/>
     </WrapPanel>
     <DataGrid Grid.Row="4" x:Name="Preparations" SelectionChanged="PreparationChanged"><DataGrid.Columns>
      <DataGridTextColumn Header="Preparación" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estación" Binding="{Binding StationId}" Width="90"/>
      <DataGridTextColumn Header="Comensal" Binding="{Binding GuestPosition}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="115"/>
     </DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="5"><TextBox x:Name="Reason" ToolTip="Motivo para pausa, omisión o liberación" Margin="0,8,0,0"/>
      <WrapPanel><Button x:Name="SkipButton" Content="Omitir pase con motivo" Tag="skip" Click="DiningClick"/>
       <Button x:Name="CompleteButton" Content="Terminar servicio" Tag="complete" Click="DiningClick"/>
       <Button x:Name="ReleaseButton" Content="Liberar mesa" Click="ReleaseClick"/></WrapPanel>
     </StackPanel>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="  Cuenta / Caja  " x:Name="CheckoutTab" Visibility="Collapsed">
   <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="CUENTA / CAJA · SOLO PUESTO AUTORIZADO" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Registro operativo de ensayo: no emite facturas ni realiza cargos bancarios." Margin="0,8,0,14"/>
     <ComboBox x:Name="AccountSelect" SelectionChanged="AccountChanged" Margin="0,0,0,8"/>
     <TextBlock x:Name="Totals" FontSize="18" Margin="0,6,0,10"/>
     <WrapPanel><ComboBox x:Name="ProductSelect" Width="340"/><TextBox x:Name="QuantityInput" Text="1" Width="60" Margin="10,0,10,0"/>
      <Button x:Name="AddButton" Content="Añadir del catálogo" Click="AddClick"/></WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <WrapPanel><TextBox x:Name="AmountInput" Width="140" ToolTip="Importe del pago en euros" Margin="0,0,10,0"/>
      <ComboBox x:Name="MethodSelect" Width="140" SelectedIndex="0"><ComboBoxItem Tag="card">Tarjeta</ComboBoxItem><ComboBoxItem Tag="cash">Efectivo</ComboBoxItem><ComboBoxItem Tag="other">Otro</ComboBoxItem></ComboBox>
      <Button x:Name="PayButton" Content="Registrar pago de prueba" Click="PayClick"/>
      <Button x:Name="CloseAccountButton" Content="Cerrar cuenta saldada" Click="CloseAccountClick"/>
     </WrapPanel>
     <TextBlock x:Name="AccountState" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="Charges"><DataGrid.Columns>
     <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
     <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="90"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel>
  </TabItem>
 </TabControl>
</DockPanel></Window>
