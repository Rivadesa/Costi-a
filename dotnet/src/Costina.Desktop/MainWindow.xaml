<Window x:Class="Costina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Costina.Desktop.Views"
 Title="Costiña · Puesto principal" Width="1280" Height="860" MinWidth="1080" MinHeight="720" Background="{StaticResource Cream}" Closing="WindowClosing"
 FontFamily="Segoe UI Variable, Segoe UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
<!-- C1: los conversores (Bool2Vis, NotBool2Vis) viven en Converters.xaml, combinado en App.xaml: las vistas no ven Window.Resources. -->
<Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
<!-- C1: los botones de las vistas navegan con GoToPage y el nombre de la vista (CommandParameter); el menu sigue con Click=ShowView.
     Los dos caminos aplican la misma logica, elevacion del responsable incluida. -->
<Window.CommandBindings><CommandBinding Command="NavigationCommands.GoToPage" CanExecute="CanGoToPage" Executed="GoToPage"/></Window.CommandBindings>
<DockPanel>
 <!-- Barra de menus clasica de Windows: es la estructura DEFINITIVA del ERP. Lo que aun no existe va deshabilitado con su corte.
      Cada entrada muestra una vista del area de trabajo (el TabControl de abajo, sin cabeceras). -->
 <Menu x:Name="MainMenu" DockPanel.Dock="Top">
  <MenuItem Header="_Archivo">
   <MenuItem Header="Inicio" Tag="HomeTab" Click="ShowView"/>
   <MenuItem Header="Entrar como responsable" Click="ElevateClick"/>
   <MenuItem Header="Salir del modo responsable" Command="{Binding LeaveResponsibleCommand}"/>
   <MenuItem Header="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}"/>
   <MenuItem Header="Actualizar" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
   <MenuItem Header="Desconectar" Command="{Binding DisconnectCommand}"/>
   <Separator/>
   <MenuItem Header="Salir" Click="ExitClick" InputGestureText="Alt+F4"/>
  </MenuItem>
  <MenuItem Header="_Comedor" x:Name="DiningMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Comedor y cocina" Tag="ServiceTab" Click="ShowView"/>
  </MenuItem>
  <MenuItem Header="Ca_ja" x:Name="CheckoutMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Cuenta / Caja" Tag="CheckoutTab" Click="ShowView"/>
   <Separator/>
   <MenuItem Header="Apertura y cierre de caja" IsEnabled="False" ToolTip="Llega en el Hito 7 (caja completa)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Arqueo y turnos" IsEnabled="False" ToolTip="Llega en el Hito 7 (caja completa)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="C_onfiguración" x:Name="ConfigurationMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Salas, mesas y estaciones" Tag="OrganizationTab" Click="ShowView"/>
   <MenuItem Header="Dispositivos: comanderos y pantallas de cocina" Tag="DevicesTab" Click="ShowView"/>
   <Separator/>
   <MenuItem Header="Usuarios y permisos" IsEnabled="False" ToolTip="Llega en E5 (Hito 6)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Módulos de la instalación" IsEnabled="False" ToolTip="Llega en E5 (Hito 6)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="_ERP" x:Name="ErpMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Catálogo y tarifas" Tag="CatalogTab" Click="ShowView"/>
   <MenuItem Header="Oferta: cartas y menús" Tag="OffersTab" Click="ShowView"/>
   <MenuItem Header="Informes" IsEnabled="False" ToolTip="Tras el Hito 7" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Stock, proveedores y compras" IsEnabled="False" ToolTip="Módulos posteriores" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="_Fiscalidad" x:Name="FiscalMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Series y facturas" IsEnabled="False" ToolTip="Llega en el Hito 8 (fiscal)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="VERI*FACTU" IsEnabled="False" ToolTip="Llega en el Hito 8 (fiscal)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="Ay_uda">
   <MenuItem Header="Acerca de Costiña" Click="AboutClick"/>
  </MenuItem>
 </Menu>
 <!-- Barra de estado: quien esta conectado y contra que servidor, tiempo real y hora de la ultima lectura autoritativa. -->
 <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
  <StatusBarItem><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <Separator/>
  <StatusBarItem><TextBlock Text="{Binding RealtimeState}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <Separator/>
  <StatusBarItem><TextBlock Text="{Binding ReadTime}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="Costiña 0.33.1-b1.1 · ensayo con servidor local real · no usar con datos de clientes" Style="{StaticResource Subtle}"/></StatusBarItem>
 </StatusBar>
 <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
  <!-- Arranque (corte B): mientras el servidor levanta tras encender el equipo, la ventana lo dice y espera. -->
  <Border Style="{StaticResource Banner}" Margin="0,0,0,10" Padding="16,12" Visibility="{Binding Booting, Converter={StaticResource Bool2Vis}}">
   <StackPanel><TextBlock Text="COSTIÑA" Style="{StaticResource AppTitle}"/><TextBlock Text="{Binding BootText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <!-- Entrada del responsable (corte B): sin conexion, o cuando un apartado sensible lo pide desde el nivel Puesto. -->
  <Border x:Name="LoginCard" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12" Visibility="{Binding LoginCardVisible, Converter={StaticResource Bool2Vis}}">
   <StackPanel>
    <TextBlock Text="{Binding LoginTitle}" Style="{StaticResource PanelTitle}"/>
    <TextBlock Text="Usuario y contraseña del responsable. La contraseña no se guarda en disco y la sesión caduca sola; el puesto sigue operativo mientras tanto." Style="{StaticResource Subtle}" Margin="0,2,0,10" TextWrapping="Wrap"/>
    <WrapPanel VerticalAlignment="Bottom">
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="160"/></StackPanel>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="AccessKey" IsEnabled="{Binding ConnectEnabled}" Width="200" KeyDown="AccessKeyDown"/></StackPanel>
     <Button x:Name="ConnectButton" Content="Entrar" Style="{StaticResource Primary}" IsEnabled="{Binding ConnectEnabled}" Click="ConnectClick" VerticalAlignment="Bottom"/>
     <Button x:Name="CancelElevationButton" Content="Seguir como puesto" Style="{StaticResource Ghost}" Command="{Binding CancelElevationCommand}" VerticalAlignment="Bottom" Visibility="{Binding ElevationRequested, Converter={StaticResource Bool2Vis}}"/>
    </WrapPanel>
    <Expander Header="Este PC no es el servidor, o es un puesto adicional" Margin="0,8,0,0" Visibility="{Binding Connected, Converter={StaticResource NotBool2Vis}}">
     <StackPanel Margin="0,6,0,0">
      <WrapPanel>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Servidor" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="260" ToolTip="http://127.0.0.1:5088 en el propio servidor; https://EQUIPO:PUERTO en un puesto adicional. Se recuerda en este equipo."/></StackPanel>
       <Button Content="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}" VerticalAlignment="Bottom"/>
       <Button x:Name="DisconnectButton" Content="Desconectar" Style="{StaticResource Ghost}" Command="{Binding DisconnectCommand}" VerticalAlignment="Bottom"/>
       <Button x:Name="RefreshButton" Content="Actualizar" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/>
      </WrapPanel>
      <WrapPanel Margin="0,6,0,0">
       <TextBlock Text="Emparejar este PC como puesto adicional:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Subtle}"/>
       <TextBox x:Name="PairCode" Width="330" ToolTip="Código de un solo uso generado en el PC principal (Dispositivos › Conectar comandero)"/>
       <TextBox Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,8,0" ToolTip="Nombre de este puesto (p. ej. pc-barra)"/>
       <Button Content="Solicitar emparejamiento" Command="{Binding PairDeviceCommand}" CommandParameter="{Binding Text, ElementName=PairCode}"/>
       <TextBlock Text="{Binding PairingStatus}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
      </WrapPanel>
     </StackPanel>
    </Expander>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Banner}" Margin="0,0,0,8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
  <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,8" Visibility="{Binding HasPending, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Reintentar la misma orden" Style="{StaticResource Primary}" Command="{Binding RetryCommand}"/>
   <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
  <Border Style="{StaticResource DangerBanner}" Margin="0,0,0,8" Visibility="{Binding HasBlocked, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Consultar al servidor" Command="{Binding ReconcileCommand}"/>
    <Button Content="Descartar conservando evidencia" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}"/>
   </StackPanel>
   <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </StackPanel>
 <!-- Area de trabajo: una vista por entrada de menu. Las cabeceras de pestana no se pintan (plantilla vacia). -->
 <TabControl x:Name="Tabs" IsEnabled="{Binding TabsEnabled}" SelectionChanged="TabChanged" Margin="24,0,24,12">
  <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"/></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
  <!-- =============== Inicio (corte A, plan 2026-09-24): estado, accesos y dispositivos =============== -->
  <TabItem Header="Inicio" x:Name="HomeTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:HomeView x:Name="HomeView"/>
  </TabItem>
  <!-- ═══════════════ Comedor y cocina (modulo Dining) ═══════════════ -->
  <TabItem Header="Comedor y cocina" x:Name="ServiceTab" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
   <views:ServiceView x:Name="ServiceView"/>
  </TabItem>
  <!-- ═══════════════ Cuenta / Caja (nucleo, solo main) ═══════════════ -->
  <TabItem Header="Cuenta / Caja" x:Name="CheckoutTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:CheckoutView x:Name="CheckoutView"/>
  </TabItem>
  <!-- ═══════════════ ERP › Catalogo y tarifas (nucleo, E3, solo main) ═══════════════ -->
  <TabItem Header="Catálogo" x:Name="CatalogTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:CatalogView x:Name="CatalogView"/>
  </TabItem>
  <!-- ═══════════════ ERP › Oferta: cartas y menus (nucleo, E4a, solo main) ═══════════════ -->
  <TabItem Header="Oferta" x:Name="OffersTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:OffersView x:Name="OffersView"/>
  </TabItem>
  <!-- ═══════════════ Configuracion (nucleo, E2, solo main) ═══════════════ -->
  <TabItem Header="Configuración" x:Name="OrganizationTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:OrganizationView x:Name="OrganizationView"/>
  </TabItem>
  <!-- =============== Dispositivos (nucleo, solo main; corte A): conectar comanderos y pantallas de cocina =============== -->
  <TabItem Header="Dispositivos" x:Name="DevicesTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <views:DevicesView x:Name="DevicesView"/>
  </TabItem>
 </TabControl>
</DockPanel></Window>
