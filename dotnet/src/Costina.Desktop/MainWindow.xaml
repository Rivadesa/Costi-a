<Window x:Class="Costina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Costina.Desktop"
 Title="Costiña · Puesto principal" Width="1280" Height="860" MinWidth="1080" MinHeight="720" Background="{StaticResource Cream}" Closing="WindowClosing"
 FontFamily="Segoe UI Variable, Segoe UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
<Window.Resources><BooleanToVisibilityConverter x:Key="Bool2Vis"/><local:InvertedBool2Vis x:Key="NotBool2Vis"/></Window.Resources>
<Window.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/></Window.InputBindings>
<DockPanel>
 <!-- Barra de menus clasica de Windows: es la estructura DEFINITIVA del ERP. Lo que aun no existe va deshabilitado con su corte.
      Cada entrada muestra una vista del area de trabajo (el TabControl de abajo, sin cabeceras). -->
 <Menu x:Name="MainMenu" DockPanel.Dock="Top">
  <MenuItem Header="_Archivo">
   <MenuItem Header="Inicio" Tag="HomeTab" Click="ShowView"/>
   <MenuItem Header="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}"/>
   <MenuItem Header="Actualizar" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
   <MenuItem Header="Desconectar" Command="{Binding DisconnectCommand}"/>
   <Separator/>
   <MenuItem Header="Salir" Click="ExitClick" InputGestureText="Alt+F4"/>
  </MenuItem>
  <MenuItem Header="_Comedor" x:Name="DiningMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Comedor y cocina" Tag="ServiceTab" Click="ShowView"/>
  </MenuItem>
  <MenuItem Header="Ca_ja" x:Name="CheckoutMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Cuenta / Caja" Tag="CheckoutTab" Click="ShowView"/>
   <Separator/>
   <MenuItem Header="Apertura y cierre de caja" IsEnabled="False" ToolTip="Llega en el Hito 7 (caja completa)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Arqueo y turnos" IsEnabled="False" ToolTip="Llega en el Hito 7 (caja completa)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="C_onfiguración" x:Name="ConfigurationMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Salas, mesas y estaciones" Tag="OrganizationTab" Click="ShowView"/>
   <MenuItem Header="Dispositivos: comanderos y pantallas de cocina" Tag="DevicesTab" Click="ShowView"/>
   <Separator/>
   <MenuItem Header="Usuarios y permisos" IsEnabled="False" ToolTip="Llega en E5 (Hito 6)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Módulos de la instalación" IsEnabled="False" ToolTip="Llega en E5 (Hito 6)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="_ERP" x:Name="ErpMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Catálogo y tarifas" Tag="CatalogTab" Click="ShowView"/>
   <MenuItem Header="Oferta: cartas y menús" Tag="OffersTab" Click="ShowView"/>
   <MenuItem Header="Informes" IsEnabled="False" ToolTip="Tras el Hito 7" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="Stock, proveedores y compras" IsEnabled="False" ToolTip="Módulos posteriores" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="_Fiscalidad" x:Name="FiscalMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <MenuItem Header="Series y facturas" IsEnabled="False" ToolTip="Llega en el Hito 8 (fiscal)" ToolTipService.ShowOnDisabled="True"/>
   <MenuItem Header="VERI*FACTU" IsEnabled="False" ToolTip="Llega en el Hito 8 (fiscal)" ToolTipService.ShowOnDisabled="True"/>
  </MenuItem>
  <MenuItem Header="Ay_uda">
   <MenuItem Header="Acerca de Costiña" Click="AboutClick"/>
  </MenuItem>
 </Menu>
 <!-- Barra de estado: quien esta conectado y contra que servidor, tiempo real y hora de la ultima lectura autoritativa. -->
 <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
  <StatusBarItem><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <Separator/>
  <StatusBarItem><TextBlock Text="{Binding RealtimeState}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <Separator/>
  <StatusBarItem><TextBlock Text="{Binding ReadTime}" Style="{StaticResource Subtle}"/></StatusBarItem>
  <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="Costiña 0.32.0-a1 · ensayo con servidor local real · no usar con datos de clientes" Style="{StaticResource Subtle}"/></StatusBarItem>
 </StatusBar>
 <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
  <!-- Conexion: solo mientras no hay sesion. Despues, todo va por el menu Archivo. -->
  <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12" Visibility="{Binding Connected, Converter={StaticResource NotBool2Vis}}">
   <StackPanel>
    <TextBlock Text="COSTIÑA" Style="{StaticResource AppTitle}"/>
    <TextBlock Text="Entra con tu usuario y contraseña, o conecta este puesto emparejado. La contraseña no se guarda en disco." Style="{StaticResource Subtle}" Margin="0,2,0,10"/>
    <WrapPanel VerticalAlignment="Bottom">
     <StackPanel Margin="0,0,12,0"><TextBlock Text="Servidor" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="220"/></StackPanel>
     <StackPanel Margin="0,0,8,0"><TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}" Width="140"/></StackPanel>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="AccessKey" IsEnabled="{Binding ConnectEnabled}" Width="180"/></StackPanel>
     <Button x:Name="ConnectButton" Content="Entrar" Style="{StaticResource Primary}" IsEnabled="{Binding ConnectEnabled}" Click="ConnectClick" VerticalAlignment="Bottom"/>
     <Button Content="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}" VerticalAlignment="Bottom"/>
     <Button x:Name="DisconnectButton" Content="Desconectar" Style="{StaticResource Ghost}" Command="{Binding DisconnectCommand}" VerticalAlignment="Bottom"/>
     <Button x:Name="RefreshButton" Content="Actualizar" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/>
    </WrapPanel>
    <WrapPanel Margin="0,6,0,0" Visibility="{Binding ConnectEnabled, Converter={StaticResource Bool2Vis}}">
     <TextBlock Text="Emparejar este puesto:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Subtle}"/>
     <TextBox x:Name="PairCode" Width="330" ToolTip="Código de un solo uso generado por el administrador (Configuración › Puestos del PC principal)"/>
     <TextBox Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,0,8,0" ToolTip="Nombre de este puesto (p. ej. tablet-sala-1)"/>
     <Button Content="Solicitar emparejamiento" Command="{Binding PairDeviceCommand}" CommandParameter="{Binding Text, ElementName=PairCode}"/>
     <TextBlock Text="{Binding PairingStatus}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource Banner}" Margin="0,0,0,8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
  <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,8" Visibility="{Binding HasPending, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Reintentar la misma orden" Style="{StaticResource Primary}" Command="{Binding RetryCommand}"/>
   <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
  <Border Style="{StaticResource DangerBanner}" Margin="0,0,0,8" Visibility="{Binding HasBlocked, Converter={StaticResource Bool2Vis}}"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="Consultar al servidor" Command="{Binding ReconcileCommand}"/>
    <Button Content="Descartar conservando evidencia" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}"/>
   </StackPanel>
   <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
 </StackPanel>
 <!-- Area de trabajo: una vista por entrada de menu. Las cabeceras de pestana no se pintan (plantilla vacia). -->
 <TabControl x:Name="Tabs" IsEnabled="{Binding TabsEnabled}" SelectionChanged="TabChanged" Margin="24,0,24,12">
  <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"/></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
  <!-- =============== Inicio (corte A, plan 2026-09-24): estado, accesos y dispositivos =============== -->
  <TabItem Header="Inicio" x:Name="HomeTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Inicio" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="{Binding Home.WhoText}" TextWrapping="Wrap" Margin="0,4,0,4"/>
     <TextBlock Text="{Binding Home.ServerText}" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
     <TextBlock Text="{Binding RealtimeState}" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
     <TextBlock Text="{Binding Home.BackupText}" TextWrapping="Wrap" Style="{StaticResource Subtle}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,12" Visibility="{Binding Home.HasCertificateWarning, Converter={StaticResource Bool2Vis}}"><TextBlock Text="{Binding Home.CertificateWarning}" TextWrapping="Wrap"/></Border>
    <TextBlock Text="Apartados" Style="{StaticResource Section}"/>
    <WrapPanel Margin="0,4,0,12">
     <Button x:Name="HomeDiningButton" Content="Comedor y cocina" Tag="ServiceTab" Click="ShowView" Style="{StaticResource Primary}" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}"/>
     <Button Content="Cuenta / Caja" Tag="CheckoutTab" Click="ShowView" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
     <Button Content="Configuración" Tag="OrganizationTab" Click="ShowView" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
     <Button Content="Catálogo y tarifas" Tag="CatalogTab" Click="ShowView" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
     <Button Content="Oferta: cartas y menús" Tag="OffersTab" Click="ShowView" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
     <Button x:Name="HomeDevicesButton" Content="Dispositivos" Tag="DevicesTab" Click="ShowView" MinWidth="210" MinHeight="56" FontSize="15" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"/>
    </WrapPanel>
    <Border Style="{StaticResource Card}" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}"><StackPanel>
     <TextBlock Text="Dispositivos" Style="{StaticResource Section}"/>
     <TextBlock Text="{Binding Home.DevicesSummary}" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,8,0,0">
      <Button Content="Conectar comandero" Tag="DevicesTab" Click="ShowView"/>
      <Button Content="Conectar pantalla de cocina" Tag="DevicesTab" Click="ShowView"/>
     </WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
  </TabItem>
  <!-- ═══════════════ Comedor y cocina (modulo Dining) ═══════════════ -->
  <TabItem Header="Comedor y cocina" x:Name="ServiceTab" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Visibility="{Binding CanOpen, Converter={StaticResource Bool2Vis}}">
       <TextBlock Text="Abrir mesa" Style="{StaticResource Section}"/>
       <ComboBox ItemsSource="{Binding Service.Tables}" SelectedItem="{Binding Service.SelectedTable}" Margin="0,0,0,6"/>
       <ComboBox ItemsSource="{Binding Service.Offers}" SelectedItem="{Binding Service.SelectedOffer}" Margin="0,0,0,6" ToolTip="Oferta vigente: degustación o menú cerrado"/>
       <DockPanel><Button DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource Primary}" Command="{Binding Service.OpenCommand}"/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="Personas" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Subtle}"/><TextBox Text="{Binding Service.Pax, UpdateSourceTrigger=PropertyChanged}" Width="60"/></StackPanel></DockPanel>
       <TextBlock Text="Mesas ocupadas" Style="{StaticResource Section}" Margin="0,16,0,8"/>
      </StackPanel>
      <ListBox ItemsSource="{Binding Service.Board}" SelectedItem="{Binding Service.SelectedEntry}" BorderThickness="0" Background="Transparent"/>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0"><TextBlock Text="{Binding Service.ServiceTitle}" Style="{StaticResource PanelTitle}"/>
       <TextBlock Text="Seguimiento operativo. Sin precios, cuenta ni pagos." Style="{StaticResource Subtle}" Margin="0,4,0,10"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,6">
       <Border Style="{StaticResource AllergyBanner}" Margin="0,0,0,8" Visibility="{Binding Service.RestrictionsPendingAck, Converter={StaticResource Bool2Vis}}">
        <TextBlock Foreground="White" FontWeight="Bold" TextWrapping="Wrap"
         Text="⚠ CAMBIO DE RESTRICCIONES SIN REVISAR POR COCINA — cada elaboración marcada PENDIENTE DE REVISIÓN exige una decisión (no afecta / adaptar / rehacer) antes de validar, servir o disparar."/>
       </Border>
       <TextBlock Text="Restricciones" Style="{StaticResource Section}"/>
       <WrapPanel>
        <ListBox ItemsSource="{Binding Service.Restrictions}" SelectedItem="{Binding Service.SelectedRestriction}" MaxHeight="56" MinWidth="330" Margin="0,0,8,0"/>
        <TextBox Text="{Binding Service.RestrictionGuest, UpdateSourceTrigger=PropertyChanged}" Width="48" ToolTip="Comensal (vacío = toda la mesa)"/>
        <ComboBox Width="120" Margin="6,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding Service.RestrictionKind}">
         <ComboBoxItem Tag="allergy" IsSelected="True">Alergia</ComboBoxItem><ComboBoxItem Tag="intolerance">Intolerancia</ComboBoxItem><ComboBoxItem Tag="preference">Preferencia</ComboBoxItem>
        </ComboBox>
        <TextBox Text="{Binding Service.RestrictionSubstance, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="6,0,0,0" ToolTip="Sustancia o preferencia"/>
        <ComboBox Width="110" Margin="6,0,6,0" SelectedValuePath="Tag" SelectedValue="{Binding Service.RestrictionSeverity}">
         <ComboBoxItem Tag="severe" IsSelected="True">Grave</ComboBoxItem><ComboBoxItem Tag="moderate">Moderada</ComboBoxItem><ComboBoxItem Tag="mild">Leve</ComboBoxItem>
        </ComboBox>
        <Button Content="Declarar" Command="{Binding Service.DeclareRestrictionCommand}"/>
        <Button Content="Retirar con motivo" Style="{StaticResource DangerButton}" Command="{Binding Service.RemoveRestrictionCommand}"/>
       </WrapPanel>
      </StackPanel>
      <WrapPanel Grid.Row="2">
       <Button Content="Iniciar servicio" Style="{StaticResource Primary}" Command="{Binding Service.ActCommand}" CommandParameter="start"/>
       <Button Content="Enviar siguiente pase" Style="{StaticResource Primary}" Command="{Binding Service.ActCommand}" CommandParameter="fire-next"/>
       <Button Content="Marcar servido" Command="{Binding Service.ActCommand}" CommandParameter="serve"/>
       <Button Content="Pausar" Command="{Binding Service.ActCommand}" CommandParameter="pause"/>
       <Button Content="Reanudar" Command="{Binding Service.ActCommand}" CommandParameter="resume"/>
      </WrapPanel>
      <DockPanel Grid.Row="3" Margin="0,4,0,8">
       <!-- E4a: eleccion de plato por comensal en un pase de menu cerrado (solo si el servidor anuncia 'choose' en el pase) -->
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Service.CanChoose, Converter={StaticResource Bool2Vis}}"><StackPanel>
        <TextBlock Text="Menú cerrado: cada comensal elige su plato antes de enviar el pase" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Service.ChoicesText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,6"/>
        <WrapPanel><TextBlock Text="Comensal" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Subtle}"/><TextBox Text="{Binding Service.ChoiceGuest, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
         <ComboBox ItemsSource="{Binding Service.ChoiceDishes}" SelectedItem="{Binding Service.SelectedChoiceDish}" Width="220" Margin="8,0,0,0"/>
         <Button Content="Elegir plato" Style="{StaticResource Primary}" Command="{Binding Service.ChooseCommand}"/></WrapPanel>
       </StackPanel></Border>
       <!-- E4b: pedir un plato de la carta en un grupo pendiente (solo si el servidor anuncia 'add-dish' en el pase) -->
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,6,0,0" Visibility="{Binding Service.CanAddDish, Converter={StaticResource Bool2Vis}}"><StackPanel>
        <TextBlock Text="Carta: pedir platos de este grupo (se apuntan en la cuenta al pedirlos)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel><ComboBox ItemsSource="{Binding Service.DishItems}" SelectedItem="{Binding Service.SelectedDishItem}" Width="260"/>
         <TextBlock Text="Comensal" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource Subtle}"/><TextBox Text="{Binding Service.DishGuest, UpdateSourceTrigger=PropertyChanged}" Width="48" ToolTip="Vacío = toda la mesa"/>
         <TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource Subtle}"/><TextBox Text="{Binding Service.DishQuantity, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
         <Button Content="Pedir plato" Style="{StaticResource Primary}" Command="{Binding Service.AddDishCommand}"/></WrapPanel>
       </StackPanel></Border>
       <DataGrid ItemsSource="{Binding Service.Courses}" SelectedItem="{Binding Service.SelectedCourse}"><DataGrid.Columns>
        <DataGridTextColumn Header="Pase" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="145"/>
        <DataGridTextColumn Header="Servido" Binding="{Binding ServedAt, StringFormat=HH:mm:ss}" Width="115"/>
       </DataGrid.Columns></DataGrid>
      </DockPanel>
      <WrapPanel Grid.Row="4" Visibility="{Binding IsKitchen, Converter={StaticResource Bool2Vis}}">
       <TextBlock Text="Cocina / pase" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <Button Content="Iniciar elaboración" Command="{Binding Service.ActCommand}" CommandParameter="preparation-start"/>
       <Button Content="Elaboración lista" Command="{Binding Service.ActCommand}" CommandParameter="preparation-ready"/>
       <Button Content="Validar pase listo" Style="{StaticResource Primary}" Command="{Binding Service.ActCommand}" CommandParameter="ready"/>
       <TextBlock Text="Revisión:" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="14,0,6,0"/>
       <TextBox Text="{Binding Service.ReviewNote, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" ToolTip="Nota obligatoria: qué se ha revisado o cambiado"/>
       <Button Content="No afecta" Command="{Binding Service.ReviewCommand}" CommandParameter="unaffected"/>
       <Button Content="Adaptar" Command="{Binding Service.ReviewCommand}" CommandParameter="adapt"/>
       <Button Content="Rehacer" Command="{Binding Service.ReviewCommand}" CommandParameter="remake"/>
      </WrapPanel>
      <DataGrid Grid.Row="5" ItemsSource="{Binding Service.Preparations}" SelectedItem="{Binding Service.SelectedPreparation}" Margin="0,4,0,0"><DataGrid.Columns>
       <DataGridTextColumn Header="Preparación" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Estación" Binding="{Binding StationId}" Width="90"/>
       <DataGridTextColumn Header="Comensal" Binding="{Binding GuestPosition}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="115"/><DataGridTextColumn Header="Restricciones" Binding="{Binding RestrictionsText}" Width="220"/>
       <DataGridTextColumn Header="Revisión" Binding="{Binding ReviewText}" Width="200"/>
      </DataGrid.Columns></DataGrid>
      <StackPanel Grid.Row="6"><TextBox Text="{Binding Service.Reason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo para pausa, omisión o liberación" Margin="0,8,0,0"/>
       <WrapPanel><Button Content="Omitir pase con motivo" Command="{Binding Service.ActCommand}" CommandParameter="skip"/>
        <Button Content="Terminar servicio" Command="{Binding Service.ActCommand}" CommandParameter="complete"/>
        <Button Content="Liberar mesa" Style="{StaticResource DangerButton}" Command="{Binding Service.ReleaseCommand}"/></WrapPanel>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </TabItem>
  <!-- ═══════════════ Cuenta / Caja (nucleo, solo main) ═══════════════ -->
  <TabItem Header="Cuenta / Caja" x:Name="CheckoutTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <Border Style="{StaticResource Card}" Margin="0,4,0,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Cuenta / Caja" Style="{StaticResource PanelTitle}"/>
      <TextBlock Text="Registro operativo de ensayo: no emite facturas ni realiza cargos bancarios. Solo el puesto principal." Style="{StaticResource Subtle}" Margin="0,4,0,12"/>
      <TextBlock Text="Cuenta" Style="{StaticResource FieldLabel}"/>
      <ComboBox ItemsSource="{Binding Checkout.Accounts}" SelectedItem="{Binding Checkout.SelectedAccount}" Margin="0,0,0,8" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360"/>
      <TextBlock Text="{Binding Checkout.Totals}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Forest}" Margin="0,4,0,10"/>
      <WrapPanel><ComboBox ItemsSource="{Binding Checkout.Products}" SelectedItem="{Binding Checkout.SelectedProduct}" Width="340"/>
       <TextBox Text="{Binding Checkout.Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,10,0"/>
       <Button Content="Añadir del catálogo" Style="{StaticResource Primary}" Command="{Binding Checkout.AddCommand}"/></WrapPanel>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <WrapPanel><TextBox Text="{Binding Checkout.Amount, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Importe del pago en euros" Margin="0,0,10,0"/>
       <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding Checkout.Method}"><ComboBoxItem Tag="card" IsSelected="True">Tarjeta</ComboBoxItem><ComboBoxItem Tag="cash">Efectivo</ComboBoxItem><ComboBoxItem Tag="other">Otro</ComboBoxItem></ComboBox>
       <Button Content="Registrar pago de prueba" Style="{StaticResource Primary}" Command="{Binding Checkout.PayCommand}"/>
       <Button Content="Cerrar cuenta saldada" Command="{Binding Checkout.CloseAccountCommand}"/>
      </WrapPanel>
      <WrapPanel Margin="0,6,0,0"><TextBox Text="{Binding Checkout.Note, UpdateSourceTrigger=PropertyChanged}" Width="300" ToolTip="Motivo obligatorio para reabrir o devolver" Margin="0,0,10,0"/>
       <Button Content="Devolver crédito (importe y motivo)" Style="{StaticResource DangerButton}" Command="{Binding Checkout.RefundCommand}"/>
       <Button Content="Reabrir cuenta con motivo" Command="{Binding Checkout.ReopenCommand}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Checkout.AccountState}" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
     </StackPanel>
     <DataGrid ItemsSource="{Binding Checkout.Charges}" Margin="0,8,0,0"><DataGrid.Columns>
      <DataGridTextColumn Header="Concepto" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
      <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="120"/><DataGridCheckBoxColumn Header="Anulado" Binding="{Binding Voided}" Width="90"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
   </Border>
  </TabItem>
  <!-- ═══════════════ ERP › Catalogo y tarifas (nucleo, E3, solo main) ═══════════════ -->
  <TabItem Header="Catálogo" x:Name="CatalogTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
     <TextBlock Text="Catálogo y tarifas" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="{Binding Catalog.Summary}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
     <TextBlock Text="Nada se borra: productos, categorías, tarifas e impuestos se desactivan y conservan su historia. El precio que se cobra queda congelado en cada cuenta con su producto, presentación y tarifa." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="6*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <!-- Categorias -->
     <Border Grid.Column="0" Style="{StaticResource Card}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Categoría" Command="{Binding Catalog.StartCategoryCommand}" Margin="0"/><TextBlock Text="Categorías" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <CheckBox DockPanel.Dock="Top" Content="Ver todos los productos" IsChecked="{Binding Catalog.AllCategories}" Margin="0,0,0,8"/>
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,10,0,0"><StackPanel>
        <TextBlock Text="{Binding Catalog.CategoryFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategoryId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewCategory}"/>
        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.CategoryName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}"/>
        <TextBlock Text="Dentro de (vacío = raíz)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
        <ComboBox ItemsSource="{Binding Catalog.ParentChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.CategoryParentId}" IsEnabled="{Binding Catalog.CategoryEditable}"/>
        <WrapPanel Margin="0,6,0,0">
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Color (#RRGGBB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategoryColor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" Width="90"/></StackPanel>
         <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.CategorySort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.CategoryEditable}" Width="60"/></StackPanel>
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0"><Button Content="Guardar categoría" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveCategoryCommand}"/>
         <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleCategoryCommand}"/></WrapPanel>
       </StackPanel></Border>
       <TextBlock DockPanel.Dock="Bottom" Text="Aún no hay categorías. Crea la primera con «＋ Categoría» o importa un fichero." Style="{StaticResource Subtle}" Margin="0,8,0,0" Visibility="{Binding Catalog.HasCategories, Converter={StaticResource NotBool2Vis}}"/>
       <ListBox x:Name="CategoryList" ItemsSource="{Binding Catalog.Categories}" SelectedItem="{Binding Catalog.SelectedCategory}" FontFamily="Consolas, Segoe UI Variable"/>
      </DockPanel>
     </Border>
     <!-- Productos y presentaciones -->
     <Border Grid.Column="2" Style="{StaticResource Card}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
       <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Producto" Command="{Binding Catalog.StartProductCommand}" Margin="0"/><TextBlock Text="Productos" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding Catalog.Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nombre, código o referencia" Margin="0,0,0,8"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Height="150">
         <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="＋ Presentación" Command="{Binding Catalog.StartPresentationCommand}" Margin="0"/><TextBlock Text="Presentaciones del producto y precio vigente por tarifa" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
         <TextBlock DockPanel.Dock="Bottom" Text="Un producto se vende siempre por una presentación (botella, copa, ración…). Sin precio vigente en la tarifa general no se vende." Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
         <ListBox x:Name="PresentationList" ItemsSource="{Binding Catalog.Presentations}" SelectedItem="{Binding Catalog.SelectedPresentation}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="No hay productos que mostrar: cambia la categoría o la búsqueda, crea uno con «＋ Producto» o importa un CSV con «Costina.Server import-catalog»." Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Catalog.HasProducts, Converter={StaticResource NotBool2Vis}}"/>
        <ListBox x:Name="ProductList" ItemsSource="{Binding Catalog.Products}" SelectedItem="{Binding Catalog.SelectedProduct}"/>
       </DockPanel>
       <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
        <Border Style="{StaticResource Banner}" Margin="0,0,0,10"><StackPanel>
         <TextBlock Text="{Binding Catalog.ProductFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewProduct}"/>
         <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.ProductName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}"/>
         <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
         <ComboBox ItemsSource="{Binding Catalog.ActiveCategories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductCategoryId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
         <TextBlock Text="Impuesto" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
         <ComboBox ItemsSource="{Binding Catalog.ActiveTaxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductTaxId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
         <TextBlock Text="Estación de cocina (si es un plato)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
         <ComboBox ItemsSource="{Binding Catalog.StationChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.ProductStationId}" IsEnabled="{Binding Catalog.ProductEditable}"/>
         <WrapPanel Margin="0,6,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Referencia externa" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" Width="120"/></StackPanel>
          <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.ProductSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.ProductEditable}" Width="60"/></StackPanel>
         </WrapPanel>
         <StackPanel Visibility="{Binding Catalog.NewProduct, Converter={StaticResource Bool2Vis}}"><TextBlock Text="Primera presentación (p. ej. Botella, Ración)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.ProductPresentationName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar producto" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveProductCommand}"/>
          <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleProductCommand}"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Banner}"><StackPanel>
         <TextBlock Text="{Binding Catalog.PresentationFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewPresentation}"/>
         <WrapPanel Margin="0,6,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" Width="150"/></StackPanel>
          <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PresentationSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PresentationEditable}" Width="60"/></StackPanel>
         </WrapPanel>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar presentación" Style="{StaticResource Primary}" Command="{Binding Catalog.SavePresentationCommand}"/>
          <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.TogglePresentationCommand}"/></WrapPanel>
         <TextBlock Text="Precio (IVA incluido)" Style="{StaticResource Section}" Margin="0,12,0,6"/>
         <TextBlock Text="Tarifa" Style="{StaticResource FieldLabel}"/>
         <ComboBox ItemsSource="{Binding Catalog.ActiveTariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Catalog.PriceTariffId}" IsEnabled="{Binding Catalog.PriceEditable}"/>
         <WrapPanel Margin="0,6,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Importe (€)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PriceText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" Width="90"/></StackPanel>
          <StackPanel><TextBlock Text="Desde (AAAA-MM-DD)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.PriceValidFrom, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.PriceEditable}" Width="110"/></StackPanel>
         </WrapPanel>
         <Button Content="Fijar precio" Style="{StaticResource Primary}" Command="{Binding Catalog.SetPriceCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
        </StackPanel></Border>
       </StackPanel></ScrollViewer>
      </Grid>
     </Border>
     <!-- Tarifas e impuestos -->
     <Border Grid.Column="4" Style="{StaticResource Card}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Grid.Row="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Tarifa" Command="{Binding Catalog.StartTariffCommand}" Margin="0"/><TextBlock Text="Tarifas" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,8,0,0"><StackPanel>
         <TextBlock Text="{Binding Catalog.TariffFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <WrapPanel>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TariffId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTariff}" Width="110"/></StackPanel>
          <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TariffSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}" Width="60"/></StackPanel>
         </WrapPanel>
         <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.TariffName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TariffEditable}"/>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar tarifa" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveTariffCommand}"/>
          <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleTariffCommand}"/></WrapPanel>
        </StackPanel></Border>
        <TextBlock DockPanel.Dock="Bottom" Text="La tarifa «general» existe siempre. Cada sala puede usar otra (Configuración › Salas): sin precio en ella se aplica la general." Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <ListBox x:Name="TariffList" ItemsSource="{Binding Catalog.Tariffs}" SelectedItem="{Binding Catalog.SelectedTariff}"/>
       </DockPanel>
       <DockPanel Grid.Row="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Impuesto" Command="{Binding Catalog.StartTaxCommand}" Margin="0"/><TextBlock Text="Impuestos" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,8,0,0"><StackPanel>
         <TextBlock Text="{Binding Catalog.TaxFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <WrapPanel>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TaxId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.NewTax}" Width="110"/></StackPanel>
          <StackPanel><TextBlock Text="Tipo (%)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Catalog.TaxRate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}" Width="60"/></StackPanel>
         </WrapPanel>
         <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Catalog.TaxName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Catalog.TaxEditable}"/>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar impuesto" Style="{StaticResource Primary}" Command="{Binding Catalog.SaveTaxCommand}"/>
          <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Catalog.ToggleTaxCommand}"/></WrapPanel>
        </StackPanel></Border>
        <ListBox x:Name="TaxList" ItemsSource="{Binding Catalog.Taxes}" SelectedItem="{Binding Catalog.SelectedTax}"/>
       </DockPanel>
      </Grid>
     </Border>
    </Grid>
   </Grid>
  </TabItem>
  <!-- ═══════════════ ERP › Oferta: cartas y menus (nucleo, E4a, solo main) ═══════════════ -->
  <TabItem Header="Oferta" x:Name="OffersTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
     <TextBlock Text="Oferta: cartas y menús" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="{Binding Offers.Summary}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
     <TextBlock Text="Una degustación sirve todos sus platos; en un menú cerrado cada comensal elige un plato por pase antes de enviarlo a cocina. Nada se borra: se desactiva. La carta libre llega en E4b." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <!-- Ofertas -->
     <Border Grid.Column="0" Style="{StaticResource Card}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Oferta" Command="{Binding Offers.StartOfferCommand}" Margin="0"/><TextBlock Text="Ofertas" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,10,0,0"><StackPanel>
        <TextBlock Text="{Binding Offers.OfferFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.NewOffer}" Width="130"/></StackPanel>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Tipo" Style="{StaticResource FieldLabel}"/>
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Offers.OfferKind}" IsEnabled="{Binding Offers.OfferEditable}" Width="140"><ComboBoxItem Tag="tasting">Degustación</ComboBoxItem><ComboBoxItem Tag="set-menu">Menú cerrado</ComboBoxItem></ComboBox></StackPanel>
         <StackPanel><TextBlock Text="Servicio" Style="{StaticResource FieldLabel}"/>
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Offers.OfferService}" IsEnabled="{Binding Offers.OfferEditable}" Width="110"><ComboBoxItem Tag="any">Cualquiera</ComboBoxItem><ComboBoxItem Tag="lunch">Comida</ComboBoxItem><ComboBoxItem Tag="dinner">Cena</ComboBoxItem></ComboBox></StackPanel>
        </WrapPanel>
        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Offers.OfferName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.OfferEditable}"/>
        <WrapPanel Margin="0,6,0,0">
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Desde (AAAA-MM-DD)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferValidFrom, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.OfferEditable}" Width="110"/></StackPanel>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Hasta" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferValidTo, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.OfferEditable}" Width="110"/></StackPanel>
         <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.OfferEditable}" Width="60"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Días" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
        <WrapPanel IsEnabled="{Binding Offers.OfferEditable}">
         <CheckBox Content="L" IsChecked="{Binding Offers.OfferDays[0]}" Margin="0,0,8,0"/><CheckBox Content="M" IsChecked="{Binding Offers.OfferDays[1]}" Margin="0,0,8,0"/><CheckBox Content="X" IsChecked="{Binding Offers.OfferDays[2]}" Margin="0,0,8,0"/>
         <CheckBox Content="J" IsChecked="{Binding Offers.OfferDays[3]}" Margin="0,0,8,0"/><CheckBox Content="V" IsChecked="{Binding Offers.OfferDays[4]}" Margin="0,0,8,0"/><CheckBox Content="S" IsChecked="{Binding Offers.OfferDays[5]}" Margin="0,0,8,0"/><CheckBox Content="D" IsChecked="{Binding Offers.OfferDays[6]}"/>
        </WrapPanel>
        <StackPanel Visibility="{Binding Offers.NewOffer, Converter={StaticResource Bool2Vis}}">
         <WrapPanel Margin="0,6,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Precio por persona (€, IVA incl.)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferPrice, UpdateSourceTrigger=PropertyChanged}" Width="100"/></StackPanel>
          <StackPanel><TextBlock Text="o producto existente" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.OfferProductId, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Código de un producto del catálogo con presentación «person»"/></StackPanel>
         </WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding Offers.OfferProductText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Guardar oferta" Style="{StaticResource Primary}" Command="{Binding Offers.SaveOfferCommand}"/>
         <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Offers.ToggleOfferCommand}"/></WrapPanel>
       </StackPanel></Border>
       <TextBlock DockPanel.Dock="Bottom" Text="Aún no hay ofertas. Crea la primera con «＋ Oferta»." Style="{StaticResource Subtle}" Margin="0,8,0,0" Visibility="{Binding Offers.HasOffers, Converter={StaticResource NotBool2Vis}}"/>
       <ListBox x:Name="OfferList" ItemsSource="{Binding Offers.Offers}" SelectedItem="{Binding Offers.SelectedOffer}"/>
      </DockPanel>
     </Border>
     <!-- Pases -->
     <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Pase" Command="{Binding Offers.StartCourseCommand}" Margin="0"/><TextBlock Text="Pases de la oferta" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,10,0,0"><StackPanel>
        <TextBlock Text="{Binding Offers.CourseFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.CourseId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.NewCourse}" Width="120"/></StackPanel>
         <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.CourseSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.CourseEditable}" Width="60"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Offers.CourseName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.CourseEditable}"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Guardar pase" Style="{StaticResource Primary}" Command="{Binding Offers.SaveCourseCommand}"/>
         <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Offers.ToggleCourseCommand}"/></WrapPanel>
       </StackPanel></Border>
       <TextBlock DockPanel.Dock="Bottom" Text="Una oferta se puede abrir cuando tiene al menos un pase activo con un plato activo." Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
       <ListBox x:Name="OfferCourseList" ItemsSource="{Binding Offers.Courses}" SelectedItem="{Binding Offers.SelectedCourse}"/>
      </DockPanel>
     </Border>
     <!-- Platos -->
     <Border Grid.Column="4" Style="{StaticResource Card}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Plato" Command="{Binding Offers.StartDishCommand}" Margin="0" Visibility="{Binding Offers.IsNotCarte, Converter={StaticResource Bool2Vis}}"/><TextBlock Text="Platos del pase" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <!-- E4b: en una carta, el grupo lleva items del catalogo (producto + presentacion con estacion) -->
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding Offers.IsCarte, Converter={StaticResource Bool2Vis}}"><StackPanel>
        <TextBlock Text="Añadir a la carta" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="Producto y presentación del catálogo (necesita estación de cocina)" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Offers.ItemChoices}" SelectedItem="{Binding Offers.SelectedItemChoice}"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Añadir al grupo" Style="{StaticResource Primary}" Command="{Binding Offers.AddItemCommand}"/>
         <Button Content="Retirar / volver" Style="{StaticResource DangerButton}" Command="{Binding Offers.ToggleItemCommand}"/></WrapPanel>
       </StackPanel></Border>
       <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,10,0,0"><StackPanel>
        <TextBlock Text="{Binding Offers.DishFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.DishId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.NewDish}" Width="120"/></StackPanel>
         <StackPanel><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Offers.DishSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.DishEditable}" Width="60"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Offers.DishName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.DishEditable}"/>
        <TextBlock Text="Estación de cocina" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
        <ComboBox ItemsSource="{Binding Offers.ActiveStations}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Offers.DishStationId}" IsEnabled="{Binding Offers.DishEditable}"/>
        <TextBlock Text="Producto del catálogo (opcional, para stock)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Offers.DishProductId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Offers.DishEditable}"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Guardar plato" Style="{StaticResource Primary}" Command="{Binding Offers.SaveDishCommand}"/>
         <Button Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Offers.ToggleDishCommand}"/></WrapPanel>
       </StackPanel></Border>
       <ListBox x:Name="OfferItemList" DockPanel.Dock="Top" ItemsSource="{Binding Offers.Items}" SelectedItem="{Binding Offers.SelectedItem}" MaxHeight="220" Visibility="{Binding Offers.IsCarte, Converter={StaticResource Bool2Vis}}"/>
       <ListBox x:Name="OfferDishList" ItemsSource="{Binding Offers.Dishes}" SelectedItem="{Binding Offers.SelectedDish}" Visibility="{Binding Offers.IsNotCarte, Converter={StaticResource Bool2Vis}}"/>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>
  </TabItem>
  <!-- ═══════════════ Configuracion (nucleo, E2, solo main) ═══════════════ -->
  <TabItem Header="Configuración" x:Name="OrganizationTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
     <TextBlock Text="Configuración del negocio" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="{Binding Organization.Summary}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
     <TextBlock Text="Nada se borra: una sala, mesa o estación se desactiva y conserva su historia; se puede reactivar cuando haga falta." Style="{StaticResource Subtle}"/>
    </StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <!-- Salas y mesas -->
     <Border Grid.Column="0" Style="{StaticResource Card}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
       <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Sala" Command="{Binding Organization.StartZoneCommand}" Margin="0"/><TextBlock Text="Salas" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Aún no hay salas. Crea la primera con «＋ Sala»." Style="{StaticResource Subtle}" Margin="0,8,0,0" Visibility="{Binding Organization.HasZones, Converter={StaticResource NotBool2Vis}}"/>
        <ListBox x:Name="ZoneList" ItemsSource="{Binding Organization.Zones}" SelectedItem="{Binding Organization.SelectedZone}"/>
       </DockPanel>
       <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Mesa" Command="{Binding Organization.StartTableCommand}" Margin="0"/><TextBlock Text="Mesas de la sala" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <ListBox x:Name="TableList" ItemsSource="{Binding Organization.Tables}" SelectedItem="{Binding Organization.SelectedTable}"/>
       </DockPanel>
       <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
        <Border Style="{StaticResource Banner}" Margin="0,0,0,10"><StackPanel>
         <TextBlock Text="{Binding Organization.ZoneFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Organization.ZoneId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.NewZone}"/>
         <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Organization.ZoneName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.ZoneEditable}"/>
         <TextBlock Text="Orden" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Organization.ZoneSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.ZoneEditable}" Width="80" HorizontalAlignment="Left"/>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar sala" Style="{StaticResource Primary}" Command="{Binding Organization.SaveZoneCommand}"/>
          <Button x:Name="ToggleZoneButton" Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Organization.ToggleZoneCommand}"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Banner}"><StackPanel>
         <TextBlock Text="{Binding Organization.TableFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Organization.TableId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.NewTable}"/>
         <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Organization.TableName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.TableEditable}"/>
         <WrapPanel Margin="0,6,0,0">
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Aforo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Organization.TableCapacity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.TableEditable}" Width="70"/></StackPanel>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Orden" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Organization.TableSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.TableEditable}" Width="70"/></StackPanel>
         </WrapPanel>
         <TextBlock Text="Sala" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
         <ComboBox ItemsSource="{Binding Organization.ActiveZones}" SelectedValuePath="Id" SelectedValue="{Binding Organization.TableZoneId}" IsEnabled="{Binding Organization.TableEditable}"/>
         <WrapPanel Margin="0,8,0,0"><Button Content="Guardar mesa" Style="{StaticResource Primary}" Command="{Binding Organization.SaveTableCommand}"/>
          <Button x:Name="ToggleTableButton" Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Organization.ToggleTableCommand}"/></WrapPanel>
        </StackPanel></Border>
       </StackPanel></ScrollViewer>
      </Grid>
     </Border>
     <!-- Estaciones -->
     <Border Grid.Column="2" Style="{StaticResource Card}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
       <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="＋ Estación" Command="{Binding Organization.StartStationCommand}" Margin="0"/><TextBlock Text="Estaciones" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/></DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Cocina, pase, barra o sala. Los puestos emparejados se asignan a una estación activa. La estación «pase» existe siempre." Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
        <ListBox x:Name="StationList" ItemsSource="{Binding Organization.Stations}" SelectedItem="{Binding Organization.SelectedStation}"/>
       </DockPanel>
       <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource Banner}" VerticalAlignment="Top" Margin="0,0,4,0"><StackPanel>
        <TextBlock Text="{Binding Organization.StationFormTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="Código (fijo)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Organization.StationId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.NewStation}"/>
        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Organization.StationName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.StationEditable}"/>
        <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/>
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Organization.StationKind}" IsEnabled="{Binding Organization.StationEditable}">
         <ComboBoxItem Tag="kitchen">Cocina</ComboBoxItem><ComboBoxItem Tag="pass">Pase</ComboBoxItem><ComboBoxItem Tag="bar">Barra</ComboBoxItem><ComboBoxItem Tag="room">Sala</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Orden" Style="{StaticResource FieldLabel}" Margin="0,6,0,4"/><TextBox Text="{Binding Organization.StationSort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Organization.StationEditable}" Width="70" HorizontalAlignment="Left"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Guardar estación" Style="{StaticResource Primary}" Command="{Binding Organization.SaveStationCommand}"/>
         <Button x:Name="ToggleStationButton" Content="Desactivar / reactivar" Style="{StaticResource DangerButton}" Command="{Binding Organization.ToggleStationCommand}"/></WrapPanel>
       </StackPanel></Border></ScrollViewer>
      </Grid>
     </Border>
    </Grid>
   </Grid>
  </TabItem>
  <!-- =============== Dispositivos (nucleo, solo main; corte A): conectar comanderos y pantallas de cocina =============== -->
  <TabItem Header="Dispositivos" x:Name="DevicesTab" Visibility="{Binding IsMain, Converter={StaticResource Bool2Vis}}">
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Conectar un dispositivo" Style="{StaticResource PanelTitle}"/>
     <TextBlock Text="Elige qué va a ser. El código sirve una vez y caduca en cinco minutos; la solicitud del dispositivo aparece aquí sola." Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"/>
     <StackPanel Visibility="{Binding Devices.HasAssistant, Converter={StaticResource NotBool2Vis}}">
      <TextBlock Text="Comandero (sala)" Style="{StaticResource Section}"/>
      <WrapPanel Visibility="{Binding Devices.NeedsRoomStation, Converter={StaticResource NotBool2Vis}}">
       <ComboBox x:Name="RoomStationBox" Width="210" ItemsSource="{Binding Devices.RoomStations}" SelectedItem="{Binding Devices.SelectedRoomStation}" DisplayMemberPath="Name" Margin="0,0,8,0" ToolTip="Estación de sala (o barra) a la que pertenece el comandero"/>
       <Button x:Name="StartWaiterButton" Content="Conectar comandero" Style="{StaticResource Primary}" Command="{Binding Devices.StartWaiterCommand}"/>
      </WrapPanel>
      <WrapPanel Visibility="{Binding Devices.NeedsRoomStation, Converter={StaticResource Bool2Vis}}">
       <TextBlock Text="No hay ninguna estación de sala donde poner un comandero." VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"/>
       <Button x:Name="CreateRoomStationButton" Content="Crear la estación «Sala»" Command="{Binding Devices.CreateRoomStationCommand}"/>
      </WrapPanel>
      <TextBlock Text="Pantalla de cocina (una por estación)" Style="{StaticResource Section}" Margin="0,14,0,4"/>
      <ItemsControl x:Name="KitchenButtons" ItemsSource="{Binding Devices.KitchenStations}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding Name}" MinWidth="160" Command="{Binding DataContext.Devices.StartKitchenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding Devices.HasAssistant, Converter={StaticResource Bool2Vis}}">
      <TextBlock Text="{Binding Devices.AssistantTitle}" Style="{StaticResource Section}"/>
      <TextBlock Text="{Binding Devices.AssistantText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="White" Padding="8" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top" Visibility="{Binding Devices.HasQr, Converter={StaticResource Bool2Vis}}">
        <Image x:Name="PairingQrImage" Source="{Binding Devices.PairingQr}" Width="232" Height="232" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR de emparejamiento"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Text="{Binding Devices.QrInfo}" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
        <TextBlock Text="Código" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
        <TextBox Text="{Binding Devices.PairingCode, Mode=OneWay}" IsReadOnly="True" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBox Text="{Binding Devices.PairingUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
      </Grid>
      <Border Style="{StaticResource WarnBanner}" Margin="0,0,0,8" Visibility="{Binding Devices.HasDuplicateWarning, Converter={StaticResource Bool2Vis}}"><TextBlock Text="{Binding Devices.DuplicateWarning}" TextWrapping="Wrap"/></Border>
      <Border Style="{StaticResource Banner}" Margin="0,0,0,8" Visibility="{Binding Devices.HasRecognised, Converter={StaticResource Bool2Vis}}"><DockPanel>
       <Button DockPanel.Dock="Right" x:Name="ApproveButton" Content="Aprobar" Style="{StaticResource Primary}" Command="{Binding Devices.ApproveCommand}"/>
       <TextBlock Text="{Binding Devices.RecognisedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel></Border>
      <WrapPanel>
       <Button Content="Generar otro código" Command="{Binding Devices.NewCodeCommand}"/>
       <Button Content="Cerrar el asistente" Style="{StaticResource Ghost}" Command="{Binding Devices.CancelCommand}"/>
      </WrapPanel>
     </StackPanel>
     <Expander Header="Dirección para los dispositivos y solicitudes recibidas" Margin="0,14,0,0">
      <StackPanel Margin="0,6,0,0">
       <TextBlock Text="Dirección para los dispositivos" Style="{StaticResource FieldLabel}"/>
       <TextBox x:Name="DeviceAddressBox" Text="{Binding Devices.DeviceAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://NOMBRE:PUERTO con el que tablets y móviles llegan al servidor: el nombre del certificado (D5.3). Se propone sola y se recuerda en este equipo."/>
       <TextBlock Text="Solicitudes recibidas" Style="{StaticResource Section}" Margin="0,10,0,4"/>
       <TextBlock Text="Solo se aprueba la solicitud del asistente abierto, que sabe qué va a ser el dispositivo. Cualquier otra solo puede denegarse." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
       <ListBox ItemsSource="{Binding Devices.Pending}" SelectedItem="{Binding Devices.SelectedPending}" MaxHeight="100" Margin="0,4,0,4"/>
       <Button Content="Denegar la solicitud seleccionada" Style="{StaticResource DangerButton}" Command="{Binding Devices.DenyCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Expander>
    </StackPanel></ScrollViewer></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dispositivos conectados" Style="{StaticResource PanelTitle}"/>
      <TextBlock Text="{Binding Devices.ListSummary}" TextWrapping="Wrap" Style="{StaticResource Subtle}" Margin="0,4,0,6"/>
      <CheckBox Content="Mostrar también los quitados" IsChecked="{Binding Devices.ShowRevoked}" Margin="0,0,0,6"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Border Style="{StaticResource DangerBanner}" Margin="0,0,0,6" Visibility="{Binding Devices.ConfirmingRemoval, Converter={StaticResource Bool2Vis}}"><DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ConfirmRemoveButton" Content="Sí, quitar" Style="{StaticResource DangerButton}" Command="{Binding Devices.ConfirmRemoveCommand}"/>
        <Button Content="No" Style="{StaticResource Ghost}" Command="{Binding Devices.CancelRemoveCommand}"/>
       </StackPanel>
       <TextBlock Text="{Binding Devices.RemovalText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel></Border>
      <Button x:Name="RemoveButton" Content="Quitar el dispositivo seleccionado" Style="{StaticResource DangerButton}" Command="{Binding Devices.AskRemoveCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
     <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices.Rows}" SelectedItem="{Binding Devices.SelectedRow}" DisplayMemberPath="Text">
      <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,2"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     </ListBox>
    </DockPanel></Border>
   </Grid>
  </TabItem>
 </TabControl>
</DockPanel></Window>
