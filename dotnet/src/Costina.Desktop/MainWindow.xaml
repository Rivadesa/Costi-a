<Window x:Class="Costina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Costina.Desktop.Views" xmlns:local="clr-namespace:Costina.Desktop"
 Title="Costiña · Puesto principal" Width="1280" Height="860" MinWidth="1080" MinHeight="720" Closing="WindowClosing" SizeChanged="WindowSizeChanged"
 Background="{StaticResource WindowBackground}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource BodyFont}" FontSize="14"
 TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
<!-- C1 (plan 2026-10-14): cascaron con el aspecto nuevo. Fondo opaco #F3F4F6, letra Segoe UI Variable Text 14 en la ventana (se hereda;
     no hay estilo global de TextBlock). Los conversores viven en Converters.xaml, combinado en App.xaml: las vistas no ven Window.Resources. -->
<Window.InputBindings>
 <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
 <KeyBinding Key="Escape" Command="{Binding CancelElevationCommand}"/>
</Window.InputBindings>
<!-- C1: los botones de las vistas navegan con GoToPage y el nombre de la vista (CommandParameter); el menu y la barra lateral siguen con
     Click=ShowView. Los caminos aplican la misma logica, elevacion del responsable incluida. -->
<Window.CommandBindings><CommandBinding Command="NavigationCommands.GoToPage" CanExecute="CanGoToPage" Executed="GoToPage"/></Window.CommandBindings>
<!-- Raiz: el cascaron (DockPanel) y, encima de TODO (barra superior y barra de estado incluidas), el velo de la entrada del responsable. -->
<Grid x:Name="WindowRoot">
<DockPanel>
 <!-- Barra superior: la barra de menus clasica (estructura DEFINITIVA del ERP: 7 entradas, mismos nombres y orden, lo que aun no existe
      deshabilitado y "Próximamente") y, a la derecha, quien esta conectado y el paso entre niveles. -->
 <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" MinHeight="38">
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
    <Border x:Name="LevelPill" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="4,2,12,2">
     <StackPanel Orientation="Horizontal">
      <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}" TextElement.Foreground="#FFFFFF" Margin="0,0,8,0">
       <Grid>
        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconLock}" HorizontalAlignment="Center" Visibility="{Binding IsResponsible, Converter={StaticResource Bool2Vis}}"/>
        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconMonitor}" HorizontalAlignment="Center" Visibility="{Binding IsResponsible, Converter={StaticResource NotBool2Vis}}"/>
       </Grid>
      </Border>
      <TextBlock Text="{Binding LevelBadge}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <Button Style="{StaticResource BarButton}" Click="ElevateClick" Visibility="{Binding IsStation, Converter={StaticResource Bool2Vis}}">
     <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconLock}" Margin="0,0,6,0"/><TextBlock Text="Entrar como responsable"/></StackPanel>
    </Button>
    <Button Style="{StaticResource BarButton}" Command="{Binding LeaveResponsibleCommand}" Content="Salir del modo responsable" Visibility="{Binding IsResponsible, Converter={StaticResource Bool2Vis}}"/>
   </StackPanel>
   <Menu x:Name="MainMenu">
    <MenuItem Header="_Archivo">
     <MenuItem Header="Inicio" Tag="HomeTab" Click="ShowView"/>
     <MenuItem Header="Entrar como responsable" Click="ElevateClick"/>
     <MenuItem Header="Salir del modo responsable" Command="{Binding LeaveResponsibleCommand}"/>
     <MenuItem Header="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}"/>
     <MenuItem Header="Actualizar" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
     <MenuItem Header="Desconectar" Command="{Binding DisconnectCommand}"/>
     <Separator/>
     <MenuItem Header="Salir" Click="ExitClick" InputGestureText="Alt+F4"/>
    </MenuItem>
    <MenuItem Header="_Comedor" x:Name="DiningMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
     <MenuItem Header="Comedor y cocina" Tag="ServiceTab" Click="ShowView"/>
    </MenuItem>
    <MenuItem Header="Ca_ja" x:Name="CheckoutMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <MenuItem Header="Cuenta / Caja" Tag="CheckoutTab" Click="ShowView"/>
     <Separator/>
     <MenuItem Header="Apertura y cierre de caja" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
     <MenuItem Header="Arqueo y turnos" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
    </MenuItem>
    <MenuItem Header="C_onfiguración" x:Name="ConfigurationMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <MenuItem Header="Salas, mesas y estaciones" Tag="OrganizationTab" Click="ShowView"/>
     <MenuItem Header="Dispositivos: comanderos y pantallas de cocina" Tag="DevicesTab" Click="ShowView"/>
     <Separator/>
     <MenuItem Header="Usuarios y permisos" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
     <MenuItem Header="Módulos de la instalación" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
    </MenuItem>
    <MenuItem Header="_ERP" x:Name="ErpMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <MenuItem Header="Catálogo y tarifas" Tag="CatalogTab" Click="ShowView"/>
     <MenuItem Header="Menús y cartas" Tag="OffersTab" Click="ShowView"/>
     <MenuItem Header="Informes" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
     <MenuItem Header="Stock, proveedores y compras" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
    </MenuItem>
    <MenuItem Header="_Fiscalidad" x:Name="FiscalMenu" IsEnabled="{Binding TabsEnabled}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <MenuItem Header="Series y facturas" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
     <MenuItem Header="VERI*FACTU" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
    </MenuItem>
    <MenuItem Header="Ay_uda">
     <MenuItem Header="Acerca de Costiña" Click="AboutClick"/>
    </MenuItem>
   </Menu>
  </DockPanel>
 </Border>

 <!-- Barra de estado: servidor, tiempo real y quien (punto y palabra: el color nunca va solo), ultima lectura y la version leida
      del ensamblado. -->
 <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
  <StatusBarItem><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}" Tag="{Binding ServerDot}"/><TextBlock Text="{Binding ServerStateText}"/></StackPanel></StatusBarItem>
  <StatusBarItem Margin="10,0,0,0" ToolTip="{Binding RealtimeState}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}" Tag="{Binding RealtimeDot}"/><TextBlock Text="{Binding RealtimeShort}"/></StackPanel></StatusBarItem>
  <StatusBarItem Margin="10,0,0,0"><TextBlock x:Name="ConnectionLine" Text="{Binding ConnectionText}" TextTrimming="CharacterEllipsis"/></StatusBarItem>
  <StatusBarItem Margin="10,0,0,0" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}"><TextBlock Text="{Binding ReadTime}" TextTrimming="CharacterEllipsis"/></StatusBarItem>
  <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="VersionLine" Text="{Binding VersionText}"/></StatusBarItem>
 </StatusBar>

 <Grid x:Name="Workspace">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Barra lateral (C1): los mismos apartados que el menu, por secciones. Usa los mismos nombres de vista (Tag) y la misma logica
       (ShowView: un apartado sensible en el nivel Puesto pide al responsable). Solo con sesion, como los menus. Durante una
       operacion no admite clics (como los menus, deshabilitados con TabsEnabled) sin parpadear. Plegable a iconos. -->
  <Border x:Name="SideNavBar" Grid.Column="0" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0"
          local:Ui.Compact="{Binding SideNavCompact}" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="Width" Value="{StaticResource NavWidth}"/>
     <Style.Triggers><Trigger Property="local:Ui.Compact" Value="True"><Setter Property="Width" Value="{StaticResource NavCompactWidth}"/></Trigger></Style.Triggers>
    </Style>
   </Border.Style>
   <DockPanel>
    <Button x:Name="SideNavToggle" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Margin="10,6,10,10" Click="ToggleSideNav" local:Ui.Icon="{StaticResource IconSidebar}"
            Content="Plegar la barra" ToolTip="Plegar o desplegar la barra lateral"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="SideNav" Margin="10,4,10,8" IsHitTestVisible="{Binding TabsEnabled}">
      <StackPanel x:Name="NavServiceSection">
       <TextBlock Text="Servicio" Style="{StaticResource NavSection}"/>
       <Button x:Name="NavHome" Style="{StaticResource NavItem}" Tag="HomeTab" local:Ui.Icon="{StaticResource IconHome}" Content="Inicio" ToolTip="Inicio" Click="ShowView"/>
       <Button x:Name="NavService" Style="{StaticResource NavItem}" Tag="ServiceTab" local:Ui.Icon="{StaticResource IconDining}" Content="Comedor y cocina" ToolTip="Comedor y cocina" Click="ShowView"
               Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}"/>
       <Button x:Name="NavCheckout" Style="{StaticResource NavItem}" Tag="CheckoutTab" local:Ui.Icon="{StaticResource IconCheckout}" Content="Cuenta / Caja" ToolTip="Cuenta / Caja" Click="ShowView"/>
      </StackPanel>
      <StackPanel x:Name="NavManageSection">
       <TextBlock Text="Gestión" Style="{StaticResource NavSection}"/>
       <Button x:Name="NavCatalog" Style="{StaticResource NavItem}" Tag="CatalogTab" local:Ui.Icon="{StaticResource IconCatalog}" Content="Catálogo y tarifas" ToolTip="Catálogo y tarifas" Click="ShowView"/>
       <Button x:Name="NavOffers" Style="{StaticResource NavItem}" Tag="OffersTab" local:Ui.Icon="{StaticResource IconOffers}" Content="Menús y cartas" ToolTip="Menús y cartas" Click="ShowView"/>
       <Button x:Name="NavOrganization" Style="{StaticResource NavItem}" Tag="OrganizationTab" local:Ui.Icon="{StaticResource IconOrganization}" Content="Salas, mesas y estaciones" ToolTip="Salas, mesas y estaciones" Click="ShowView"/>
       <Button x:Name="NavDevices" Style="{StaticResource NavItem}" Tag="DevicesTab" local:Ui.Icon="{StaticResource IconDevices}" Content="Dispositivos" ToolTip="Dispositivos" Click="ShowView"/>
      </StackPanel>
      <!-- Lo que aun no existe: visible, deshabilitado y con su explicacion. -->
      <StackPanel x:Name="NavSoonSection">
       <TextBlock Text="Próximamente" Style="{StaticResource NavSection}"/>
       <Button x:Name="NavReservations" Style="{StaticResource NavItem}" local:Ui.Icon="{StaticResource IconReservations}" Content="Reservas" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
       <Button x:Name="NavStock" Style="{StaticResource NavItem}" local:Ui.Icon="{StaticResource IconStock}" Content="Stock y compras" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
       <Button x:Name="NavFiscal" Style="{StaticResource NavItem}" local:Ui.Icon="{StaticResource IconFiscal}" Content="Fiscalidad" IsEnabled="False" ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <DockPanel x:Name="ContentColumn" Grid.Column="1">
   <!-- Avisos (InfoBar). Estado: compacto, solo cuando hay algo que decir y se puede cerrar. Orden sin confirmar y orden ilegible:
        mientras existan (bloquean operar). -->
   <StackPanel x:Name="Notices" DockPanel.Dock="Top" Margin="24,4,24,0">
    <!-- Con la entrada del responsable abierta sobre el velo, el aviso va en la propia tarjeta: aqui se recoge (nunca dos veces lo mismo). -->
    <ContentControl x:Name="StatusBarInfo" Padding="12,5,6,5" Margin="0,12,0,0">
     <ContentControl.Style>
      <Style TargetType="ContentControl" BasedOn="{StaticResource InfoBar}">
       <Setter Property="Visibility" Value="{Binding Status, Converter={StaticResource Text2Vis}}"/>
       <Style.Triggers><DataTrigger Binding="{Binding ElevationMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
      </Style>
     </ContentControl.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="6" MinHeight="0" VerticalAlignment="Center" Click="DismissStatus" ToolTip="Cerrar el aviso"
              AutomationProperties.Name="Cerrar el aviso"><Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClose}"/></Button>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
     </DockPanel>
    </ContentControl>
    <ContentControl Style="{StaticResource WarnBar}" Margin="0,12,0,0" Visibility="{Binding HasPending, Converter={StaticResource Bool2Vis}}">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Reintentar la misma orden" Style="{StaticResource Primary}" Command="{Binding RetryCommand}" Margin="12,0,0,0"/>
      <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </ContentControl>
    <ContentControl Style="{StaticResource DangerBar}" Margin="0,12,0,0" Visibility="{Binding HasBlocked, Converter={StaticResource Bool2Vis}}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
       <Button Content="Consultar al servidor" Command="{Binding ReconcileCommand}"/>
       <Button Content="Descartar conservando evidencia" Style="{StaticResource DangerButton}" Command="{Binding DiscardCommand}" Margin="0,4,0,4"/>
      </StackPanel>
      <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </ContentControl>
   </StackPanel>
   <!-- Area de trabajo: una vista por apartado. Las cabeceras de pestana no se pintan (plantilla vacia): eligen el menu y la barra lateral. -->
   <TabControl x:Name="Tabs" IsEnabled="{Binding TabsEnabled}" SelectionChanged="TabChanged" Margin="24,16,24,16">
    <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"/></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
    <!-- =============== Inicio (corte A, plan 2026-09-24): estado, accesos y dispositivos =============== -->
    <TabItem Header="Inicio" x:Name="HomeTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:HomeView x:Name="HomeView"/>
    </TabItem>
    <!-- ═══════════════ Comedor y cocina (modulo Dining) ═══════════════ -->
    <TabItem Header="Comedor y cocina" x:Name="ServiceTab" Visibility="{Binding HasDining, Converter={StaticResource Bool2Vis}}">
     <views:ServiceView x:Name="ServiceView"/>
    </TabItem>
    <!-- ═══════════════ Cuenta / Caja (nucleo, solo main) ═══════════════ -->
    <TabItem Header="Cuenta / Caja" x:Name="CheckoutTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:CheckoutView x:Name="CheckoutView"/>
    </TabItem>
    <!-- ═══════════════ ERP › Catalogo y tarifas (nucleo, E3, solo main) ═══════════════ -->
    <TabItem Header="Catálogo" x:Name="CatalogTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:CatalogView x:Name="CatalogView"/>
    </TabItem>
    <!-- ═══════════════ ERP › Menus y cartas (nucleo, E4a; E4d: palabras claras) ═══════════════ -->
    <TabItem Header="Menús y cartas" x:Name="OffersTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:OffersView x:Name="OffersView"/>
    </TabItem>
    <!-- ═══════════════ Configuracion (nucleo, E2, solo main) ═══════════════ -->
    <TabItem Header="Configuración" x:Name="OrganizationTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:OrganizationView x:Name="OrganizationView"/>
    </TabItem>
    <!-- =============== Dispositivos (nucleo, solo main; corte A): conectar comanderos y pantallas de cocina =============== -->
    <TabItem Header="Dispositivos" x:Name="DevicesTab" Visibility="{Binding Connected, Converter={StaticResource Bool2Vis}}">
     <views:DevicesView x:Name="DevicesView"/>
    </TabItem>
   </TabControl>
  </DockPanel>

  <!-- Arranque (corte B): mientras el servidor levanta tras encender el equipo, la ventana lo dice y espera. Tapa el area de trabajo. -->
  <Grid x:Name="BootPanel" Grid.ColumnSpan="2" Background="{StaticResource WindowBackground}" Visibility="{Binding ShowBoot, Converter={StaticResource Bool2Vis}}">
   <Border Style="{StaticResource Card}" Padding="32,28" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,14,0">
       <TextBlock Text="C" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Costiña" Style="{StaticResource AppTitle}" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock Text="{Binding BootText}" TextWrapping="Wrap" Margin="0,16,0,12"/>
     <ProgressBar IsIndeterminate="True" Height="4"/>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Primeros pasos (C1): un PC sin sesion ve aqui el estado del servidor, los dos pasos (entrar como responsable; dejar este PC
       conectado para el servicio) y lo que hay dentro. El paso 1 aloja la MISMA tarjeta de entrada (LoginCard) que se abre centrada
       sobre un velo cuando un apartado sensible la pide desde el nivel Puesto: la ventana la mueve de sitio (PlaceLoginCard). -->
  <Grid x:Name="FirstRunPanel" Grid.ColumnSpan="2" Background="{StaticResource WindowBackground}" Visibility="{Binding ShowFirstRun, Converter={StaticResource Bool2Vis}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="24"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
     <Border x:Name="FirstRunCard" Grid.Column="0" Style="{StaticResource Card}" CornerRadius="16" Padding="30,28" VerticalAlignment="Top">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,14,0">
         <TextBlock Text="C" Foreground="#FFFFFF" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="Bienvenido a Costiña" Style="{StaticResource AppTitle}"/>
         <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Ellipse Style="{StaticResource Dot}" Tag="{Binding ServerDot}"/>
          <TextBlock x:Name="FirstRunServer" Text="{Binding FirstRunServerText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"/>
         </StackPanel>
        </StackPanel>
       </DockPanel>
       <TextBlock Text="Este PC todavía no está conectado. Son dos pasos y solo se hacen una vez; después Costiña se abrirá solo, listo para trabajar."
                  Style="{StaticResource Body}" FontSize="14" Margin="0,18,0,20"/>
       <!-- Paso 1: entrar como responsable (la tarjeta de entrada vive aqui mientras no haya sesion). -->
       <DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumber}" Margin="0,0,16,0"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel>
         <TextBlock Text="Entra como responsable" FontSize="15" FontWeight="SemiBold"/>
         <TextBlock Text="El usuario que se creó al instalar. La contraseña nunca se guarda en el equipo." Style="{StaticResource Body}" Margin="0,2,0,12"/>
         <Decorator x:Name="FirstRunLoginHost">
          <!-- Entrada del responsable (corte B). Sin conexion, en el paso 1; con un apartado sensible pedido desde el nivel Puesto,
               centrada sobre un velo (ElevationLoginHost). Misma tarjeta, mismos nombres (ConnectButton, AccessKey, PairCode...). -->
          <Border x:Name="LoginCard" Visibility="{Binding LoginCardVisible, Converter={StaticResource Bool2Vis}}">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Background" Value="Transparent"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding ElevationMode}" Value="True">
               <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
               <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="28,24"/>
               <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.25" Color="#000000"/></Setter.Value></Setter>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <StackPanel>
            <StackPanel Margin="0,0,0,16" Visibility="{Binding ElevationMode, Converter={StaticResource Bool2Vis}}">
             <DockPanel>
              <Border DockPanel.Dock="Left" Style="{StaticResource IconBox}" Margin="0,0,14,0"><Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" HorizontalAlignment="Center"/></Border>
              <TextBlock x:Name="LoginTitleText" Text="{Binding LoginTitle}" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
             </DockPanel>
             <TextBlock Text="La contraseña no se guarda en disco y la sesión caduca sola." Style="{StaticResource Body}" Margin="0,12,0,0"/>
            </StackPanel>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
             <StackPanel Grid.Column="0"><TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}"/></StackPanel>
             <StackPanel Grid.Column="2"><TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="AccessKey" IsEnabled="{Binding ConnectEnabled}" KeyDown="AccessKeyDown"/></StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Button x:Name="ConnectButton" Content="Entrar" Style="{StaticResource Primary}" IsEnabled="{Binding ConnectEnabled}" Click="ConnectClick"
                     HorizontalAlignment="Stretch" MinHeight="40" FontSize="15" Margin="0">
              <!-- Boton grande de la entrada: esquinas de 10 como en el lienzo (Fluent lee ControlCornerRadius como recurso dinamico). -->
              <Button.Resources><CornerRadius x:Key="ControlCornerRadius">10</CornerRadius></Button.Resources>
             </Button>
             <Button x:Name="CancelElevationButton" Grid.Column="1" Content="Seguir como puesto" Style="{StaticResource Ghost}" Command="{Binding CancelElevationCommand}"
                     MinHeight="40" Margin="8,0,0,0" Visibility="{Binding ElevationRequested, Converter={StaticResource Bool2Vis}}"/>
            </Grid>
            <!-- Lo que dice el programa junto a la accion (contrasena incorrecta, servidor sin respuesta, certificado...). -->
            <ContentControl Style="{StaticResource InfoBar}" Padding="10,6" Margin="0,12,0,0" Visibility="{Binding Status, Converter={StaticResource Text2Vis}}">
             <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"/>
            </ContentControl>
            <Expander x:Name="OtherServer" Margin="0,16,0,0" Visibility="{Binding Connected, Converter={StaticResource NotBool2Vis}}">
             <Expander.Header>
              <StackPanel Orientation="Horizontal">
               <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconMonitor}" Margin="0,0,8,0"/>
               <TextBlock Text="¿Este PC no es el servidor? Conectar a otro servidor" FontSize="13" VerticalAlignment="Center"
                          ToolTip="Dirección del servidor, puesto ya emparejado o emparejar este PC como puesto adicional"/>
              </StackPanel>
             </Expander.Header>
             <StackPanel>
              <TextBlock Text="Servidor" Style="{StaticResource FieldLabel}"/>
              <DockPanel>
               <Button DockPanel.Dock="Right" Content="Conectar puesto emparejado" Command="{Binding ConnectPairedCommand}" Margin="8,0,0,0"/>
               <TextBox x:Name="Endpoint" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectEnabled}"
                        ToolTip="http://127.0.0.1:5088 en el propio servidor; https://EQUIPO:PUERTO en un puesto adicional. Se recuerda en este equipo."/>
              </DockPanel>
              <WrapPanel Margin="0,2,0,0">
               <Button x:Name="DisconnectButton" Content="Desconectar" Style="{StaticResource Ghost}" Command="{Binding DisconnectCommand}"/>
               <Button x:Name="RefreshButton" Content="Actualizar" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}"/>
              </WrapPanel>
              <TextBlock Text="Emparejar este PC como puesto adicional" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
               <TextBox x:Name="PairCode" ToolTip="Código de un solo uso generado en el PC principal (Dispositivos › Conectar comandero)"/>
               <TextBox Grid.Column="2" Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre de este puesto (p. ej. pc-barra)"/>
              </Grid>
              <WrapPanel Margin="0,4,0,0">
               <Button Content="Solicitar emparejamiento" Command="{Binding PairDeviceCommand}" CommandParameter="{Binding Text, ElementName=PairCode}"/>
               <TextBlock Text="{Binding PairingStatus}" VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </WrapPanel>
             </StackPanel>
            </Expander>
           </StackPanel>
          </Border>
         </Decorator>
        </StackPanel>
       </DockPanel>
       <!-- Paso 2: explicado; se hace dentro, en Dispositivos, ya como responsable. -->
       <DockPanel Margin="0,22,0,0" Opacity="0.8">
        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumberNext}" Margin="0,0,16,0"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel>
         <TextBlock Text="Deja este PC conectado para el servicio" FontSize="15" FontWeight="SemiBold"/>
         <TextBlock Text="Ya dentro, en Dispositivos, elige la sala desde la que trabajará este PC y pulsa «Dejar este PC conectado para el servicio». A partir de ahí entra solo como puesto de sala; la caja y la configuración piden la contraseña del responsable."
                    Style="{StaticResource Body}" Margin="0,2,0,0"/>
        </StackPanel>
       </DockPanel>
      </StackPanel>
     </Border>
     <!-- Lo que encontrarás dentro: los apartados, listos o proximamente (con su palabra). -->
     <StackPanel Grid.Column="2" x:Name="FirstRunAreas">
      <TextBlock Text="Lo que encontrarás dentro" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,12"/>
      <UniformGrid Columns="2">
       <UniformGrid.Resources>
        <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
       </UniformGrid.Resources>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Comedor y cocina" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Mesas, pases, cocina por estación y alergias." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Cuenta / Caja" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Cuenta de cada mesa, cobros, devoluciones y cierre." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Catálogo y tarifas" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Productos, presentaciones, impuestos y precios." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Oferta" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Degustaciones, menús cerrados y carta." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Salas, mesas y estaciones" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
        <TextBlock Text="La organización del local." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ChipAccent}"><TextBlock Text="Listo"/></Border><TextBlock Text="Dispositivos" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Comanderos y pantallas de cocina con un QR." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource StateChip}"><TextBlock Text="Próximamente"/></Border><TextBlock Text="Reservas" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Libro de reservas del restaurante y las villas." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border><StackPanel><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource StateChip}"><TextBlock Text="Próximamente"/></Border><TextBlock Text="Fiscalidad" FontWeight="SemiBold"/></DockPanel>
        <TextBlock Text="Facturas y VERI*FACTU." Style="{StaticResource Subtle}" Margin="0,4,0,0"/></StackPanel></Border>
      </UniformGrid>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>

 </Grid>
</DockPanel>
 <!-- Entrada del responsable pedida desde el nivel Puesto (corte B): la tarjeta, centrada sobre un velo que tapa TODA la ventana (menus,
      barra lateral, vistas y barra de estado: es modal). Escape o "Seguir como puesto" la cierran. -->
 <Grid x:Name="ElevationLayer" Visibility="{Binding ElevationMode, Converter={StaticResource Bool2Vis}}">
  <Border Background="{StaticResource Scrim}"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Decorator x:Name="ElevationLoginHost" Width="520" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </ScrollViewer>
 </Grid>
</Grid></Window>
