<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><Version>0.28.0-e3</Version></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Costina.Core.Hosting/Costina.Core.Hosting.csproj" />
    <!-- Raiz de composicion (ADR-012): el host es el unico que conoce los modulos. -->
    <ProjectReference Include="../Costina.Modules.Dining/Costina.Modules.Dining.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>
  <!-- D6.1: la PWA (frontend/pwa) viaja DENTRO del motor como wwwroot/app cuando su build existe. Sin build, el
       motor compila y funciona igual, simplemente no aloja /app/. -->
  <ItemGroup Condition="Exists('../../../frontend/pwa/dist/index.html')">
    <None Include="../../../frontend/pwa/dist/**" Link="wwwroot/app/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
