APP_NAME="Hospitality OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hospitality
DB_USERNAME=hospitality
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync

# Identidad fija del servidor local. En producción Retiro tendrá estos valores
# definidos para que los terminales no tengan que conocer IDs técnicos.
HOSPITALITY_TENANT_ID=
HOSPITALITY_COMPANY_ID=
HOSPITALITY_LOCATION_ID=
HOSPITALITY_TOKEN_TTL_HOURS=24

# Orígenes explícitos autorizados a llamar al API local desde Vue/Tauri/PWA.
HOSPITALITY_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
