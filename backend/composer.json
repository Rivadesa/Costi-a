{
  "name": "xeitoso/hospitality-os-domain",
  "description": "Framework-independent domain kernel for Hospitality OS V1A",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Hospitality\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hospitality\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
